# Twikoo 评论系统配置
PUBLIC_TWIKOO_ENV_ID=your_twikoo_env_id
PUBLIC_TWIKOO_REGION=ap-shanghai
PUBLIC_TWIKOO_LANG=zh-CN

# 其他环境变量
PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_code

# 高德地图：Web端（JS API）Key，文章 locations 使用高德 GCJ-02 坐标
PUBLIC_AMAP_KEY=
# 推荐生产环境使用安全代理，地址以 /_AMapService 结尾
PUBLIC_AMAP_SERVICE_HOST=
# 不使用代理时填写安全密钥；PUBLIC_ 变量会进入浏览器，需配置域名白名单
PUBLIC_AMAP_SECURITY_JS_CODE=
