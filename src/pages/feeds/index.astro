---
/**
 * 邻居页（友链/博客列表）
 *
 * @fileoverview 显示作者订阅的其他博客
 *
 * 核心逻辑：
 * 1. 从外部 JSON 数据源加载博客列表
 * 2. 初始显示前 N 项（由 SITE.feedsPerIndex 配置）
 * 3. 滚动到底部自动加载更多（每次 12 项）
 * 4. 显示加载状态、错误提示、无内容提示
 * 5. 使用 initFeeds 函数初始化（定义在 public/feeds.js）
 *
 * 数据源配置：
 * - JSON: /api/feeds.json（Blob + 静态回退，见 api/feeds.json.ts）
 * - 初始数量: 12
 * - 每页数量: 12
 * - 时区: SITE.timezone
 * - 默认头像: FALLBACK_OG_IMAGE
 *
 * 依赖关系：
 * - 被 /feeds 路径访问
 * - 使用 Twikoo 组件显示评论
 * - 依赖 public/feeds.js 的 initFeeds 函数
 */

import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Twikoo from "@/components/Twikoo.astro";
import { SITE } from "@/config";
import { SITE_TIMEZONE } from "@/utils/calendarDate";
import { getAssetPath, withBase } from "@/utils/withBase";
import {
  PUBLIC_TWIKOO_ENABLED,
  PUBLIC_TWIKOO_ENV_ID,
  PUBLIC_TWIKOO_REGION,
} from "astro:env/client";

// 初始显示数量
// 默认头像图片（未设置时使用）
const FALLBACK_OG_IMAGE = getAssetPath("/data/feeds/default-avatar.svg");

/**
 * 客户端数据配置
 *
 * 通过 data 属性传递给客户端脚本
 */
const feedsDataForClient = {
  siteTimezone: SITE_TIMEZONE,
  fallbackOgImage: FALLBACK_OG_IMAGE,
  initialItemCount: SITE.feedsPerIndex,
  itemsPerPage: SITE.feedsPerPage,
  /** 经 API 聚合 Blob（Cron 更新）与构建时静态文件，见 `src/pages/api/feeds.json.ts` */
  dataSourceUrl: withBase("/api/feeds.json"),
};

// 评论配置
const commentsEnabled =
  SITE.comments.enabled && PUBLIC_TWIKOO_ENABLED !== "false";
const hasTwikooEnv =
  (PUBLIC_TWIKOO_ENV_ID ?? "").trim().length > 0 &&
  (PUBLIC_TWIKOO_REGION ?? "").trim().length > 0;
---

<Layout title={`邻居 | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="邻居"
    pageDesc="我常去拜访的个人博客，也是互联网仍然有趣的证明。"
    pageDescClass="max-w-2xl"
  >
    <section id="feeds-list-section" class="feeds-page-stage">
      <div class="feeds-overview" aria-label="邻居动态概览">
        <div class="feeds-overview-item">
          <span>邻居</span>
          <strong id="feeds-count">正在同步</strong>
        </div>
        <div class="feeds-overview-item">
          <span>最新来信</span>
          <strong id="feeds-latest">读取中</strong>
        </div>
        <div class="feeds-overview-item feeds-overview-item--sync">
          <span>同步状态</span>
          <strong id="feeds-updated">连接 RSS 网络</strong>
        </div>
      </div>

      <header class="feeds-stage-head">
        <div>
          <span class="feeds-eyebrow">邻里动态</span>
          <h2>最近来信</h2>
          <p>按发布时间排列，看看邻居们最近写了什么。</p>
        </div>
      </header>

      <!-- 加载提示（骨架屏） -->
      <div id="feeds-loading">
        <ul class="feeds-list feeds-list--skeleton">
          {
            Array.from({ length: SITE.feedsPerIndex }).map(() => (
              <li class="feeds-skeleton-card">
                <div class="feeds-skeleton-avatar" />
                <div class="feeds-skeleton-copy">
                  <div class="feeds-skeleton-line feeds-skeleton-line--wide" />
                  <div class="feeds-skeleton-line feeds-skeleton-line--medium" />
                  <div class="feeds-skeleton-line" />
                  <div class="feeds-skeleton-line feeds-skeleton-line--short" />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <!-- 错误提示 -->
      <div id="feeds-error" class="feeds-state feeds-state--error hidden">
        <div class="feeds-state-icon" aria-hidden="true">!</div>
        <p class="feeds-state-title">同步暂时中断</p>
        <p class="feeds-state-copy">
          无法加载博客订阅内容，请稍后重试或检查网络连接。
        </p>
        <button onclick="window.location.reload()" class="feeds-state-action">
          再试一次
        </button>
      </div>
      <!-- 无内容提示 -->
      <div id="feeds-no-content" class="feeds-state empty-state-card hidden">
        <div class="feeds-state-icon" aria-hidden="true">∅</div>
        <p class="feeds-state-title">还没有订阅内容</p>
        <p class="feeds-state-copy">这里暂时没有可显示的博客更新。</p>
      </div>
      <!-- Feeds 列表容器 -->
      <ul id="feeds-list" class="feeds-list"></ul>
      <!-- 加载更多触发器和状态指示器 -->
      <div id="load-more-trigger" class="h-10" style="display: none;"></div>

      <!-- 加载更多状态指示器 -->
      <div id="loading-more-indicator" class="feeds-loading-more hidden">
        <span class="feeds-loading-dot" aria-hidden="true"></span>
        <span>正在读取下一页…</span>
      </div>

      <!-- 已加载全部内容提示 -->
      <div id="all-loaded-indicator" class="feeds-all-loaded hidden">
        <span aria-hidden="true">✦</span>
        <span>已经看到这里了</span>
      </div>
    </section>

    <!-- 评论区域 -->
    {
      commentsEnabled && (
        <section class="feeds-comments">
          <div class="feeds-comments-head">
            <span class="feeds-eyebrow">开放讨论</span>
            <h2>推荐新邻居</h2>
            <p>如果你也在认真记录，或者有喜欢的个人博客，欢迎留下地址。</p>
          </div>

          {commentsEnabled && hasTwikooEnv && <Twikoo />}

          {commentsEnabled && !hasTwikooEnv && (
            <div class="rounded-xl border border-border/40 bg-muted/10 p-6 text-center">
              <div class="mb-3 text-3xl">💬</div>
              <p class="mb-2 font-medium text-foreground/80">留言功能已开启</p>
              <p class="mb-4 text-sm text-foreground/60">
                但尚未完成 Twikoo 配置，暂时无法显示留言区域。
              </p>
              <div class="rounded-lg bg-muted/20 p-3 text-sm">
                <p class="mb-1 font-medium">需要配置的环境变量：</p>
                <div class="flex flex-wrap justify-center gap-2">
                  <code class="rounded bg-muted/40 px-2 py-1">
                    PUBLIC_TWIKOO_ENV_ID
                  </code>
                  <code class="rounded bg-muted/40 px-2 py-1">
                    PUBLIC_TWIKOO_REGION
                  </code>
                </div>
              </div>
            </div>
          )}
        </section>
      )
    }
  </Main>
  <Footer />
</Layout>

<!-- 客户端数据容器 -->
<div
  id="feeds-data-json-container"
  data-json={JSON.stringify(feedsDataForClient)}
  style="display: none;"
>
</div>

<script>
  import { initFeeds } from "../../../public/feeds.js";

  declare global {
    interface Window {
      __feedsPageLoadHandler?: () => void;
    }
  }

  const initializeFeeds = () => {
    const dataElement = document.getElementById("feeds-data-json-container");

    if (
      !dataElement?.dataset.json ||
      dataElement.dataset.initialized === "true"
    ) {
      return;
    }

    dataElement.dataset.initialized = "true";
    try {
      const clientData = JSON.parse(dataElement.dataset.json);
      void initFeeds(
        clientData.fallbackOgImage,
        clientData.initialItemCount,
        clientData.itemsPerPage,
        clientData.dataSourceUrl,
        clientData.siteTimezone
      );
    } catch (error) {
      console.error("Failed to initialize feeds:", error);
      const errorContainer = document.getElementById("feeds-error");
      const loadingContainer = document.getElementById("feeds-loading");
      errorContainer?.classList.remove("hidden");
      loadingContainer?.classList.add("hidden");
    }
  };

  if (window.__feedsPageLoadHandler) {
    document.removeEventListener(
      "astro:page-load",
      window.__feedsPageLoadHandler
    );
  }
  window.__feedsPageLoadHandler = initializeFeeds;
  document.addEventListener("astro:page-load", initializeFeeds);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeFeeds, {
      once: true,
    });
  } else {
    initializeFeeds();
  }
</script>

<style is:global>
  .feeds-eyebrow {
    color: var(--accent);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .feeds-page-stage {
    padding-inline: 0;
  }

  #main-content:has(.feeds-page-stage)::before {
    inset-inline: 0;
  }

  .feeds-overview {
    display: grid;
    grid-template-columns: 0.8fr 1fr 1.45fr;
    margin-top: 1.2rem;
    border-block: 1px solid color-mix(in oklab, var(--border) 72%, transparent);
  }

  .feeds-overview-item {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    padding: 1rem 1.15rem;
  }

  .feeds-overview-item + .feeds-overview-item {
    border-inline-start: 1px solid
      color-mix(in oklab, var(--border) 72%, transparent);
  }

  .feeds-overview-item > span {
    color: var(--foreground-subtle);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .feeds-overview-item > strong {
    overflow: hidden;
    color: var(--foreground);
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feeds-overview-item > strong.is-stale {
    color: color-mix(in oklab, #d97706 78%, var(--foreground));
  }

  .feeds-stage-head {
    margin: 1.8rem 0 0.85rem;
  }

  .feeds-stage-head h2 {
    margin-top: 0.3rem;
    color: var(--foreground);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  .feeds-stage-head p {
    margin-top: 0.35rem;
    color: var(--foreground-muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .feeds-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feeds-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--surface) 96%, transparent);
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .feeds-card:hover,
  .feeds-card:focus-within {
    border-color: color-mix(in oklab, var(--accent) 32%, var(--border));
    background: color-mix(in oklab, var(--accent) 3.5%, var(--surface));
  }

  .feeds-card-body {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    min-width: 0;
    align-items: start;
    gap: 0.6rem;
    min-height: 5.7rem;
    padding: 0.6rem;
    color: inherit;
    text-decoration: none;
  }

  .feeds-card-site-link,
  .feeds-card-article-link {
    text-decoration: none;
  }

  .feeds-card-site-link:focus-visible,
  .feeds-card-article-link:focus-visible {
    border-radius: 0.35rem;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .feeds-card-avatar {
    display: grid;
    margin-top: 0.05rem;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--accent) 24%, var(--border));
    border-radius: 0.9rem;
    color: var(--accent);
    background: var(--accent-softer);
    font-size: 1rem;
    font-weight: 700;
  }

  .feeds-card-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feeds-card-main {
    min-width: 0;
    display: grid;
    align-self: stretch;
    grid-template-rows: auto minmax(1.7rem, auto) auto;
    gap: 0.12rem;
  }

  .feeds-card-meta,
  .feeds-card-foot {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .feeds-card-foot {
    justify-content: flex-start;
  }

  .feeds-card-article-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.38rem;
  }

  .feeds-card-source {
    overflow: hidden;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feeds-card-date {
    flex: none;
    color: var(--foreground-subtle);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .feeds-card-title {
    display: -webkit-box;
    overflow: hidden;
    color: color-mix(in oklab, var(--foreground) 92%, transparent);
    font-size: clamp(0.94rem, 1.5vw, 1.04rem);
    font-weight: 620;
    line-height: 1.45;
    align-self: center;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: color 160ms ease;
  }

  .feeds-card-latest-label {
    align-self: center;
    border-radius: 999px;
    padding: 0.08rem 0.3rem;
    color: color-mix(in oklab, var(--foreground) 68%, transparent);
    background: var(--accent-softer);
    font-size: 0.6rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.04em;
  }

  .feeds-card-title:hover,
  .feeds-card-title:focus-visible {
    color: var(--accent);
  }

  .feeds-card-article-row:has(.feeds-card-title:hover) .feeds-card-arrow,
  .feeds-card-article-row:has(.feeds-card-title:focus-visible)
    .feeds-card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .feeds-card-source:hover,
  .feeds-card-domain:hover {
    color: color-mix(in oklab, var(--accent) 74%, var(--foreground));
  }

  .feeds-card-domain {
    overflow: hidden;
    color: var(--foreground-subtle);
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .feeds-card-arrow {
    color: var(--accent);
    font-size: 1rem;
    opacity: 0.38;
    transform: translateX(-0.1rem);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .feeds-card-arrow:hover,
  .feeds-card-arrow:focus-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  .feeds-skeleton-card {
    display: flex;
    min-height: 6.25rem;
    align-items: flex-start;
    gap: 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1rem;
    background: var(--surface-muted);
  }

  .feeds-skeleton-avatar,
  .feeds-skeleton-line {
    background: linear-gradient(
      105deg,
      color-mix(in oklab, var(--muted) 32%, transparent),
      color-mix(in oklab, var(--muted) 12%, transparent),
      color-mix(in oklab, var(--muted) 32%, transparent)
    );
    background-size: 200% 100%;
    animation: feeds-skeleton-shimmer 1.8s ease-in-out infinite;
  }

  .feeds-skeleton-avatar {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: 0.75rem;
  }

  .feeds-skeleton-copy {
    display: grid;
    width: 100%;
    gap: 0.65rem;
    padding-top: 0.15rem;
  }

  .feeds-skeleton-line {
    width: 100%;
    height: 0.55rem;
    border-radius: 999px;
  }

  .feeds-skeleton-line--wide {
    width: 72%;
    height: 0.7rem;
  }

  .feeds-skeleton-line--medium {
    width: 45%;
  }

  .feeds-skeleton-line--short {
    width: 28%;
  }

  .feeds-state {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    margin: 2rem 0 3rem;
    border: 1px dashed color-mix(in oklab, var(--border) 80%, transparent);
    border-radius: var(--radius-card);
    padding: 3rem 1.25rem;
    color: var(--foreground-muted);
    text-align: center;
    background: var(--surface-muted);
  }

  #feeds-error.hidden,
  #feeds-no-content.hidden,
  #loading-more-indicator.hidden,
  #all-loaded-indicator.hidden {
    display: none;
  }

  .feeds-state--error {
    border-style: solid;
    border-color: color-mix(in oklab, #b45309 35%, var(--border));
    background: color-mix(in oklab, #b45309 5%, var(--surface));
  }

  .feeds-state-icon {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--accent) 28%, var(--border));
    border-radius: 999px;
    color: var(--accent);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .feeds-state-title {
    margin: 0.35rem 0 0;
    color: var(--foreground);
    font-size: 0.95rem;
    font-weight: 650;
  }

  .feeds-state-copy {
    max-width: 28rem;
    margin: 0;
    color: var(--foreground-muted);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .feeds-state-action {
    margin-top: 0.7rem;
    border: 1px solid color-mix(in oklab, var(--accent) 42%, var(--border));
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    color: var(--accent);
    background: var(--surface);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .feeds-loading-more,
  .feeds-all-loaded {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 1.35rem 0;
    color: var(--foreground-muted);
    font-size: 0.7rem;
  }

  .feeds-loading-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-soft);
    animation: feeds-pulse 1.4s ease-out infinite;
  }

  .feeds-all-loaded {
    color: var(--accent);
  }

  .feeds-comments {
    min-width: 0;
    margin-top: 4.5rem;
    overflow-x: clip;
    border-top: 1px solid color-mix(in oklab, var(--border) 72%, transparent);
    padding-top: 2.4rem;
  }

  .feeds-comments-head {
    margin-bottom: 1.4rem;
  }

  .feeds-comments-head h2 {
    margin-top: 0.35rem;
    color: var(--foreground);
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  .feeds-comments-head p {
    margin-top: 0.35rem;
    color: var(--foreground-muted);
    font-size: 0.8rem;
  }

  @keyframes feeds-skeleton-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @keyframes feeds-pulse {
    0% {
      box-shadow: 0 0 0 0 var(--accent-soft);
    }
    70% {
      box-shadow: 0 0 0 0.45rem transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  @media (max-width: 480px) {
    .feeds-overview {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feeds-overview-item {
      gap: 0.2rem;
      padding: 0.55rem 0.65rem;
    }

    .feeds-overview-item--sync {
      grid-column: 1 / -1;
      border-top: 1px solid color-mix(in oklab, var(--border) 72%, transparent);
      border-inline-start: 0 !important;
    }

    .feeds-card-body {
      gap: 0.55rem;
      min-height: 5.6rem;
      padding: 0.55rem;
    }

    .feeds-card-avatar {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.75rem;
    }

    .feeds-card-title {
      font-size: 0.94rem;
    }
  }

  @media (max-width: 700px) {
    .feeds-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feeds-card,
    .feeds-card-arrow {
      transition: none;
    }

    .feeds-skeleton-avatar,
    .feeds-skeleton-line,
    .feeds-loading-dot {
      animation: none;
    }
  }
</style>
