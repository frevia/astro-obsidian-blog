---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { parseEntry } from "@/utils/parseEntry";
import HomeEditorial from "@/components/home/HomeEditorial.astro";
import { buildFragmentPreviews } from "@/components/home/fragmentPreviews";
import getSortedPosts from "@/utils/getSortedPosts";
import { buildWikiCatalog, selectWikiHighlights } from "@/utils/wikiCatalog";
import { getWikiTitle } from "@/utils/wikiPath";
import { buildWikilinkGraph } from "@/utils/wikilinkGraph";

const [diaryEntries, blogPosts, wikiEntries] = await Promise.all([
  getCollection("diary"),
  getCollection("blog"),
  getCollection("wiki"),
]);

// 按文件名（日期）排序，最新的在前
// 同时确保同一天内的时间块也按时间倒序排列
const sortedEntries = diaryEntries.sort((a, b) => {
  const dateA = a.id.split("/").pop()!.replace(".md", "");
  const dateB = b.id.split("/").pop()!.replace(".md", "");
  return dateB.localeCompare(dateA);
});

// 首页只解析少量 Notes，用于 SSR 渲染融合精选；完整时间线由 /notes 承载。
const initialEntries = sortedEntries.slice(0, 5);
const initialParsedEntries = await Promise.all(
  initialEntries.map(entry => parseEntry(entry))
);
const featuredPost = getSortedPosts(blogPosts)[0];
const fragmentPreviews = buildFragmentPreviews(initialParsedEntries, 3);
const wikiGraphEntries = wikiEntries.map(entry => ({
  id: entry.id,
  filePath: entry.filePath,
  body: entry.body,
  data: { title: getWikiTitle(entry), slug: entry.data.title },
  routePrefix: "/wiki" as const,
}));
const wikiGraph = buildWikilinkGraph(wikiGraphEntries);
const wikiHighlights = selectWikiHighlights(
  buildWikiCatalog(wikiEntries, wikiGraph),
  3
);
---

<Layout title={SITE.title}>
  <Header />

  <main
    id="main-content"
    data-pagefind-ignore
    role="main"
    aria-label="首页主要内容"
    class="page-shell mx-auto mt-6 w-full max-w-app min-w-0 px-4 pb-8"
  >
    <a
      href="#home-editorial-heading"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-skin-accent focus:px-4 focus:py-2 focus:text-skin-inverted focus:no-underline"
    >
      跳转到主要内容
    </a>

    <HomeEditorial
      {featuredPost}
      fragments={fragmentPreviews}
      {wikiHighlights}
    />
  </main>

  <Footer />
</Layout>
