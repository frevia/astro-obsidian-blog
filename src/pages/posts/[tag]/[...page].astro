---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";
import { tplStr, useTranslations } from "@/i18n";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
const t = useTranslations(SITE.lang);
---

<Layout
  title={`${tplStr(t.pages.tagPageTitleWithName, { tag: tagName })} | ${SITE.title}`}
>
  <Header />
  <Main
    pageTitle={[t.pages.tagPageTitle, `${tagName}`]}
    titleTransition={tag}
    pageDesc={tplStr(t.pages.tagPageDesc, { tag: tagName })}
  >
    <h1 slot="title" transition:name={tag}>
      {tplStr(t.pages.tagPageTitleCompact, { tag })}
    </h1>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
