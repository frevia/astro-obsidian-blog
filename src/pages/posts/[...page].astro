---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import CollapsibleTagList from "@/components/CollapsibleTagList.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { getSiteYear } from "@/utils/calendarDate";
import { slugifyStr } from "@/utils/slugify";
import postFilter from "@/utils/postFilter";

// tag
import Tag from "@/components/Tag.astro";
import getUniqueTags from "@/utils/getUniqueTags";

const posts = await getCollection("blog");
const tags = getUniqueTags(posts);
const DEFAULT_VISIBLE_TAGS = 20;
const tagCountMap = posts
  .filter(postFilter)
  .flatMap(post => post.data.tags)
  .reduce(
    (acc, tagName) => {
      const slug = slugifyStr(tagName);
      acc.set(slug, (acc.get(slug) ?? 0) + 1);
      return acc;
    },
    new Map<string, number>()
  );
const sortedTags = [...tags].sort(
  (a, b) =>
    (tagCountMap.get(b.tag) ?? 0) - (tagCountMap.get(a.tag) ?? 0) ||
    a.tagName.localeCompare(b.tagName, "zh-CN")
);
const featuredTags = sortedTags.slice(0, DEFAULT_VISIBLE_TAGS);
const remainingTagNames = sortedTags
  .slice(DEFAULT_VISIBLE_TAGS)
  .map(({ tagName }) => tagName);

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog");
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const postsByYear = page.data.reduce(
  (acc, post) => {
    const year = String(getSiteYear(post.data.published));
    (acc[year] ??= []).push(post);
    return acc;
  },
  {} as Record<string, typeof page.data>
);
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title={`文章 | ${SITE.title}`}>
  <Header />
  <Main pageTitle="全部文章">
    <section slot="header-extra" class="mt-4 border-t border-border/50 pt-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2
          id="posts-tag-nav-title"
          class="text-sm font-semibold tracking-wide text-foreground/85"
        >
          标签导航
        </h2>
        <p class="text-xs text-foreground/60">
          共 {tags.length} 个，优先展示高频标签
        </p>
      </div>
      <ul class="mt-3 flex flex-wrap gap-2.5" aria-label="文章标签筛选">
        {featuredTags.map(({ tag, tagName }) => (
          <Tag {tag} {tagName} />
        ))}
      </ul>
      {
        remainingTagNames.length > 0 && (
          <details class="mt-2">
            <summary class="cursor-pointer text-sm text-accent transition-colors hover:text-accent/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
              更多标签（{remainingTagNames.length}）
            </summary>
            <CollapsibleTagList tags={remainingTagNames} compact />
          </details>
        )
      }
    </section>

    {
      years.map(year => (
        <section class="mb-10" aria-labelledby={`year-${year}`}>
          <h2
            id={`year-${year}`}
            class="sticky top-[var(--site-header-height,4rem)] z-10 mb-4 border-b border-border/60 bg-background/90 py-2 text-sm font-semibold tracking-widest text-accent backdrop-blur-sm"
          >
            {year}
          </h2>
          <ul>
            {postsByYear[year].map(data => (
              <Card {...data} />
            ))}
          </ul>
        </section>
      ))
    }
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
