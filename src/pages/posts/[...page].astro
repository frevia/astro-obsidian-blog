---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import CollapsibleTagList from "@/components/CollapsibleTagList.astro";
import EditorialYear from "@/components/post-list/EditorialYear.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { getSiteYear } from "@/utils/calendarDate";
import { slugifyStr } from "@/utils/slugify";
import postFilter from "@/utils/postFilter";
import { tplStr, useTranslations } from "@/i18n";

// tag
import Tag from "@/components/Tag.astro";
import getUniqueTags from "@/utils/getUniqueTags";

const posts = await getCollection("blog");
const tags = getUniqueTags(posts);
const DEFAULT_VISIBLE_TAGS = 8;
const tagCountMap = posts
  .filter(postFilter)
  .flatMap(post => post.data.tags)
  .reduce((acc, tagName) => {
    const slug = slugifyStr(tagName);
    acc.set(slug, (acc.get(slug) ?? 0) + 1);
    return acc;
  }, new Map<string, number>());
const sortedTags = [...tags].sort(
  (a, b) =>
    (tagCountMap.get(b.tag) ?? 0) - (tagCountMap.get(a.tag) ?? 0) ||
    a.tagName.localeCompare(b.tagName, "zh-CN")
);
const featuredTags = sortedTags.slice(0, DEFAULT_VISIBLE_TAGS);
const remainingTagNames = sortedTags
  .slice(DEFAULT_VISIBLE_TAGS)
  .map(({ tagName }) => tagName);

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog");
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const t = useTranslations(SITE.lang);

const postsByYear = page.data.reduce(
  (acc, post) => {
    const year = String(getSiteYear(post.data.published));
    (acc[year] ??= []).push(post);
    return acc;
  },
  {} as Record<string, typeof page.data>
);
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title={`${t.pages.postsTitle} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t.pages.postsAllTitle}>
    <section slot="header-extra" class="mt-4 border-t border-border/50 pt-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2
          id="posts-tag-nav-title"
          class="text-sm font-semibold tracking-wide text-foreground/85"
        >
          {t.pages.postsTagNavTitle}
        </h2>
        <p class="text-xs text-foreground/60">
          {tplStr(t.pages.postsTagCount, { count: tags.length })}
        </p>
      </div>
      <ul
        class="mt-3 flex flex-wrap gap-2.5"
        aria-label={t.pages.postsTagFilterLabel}
      >
        {featuredTags.map(({ tag, tagName }) => <Tag {tag} {tagName} />)}
      </ul>
      {
        remainingTagNames.length > 0 && (
          <details class="mt-2">
            <summary class="cursor-pointer text-sm text-accent transition-colors hover:text-accent/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
              {tplStr(t.pages.postsMoreTags, {
                count: remainingTagNames.length,
              })}
            </summary>
            <CollapsibleTagList tags={remainingTagNames} compact />
          </details>
        )
      }
    </section>

    {years.map(year => <EditorialYear year={year} posts={postsByYear[year]} />)}
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
