---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import EditorialYear from "@/components/post-list/EditorialYear.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import { getSiteYear } from "@/utils/calendarDate";
import { slugifyStr } from "@/utils/slugify";
import postFilter from "@/utils/postFilter";
import { tplStr, useTranslations } from "@/i18n";

// tag
import { withBase } from "@/utils/withBase";
import getUniqueTags from "@/utils/getUniqueTags";

const posts = await getCollection("blog");
const tags = getUniqueTags(posts);
const DEFAULT_VISIBLE_TAGS = 8;
const tagCountMap = posts
  .filter(postFilter)
  .flatMap(post => post.data.tags)
  .reduce((acc, tagName) => {
    const slug = slugifyStr(tagName);
    acc.set(slug, (acc.get(slug) ?? 0) + 1);
    return acc;
  }, new Map<string, number>());
const sortedTags = [...tags].sort(
  (a, b) =>
    (tagCountMap.get(b.tag) ?? 0) - (tagCountMap.get(a.tag) ?? 0) ||
    a.tagName.localeCompare(b.tagName, "zh-CN")
);
const featuredTags = sortedTags.slice(0, DEFAULT_VISIBLE_TAGS);
const remainingTags = sortedTags.slice(DEFAULT_VISIBLE_TAGS);

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog");
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const t = useTranslations(SITE.lang);

const postsByYear = page.data.reduce(
  (acc, post) => {
    const year = String(getSiteYear(post.data.published));
    (acc[year] ??= []).push(post);
    return acc;
  },
  {} as Record<string, typeof page.data>
);
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title={`${t.pages.postsTitle} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t.pages.postsAllTitle}>
    <nav class="post-tag-filter" aria-label={t.pages.postsTagFilterLabel}>
      <ul class="post-tag-options">
        <li>
          <a href={withBase("/posts")} aria-current="page"
            >{t.pages.postsAllTitle}</a
          >
        </li>
        {
          featuredTags.map(({ tag, tagName }) => (
            <li>
              <a href={withBase(`/posts/${tag}/`)}>{tagName}</a>
            </li>
          ))
        }
      </ul>
      {
        remainingTags.length > 0 && (
          <details class="post-tag-more">
            <summary>
              {tplStr(t.pages.postsMoreTags, { count: remainingTags.length })}
            </summary>
            <ul class="post-tag-options">
              {remainingTags.map(({ tag, tagName }) => (
                <li>
                  <a href={withBase(`/posts/${tag}/`)}>{tagName}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </nav>

    {years.map(year => <EditorialYear year={year} posts={postsByYear[year]} />)}
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<style>
  .post-tag-filter {
    margin-top: -1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .post-tag-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
  }
  .post-tag-options a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--foreground-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .post-tag-options a[aria-current],
  .post-tag-options a:hover {
    background: var(--accent-softer);
    color: var(--accent-strong);
  }
  .post-tag-options a[aria-current] {
    font-weight: 600;
  }
  .post-tag-more summary {
    width: fit-content;
    padding: 0.75rem;
    color: var(--foreground-muted);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .post-tag-options a:focus-visible,
  .post-tag-more summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
