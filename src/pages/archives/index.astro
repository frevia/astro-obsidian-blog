---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import postFilter from "@/utils/postFilter";
import { SITE } from "@/config";
import { getYearMonthInTimeZone } from "@/utils/calendarDate";
import { tplStr, useTranslations } from "@/i18n";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/404`);
}

const posts = await getCollection("blog", postFilter);
const t = useTranslations(SITE.lang);

const months = t.pages.archivesMonthNames;
---

<Layout title={`${t.pages.archivesTitle} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    <!-- 页面描述区域 -->
    <!-- <div
      class="mb-8 rounded-xl border-l-4 border-accent/60 bg-accent/5 px-4 py-4 text-sm text-foreground/80"
    >
      <div class="flex items-start gap-3">
        <span class="mt-0.5 text-lg text-accent/80">📦</span>
        <div class="flex-1">
          <p class="mb-2 text-base font-semibold text-foreground/90">
            文章归档
          </p>
          <p class="mb-2">
            这里按时间顺序整理了所有已发布的文章，方便您按年月浏览。
          </p>
          <div class="flex flex-wrap gap-4 text-sm text-foreground/60">
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/60"></span>
              按年份和月份分组
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/40"></span>
              支持快速跳转浏览
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/20"></span>
              完整的文章时间线
            </span>
          </div>
        </div>
      </div>
    </div> -->
    {
      Object.entries(
        getPostsByGroupCondition(
          posts,
          post => getYearMonthInTimeZone(post.data.published).year
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div class="mb-8" aria-labelledby={`archive-year-${year}`}>
            <div class="mb-6 flex items-center justify-between border-b border-border/30 pb-3">
              <div class="flex items-baseline gap-3">
                <h2
                  id={`archive-year-${year}`}
                  class="text-2xl font-bold text-foreground/90"
                >
                  {year}
                </h2>
                <span class="rounded-full bg-accent/10 px-2.5 py-1 text-sm font-medium text-accent">
                  {tplStr(t.pages.archivesPostCount, {
                    count: yearGroup.length,
                  })}
                </span>
              </div>
              <div class="text-sm text-foreground/40">
                {t.pages.archivesSortByPublished}
              </div>
            </div>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post =>
                  getYearMonthInTimeZone(post.data.published).monthIndex + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div
                  class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-4"
                  data-month-group
                >
                  <div class="mt-2 mb-1 min-w-32 sm:mt-6 sm:mb-0">
                    <div class="archive-month-label inline-flex items-center gap-2 text-sm font-semibold tracking-wide text-foreground/85 sm:text-base">
                      <span>{months[Number(month) - 1]}</span>
                      <span class="text-foreground/45 sm:hidden">
                        {tplStr(t.pages.archivesPostCount, {
                          count: monthGroup.length,
                        })}
                      </span>
                    </div>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.published).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.published).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <Card {...data} />
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>
  <Footer />
</Layout>

<style>
  /* 移动端优化 */
  @media (max-width: 640px) {
    [data-month-group] {
      position: relative;
      padding-left: 0;
      margin-left: 0;
      padding-top: 0.2rem;
    }

    [data-month-group]::before {
      content: none;
    }

    [data-month-group] > div:first-child {
      margin-bottom: 0.25rem;
    }

    [data-month-group] + [data-month-group] {
      margin-top: 0.4rem;
      border-top: 1px dashed color-mix(in oklab, var(--border) 75%, transparent);
      padding-top: 0.85rem;
    }
  }
</style>
