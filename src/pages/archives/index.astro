---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArchiveRow from "@/components/archive/ArchiveRow.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import postFilter from "@/utils/postFilter";
import { SITE } from "@/config";
import { getYearMonthInTimeZone } from "@/utils/calendarDate";
import { tplStr, useTranslations } from "@/i18n";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/404`);
}

const posts = await getCollection("blog", postFilter);
const t = useTranslations(SITE.lang);

const months = t.pages.archivesMonthNames;
const yearGroups = Object.entries(
  getPostsByGroupCondition(
    posts,
    post => getYearMonthInTimeZone(post.data.published).year
  )
).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
---

<Layout title={`${t.pages.archivesTitle} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    <nav class="archive-jump" aria-label="按年份快速跳转" data-pagefind-ignore>
      <span class="archive-jump-label">快速跳转</span>
      <div class="archive-jump-links">
        {
          yearGroups.map(([year, yearGroup]) => (
            <a href={`#archive-year-${year}`}>
              {year}
              <span aria-hidden="true"> · {yearGroup.length}</span>
            </a>
          ))
        }
      </div>
    </nav>
    <!-- 页面描述区域 -->
    <!-- <div
      class="mb-8 rounded-xl border-l-4 border-accent/60 bg-accent/5 px-4 py-4 text-sm text-foreground/80"
    >
      <div class="flex items-start gap-3">
        <span class="mt-0.5 text-lg text-accent/80">📦</span>
        <div class="flex-1">
          <p class="mb-2 text-base font-semibold text-foreground/90">
            文章归档
          </p>
          <p class="mb-2">
            这里按时间顺序整理了所有已发布的文章，方便您按年月浏览。
          </p>
          <div class="flex flex-wrap gap-4 text-sm text-foreground/60">
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/60"></span>
              按年份和月份分组
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/40"></span>
              支持快速跳转浏览
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/20"></span>
              完整的文章时间线
            </span>
          </div>
        </div>
      </div>
    </div> -->
    {
      yearGroups.map(([year, yearGroup], yearIndex) => {
        const isLatestYear = yearIndex === 0;

        return (
          <details
            class="archive-year mb-8"
            open={isLatestYear}
            aria-labelledby={`archive-year-${year}`}
          >
            <summary
              id={`archive-year-${year}`}
              class="archive-year-summary mb-6 flex cursor-pointer list-none items-center justify-between border-b border-border/30 pb-3 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent [&::-webkit-details-marker]:hidden"
            >
              <span class="flex items-baseline gap-3">
                <span class="text-2xl font-bold text-foreground/90">
                  {year}
                </span>
                <span class="rounded-full bg-accent/10 px-2.5 py-1 text-sm font-medium text-accent">
                  {tplStr(t.pages.archivesPostCount, {
                    count: yearGroup.length,
                  })}
                </span>
              </span>
              <span class="archive-year-sort text-sm text-foreground/40">
                {t.pages.archivesSortByPublished}
              </span>
            </summary>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post =>
                  getYearMonthInTimeZone(post.data.published).monthIndex + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div
                  class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-4"
                  data-month-group
                >
                  <div class="mt-2 mb-1 min-w-32 sm:mt-6 sm:mb-0">
                    <div class="archive-month-label inline-flex items-center gap-2 text-sm font-semibold tracking-wide text-foreground/85 sm:text-base">
                      <span>{months[Number(month) - 1]}</span>
                      <span class="text-foreground/45 sm:hidden">
                        {tplStr(t.pages.archivesPostCount, {
                          count: monthGroup.length,
                        })}
                      </span>
                    </div>
                  </div>
                  <ul
                    class="min-w-0 flex-1"
                    aria-label={`${months[Number(month) - 1]}文章`}
                  >
                    {[...monthGroup]
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.published).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.published).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <ArchiveRow {...data} />
                      ))}
                  </ul>
                </div>
              ))}
          </details>
        );
      })
    }
  </Main>
  <Footer />
</Layout>

<style>
  .archive-jump {
    position: sticky;
    top: var(--site-header-height, 4rem);
    z-index: 15;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 1rem 0 1.75rem;
    overflow-x: auto;
    border-block: 1px solid color-mix(in oklab, var(--border) 65%, transparent);
    padding: 0.65rem 0.25rem;
    background: color-mix(in oklab, var(--background) 92%, transparent);
    backdrop-filter: blur(10px);
    scrollbar-width: thin;
  }

  .archive-jump-label {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .archive-jump-links {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-width: max-content;
  }

  .archive-jump-links a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    border: 1px solid color-mix(in oklab, var(--border) 75%, transparent);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    color: var(--foreground-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    white-space: nowrap;
  }

  .archive-jump-links a:hover,
  .archive-jump-links a:focus-visible {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--border));
    color: var(--accent);
    background: var(--accent-soft);
    outline: none;
  }

  .archive-year-summary::after {
    content: "+";
    flex: 0 0 auto;
    margin-left: 1rem;
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
  }

  .archive-year[open] .archive-year-summary::after {
    content: "−";
  }

  /* 移动端优化 */
  @media (max-width: 640px) {
    [data-month-group] {
      position: relative;
      padding-left: 0;
      margin-left: 0;
      padding-top: 0.2rem;
    }

    [data-month-group]::before {
      content: none;
    }

    [data-month-group] > div:first-child {
      margin-bottom: 0.25rem;
    }

    [data-month-group] + [data-month-group] {
      margin-top: 0.4rem;
      border-top: 1px dashed color-mix(in oklab, var(--border) 75%, transparent);
      padding-top: 0.85rem;
    }

    .archive-year-sort {
      display: none;
    }

    .archive-year-summary {
      margin-bottom: 1.25rem;
    }
  }
</style>
