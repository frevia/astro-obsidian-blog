---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";
import FootprintMap from "@/components/FootprintMap.tsx";
import { SITE } from "@/config";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import postFilter from "@/utils/postFilter";
import { getPath } from "@/utils/getPath";
import { optimizeImage } from "@/utils/optimizeImages";
import { firstContentImage } from "@/utils/footprintImage";

const blogPosts = await getCollection("blog");
const publishedPosts = blogPosts.filter(postFilter);

type PlaceRecord = {
  name: string;
  lng: number;
  lat: number;
};

function parseLocationText(text: string): PlaceRecord | null {
  const parts = text.split(",").map(s => s.trim());
  if (parts.length < 3) return null;

  const name = parts.slice(0, -2).join(",").trim();
  const lngRaw = parts.at(-2);
  const latRaw = parts.at(-1);
  if (!name || !lngRaw || !latRaw) return null;

  const lng = Number(lngRaw);
  const lat = Number(latRaw);
  if (!Number.isFinite(lng) || !Number.isFinite(lat)) return null;
  if (lng < -180 || lng > 180 || lat < -90 || lat > 90) return null;
  return { name, lng, lat };
}

function toPlaceRecords(post: (typeof publishedPosts)[number]): PlaceRecord[] {
  const { locations } = post.data;
  if (!locations?.length) return [];
  return locations
    .filter(Boolean)
    .map(parseLocationText)
    .filter(Boolean) as PlaceRecord[];
}

const footprintPosts = publishedPosts.filter(
  post => toPlaceRecords(post).length > 0
);

const placesFromPosts = footprintPosts
  .flatMap(post => toPlaceRecords(post))
  .filter((loc): loc is PlaceRecord => Boolean(loc));

type PostLocationRecord = {
  title: string;
  url: string;
  name: string;
  lng: number;
  lat: number;
  date: string;
  thumbnail?: {
    src: string;
    alt: string;
  };
};

async function getPostThumbnail(
  post: (typeof publishedPosts)[number]
): Promise<PostLocationRecord["thumbnail"]> {
  const contentImage = firstContentImage(post.body);
  if (contentImage) {
    const optimized = await optimizeImage(contentImage, {
      thumbnailSize: 360,
      quality: 78,
    });
    return {
      src: optimized.thumbnail,
      alt: `${post.data.title}的文章配图`,
    };
  }

  const cover = post.data.cover;
  if (!cover) return undefined;

  if (typeof cover === "string") {
    const optimized = await optimizeImage(cover, {
      thumbnailSize: 360,
      quality: 78,
    });
    return {
      src: optimized.thumbnail,
      alt: `${post.data.title}的封面`,
    };
  }

  const optimized = await getImage({
    src: cover,
    width: 360,
    height: 225,
    fit: "cover",
    format: "webp",
    quality: 78,
  });
  return {
    src: optimized.src,
    alt: `${post.data.title}的封面`,
  };
}

const thumbnailEntries = await Promise.all(
  footprintPosts.map(
    async post => [post.id, await getPostThumbnail(post)] as const
  )
);
const thumbnailsByPost = new Map(thumbnailEntries);

const postLocationRecords = footprintPosts.flatMap(post =>
  toPlaceRecords(post).map(
    loc =>
      ({
        title: post.data.title,
        url: getPath(post.id, post.filePath),
        name: loc.name,
        lng: loc.lng,
        lat: loc.lat,
        date: post.data.published.toISOString(),
        thumbnail: thumbnailsByPost.get(post.id),
      }) satisfies PostLocationRecord
  )
);

const uniquePlaces = Array.from(
  new Map(
    placesFromPosts.map(
      loc => [`${loc.name}:${loc.lng},${loc.lat}`, loc] as const
    )
  ).values()
);

const places = Array.from(
  new Map(
    uniquePlaces.map(loc => [`${loc.name}:${loc.lng},${loc.lat}`, loc] as const)
  ).values()
);
---

<Layout title={`足迹 | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="足迹"
    pageDesc="记录去过的地方，也方便回到相关文章。"
    pageDescClass="max-w-2xl"
  >
    <FootprintMap
      client:visible
      places={places}
      records={postLocationRecords}
    />
  </Main>
  <Footer />
</Layout>
