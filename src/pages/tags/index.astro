---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Tag from "@/components/Tag.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import postFilter from "@/utils/postFilter";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n";

const posts = await getCollection("blog");
const t = useTranslations(SITE.lang);

const tagCountMap = posts
  .filter(postFilter)
  .flatMap(post => post.data.tags)
  .map(tag => slugifyStr(tag))
  .reduce((counts, tag) => {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
    return counts;
  }, new Map<string, number>());

let tags = getUniqueTags(posts).sort(
  (a, b) =>
    (tagCountMap.get(b.tag) ?? 0) - (tagCountMap.get(a.tag) ?? 0) ||
    a.tagName.localeCompare(b.tagName, "zh-CN")
);
---

<Layout title={`${t.pages.tagsTitle} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <!-- 页面描述区域 -->
    <div
      class="mb-8 rounded-xl border-l-4 border-accent/60 bg-accent/5 px-4 py-4 text-sm text-foreground/80"
    >
      <div class="flex items-start gap-3">
        <span class="mt-0.5 text-lg text-accent/80">🏷️</span>
        <div class="flex-1">
          <p class="mb-2 text-base font-semibold text-foreground/90">
            {t.pages.tagsIntroTitle}
          </p>
          <p class="mb-2">
            {t.pages.tagsIntroDesc}
          </p>
          <p class="mb-3 text-xs text-foreground/55">
            共 {tags.length} 个主题，按文章数量从高到低排列。
          </p>
          <div class="flex flex-wrap gap-4 text-xs text-foreground/60">
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/60"></span>
              {t.pages.tagsBrowseByTopic}
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/40"></span>
              {t.pages.tagsFindContent}
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-accent/20"></span>
              {t.pages.tagsCloudSystem}
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-12">
      <ul class="tags-cloud flex flex-wrap gap-3">
        {
          tags.map(({ tag, tagName }) => (
            <Tag {tag} {tagName} size="lg" count={tagCountMap.get(tag) ?? 0} />
          ))
        }
      </ul>
    </div>

    <!-- 无标签提示 -->
    {
      tags.length === 0 && (
        <div class="my-12">
          <div class="rounded-xl border border-border/40 bg-muted/10 p-8 text-center">
            <div class="mb-4 text-5xl text-foreground/40">🏷️</div>
            <p class="mb-2 font-medium text-foreground/80">
              {t.pages.tagsEmptyTitle}
            </p>
            <p class="text-sm text-foreground/60">{t.pages.tagsEmptyDesc}</p>
          </div>
        </div>
      )
    }
  </Main>
  <Footer />
</Layout>

<style>
  .tags-cloud {
    border-block: 1px solid color-mix(in oklab, var(--border) 64%, transparent);
    padding-block: 1.25rem;
  }

  .tags-cloud :global(li) {
    border: 1px solid color-mix(in oklab, var(--border) 78%, transparent);
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    background: var(--surface);
    transition:
      border-color var(--motion-fast) ease,
      background-color var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }

  .tags-cloud :global(li:hover),
  .tags-cloud :global(li:focus-within) {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
    background: var(--accent-softer);
    transform: translateY(-1px);
  }
</style>
