---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PagefindSearch from "astro-pagefind/components/Search.astro";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n";
import { withBase } from "@/utils/withBase";

const t = useTranslations(SITE.lang);
const searchLabels = {
  browserTitle: t.pages.searchBrowserTitle,
  title: t.pages.searchTitle,
  description: t.pages.searchDesc,
  placeholder: t.search.placeholder,
};

if (SITE.search !== "pagefind") {
  return Astro.redirect(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/404`);
}
---

<Layout title={`${searchLabels.browserTitle} | ${SITE.title}`}>
  <Header />
  <Main pageTitle={searchLabels.title} pageDesc={searchLabels.description}>
    <div id="search">
      <PagefindSearch
        className="pagefind-search"
        searchboxOptions={{
          "show-sub-results": true,
          placeholder: searchLabels.placeholder,
        }}
      />
      <aside id="search-guidance" class="search-guidance" data-pagefind-ignore>
        <p class="search-guidance-title">先搜一个词</p>
        <p class="search-guidance-copy">
          会查找文章标题、摘要和正文，也可以按 <kbd>⌘ K</kbd> 或
          <kbd>Ctrl K</kbd> 随时打开搜索。
        </p>
        <nav class="search-guidance-links" aria-label="搜索辅助入口">
          <a href={withBase("/tags")}>浏览标签</a>
          <a href={withBase("/archives")}>查看归档</a>
          <a href={withBase("/posts")}>阅读全部文章</a>
        </nav>
      </aside>
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  type SearchURLSyncState = {
    debounceTimer?: number;
    listenersBound?: boolean;
  };

  const searchInputSelector = ".pf-searchbox-input";
  const searchURLSyncWindow = window as Window & {
    __searchURLSyncState?: SearchURLSyncState;
  };
  const searchURLSyncState = (searchURLSyncWindow.__searchURLSyncState ??= {});

  function clearPendingSearchURLUpdate() {
    if (searchURLSyncState.debounceTimer) {
      clearTimeout(searchURLSyncState.debounceTimer);
      searchURLSyncState.debounceTimer = undefined;
    }
  }

  function bindSearchURLSync() {
    const searchInput = document.querySelector(
      searchInputSelector
    ) as HTMLInputElement | null;

    if (!searchInput || searchInput.dataset.searchUrlSyncBound === "true") {
      return;
    }

    searchInput.dataset.searchUrlSyncBound = "true";

    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get("q");

    if (query) {
      searchInput.value = query;
      searchInput.dispatchEvent(new Event("input", { bubbles: true }));
    }

    const updateURL = (query: string) => {
      clearPendingSearchURLUpdate();

      searchURLSyncState.debounceTimer = window.setTimeout(() => {
        searchURLSyncState.debounceTimer = undefined;

        if (!searchInput.isConnected) {
          return;
        }

        const url = new URL(window.location.href);
        if (query) {
          url.searchParams.set("q", query);
        } else {
          url.searchParams.delete("q");
        }
        window.history.replaceState(window.history.state, "", url.toString());
      }, 300);
    };

    searchInput.addEventListener("input", e => {
      const target = e.target as HTMLInputElement;
      if (!target) return;
      document
        .getElementById("search-guidance")
        ?.classList.toggle("is-hidden", target.value.trim().length > 0);
      updateURL(target.value);
    });

    document
      .getElementById("search-guidance")
      ?.classList.toggle("is-hidden", searchInput.value.trim().length > 0);
  }

  function initSearchFromURL() {
    if ("customElements" in window) {
      window.customElements
        .whenDefined("pagefind-searchbox")
        .then(() => window.requestAnimationFrame(bindSearchURLSync))
        .catch(() => bindSearchURLSync());
      return;
    }

    bindSearchURLSync();
  }

  function bindGlobalSearchURLSyncListeners() {
    if (searchURLSyncState.listenersBound) {
      return;
    }

    document.addEventListener("astro:page-load", initSearchFromURL);
    document.addEventListener("astro:before-swap", clearPendingSearchURLUpdate);
    searchURLSyncState.listenersBound = true;
  }

  bindGlobalSearchURLSyncListeners();
  initSearchFromURL();
</script>

<style is:global>
  .pagefind-search {
    --pf-font: var(--font-mono);
    --pf-text: var(--foreground);
    --pf-text-secondary: var(--foreground-muted);
    --pf-text-muted: var(--foreground-muted);
    --pf-background: var(--background);
    --pf-border: var(--border);
    --pf-border-focus: var(--accent);
    --pf-outline-focus: var(--accent);
    --pf-hover: var(--muted);
    --pf-skeleton: var(--muted);
    --pf-skeleton-shine: var(--background);
    --pf-mark: var(--accent);
    --pf-border-radius: 0.375rem;
    --pf-searchbox-max-width: 100%;
    --pf-result-title-font-size: 1rem;
    --pf-result-excerpt-font-size: 0.875rem;
  }

  .pagefind-search .pf-searchbox-input-wrapper::before {
    background-color: var(--foreground);
  }

  .pagefind-search .pf-searchbox-input {
    font-weight: 400;
    border: 1px solid var(--border);
  }

  .pagefind-search .pf-searchbox-input:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .pagefind-search .pf-searchbox-result-title {
    font-weight: 500;
  }

  .pagefind-search .pf-searchbox-result {
    color: var(--accent);
    outline-offset: 1px;
    outline-color: var(--accent);
  }

  .pagefind-search .pf-searchbox-result:focus-visible {
    text-decoration-line: none;
    outline-width: 2px;
    outline-style: dashed;
  }

  .pagefind-search .pf-searchbox-subresult {
    border-inline-start-color: var(--border);
  }

  .search-guidance {
    margin-top: 1.5rem;
    border: 1px solid color-mix(in oklab, var(--border) 76%, transparent);
    border-radius: var(--radius-card-emphasis);
    padding: 1.1rem 1.2rem;
    background: var(--surface-muted);
    transition: opacity var(--motion-fast) ease;
  }

  .search-guidance.is-hidden {
    display: none;
  }

  .search-guidance-title {
    color: var(--foreground);
    font-size: 0.95rem;
    font-weight: 650;
  }

  .search-guidance-copy {
    max-width: 42rem;
    margin-top: 0.35rem;
    color: var(--foreground-muted);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .search-guidance kbd {
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.08rem 0.3rem;
    color: var(--foreground);
    background: var(--surface);
    font-family: var(--font-sans);
    font-size: 0.72rem;
  }

  .search-guidance-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 0.8rem;
  }

  .search-guidance-links a {
    color: var(--accent);
    font-size: 0.78rem;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 0.2em;
  }
</style>
