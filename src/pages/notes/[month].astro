---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { parseEntry } from "@/utils/parseEntry";
import DiaryFeed from "@/components/diary/DiaryFeed.astro";
import ArchiveHero from "@/components/ArchiveHero.astro";
import NotesMonthNav from "@/components/diary/NotesMonthNav.astro";
import { getNotesMonth, groupNotesMonths } from "@/utils/notesMonths";

export async function getStaticPaths() {
  const entries = await getCollection("diary");
  const months = groupNotesMonths(entries.map(entry => entry.id));
  return months.flatMap(group =>
    group.months.map(({ month }) => ({ params: { month } }))
  );
}

const { month } = Astro.params;
const allEntries = await getCollection("diary");
const entries = allEntries
  .filter(entry => getNotesMonth(entry.id) === month)
  .sort((a, b) => b.id.split("/").pop()!.localeCompare(a.id.split("/").pop()!));
const parsedEntries = await Promise.all(
  entries.map(entry => parseEntry(entry))
);
const monthGroups = groupNotesMonths(allEntries.map(entry => entry.id));
---

<Layout title={`Notes ${month} | ${SITE.title}`}>
  <Header />
  <main
    id="main-content"
    data-pagefind-ignore
    role="main"
    aria-label="Notes 月份内容"
    class="page-shell mx-auto mt-6 w-full max-w-app min-w-0 px-4 pb-8"
  >
    <section class="min-h-screen" role="region" aria-label={`${month} Notes`}>
      <ArchiveHero />
      <NotesMonthNav months={monthGroups} currentMonth={month} />
      <h2 class="mb-3 text-lg font-semibold">{month} · {entries.length} 天</h2>
      <div id="diary-content" role="feed" aria-label={`${month} Notes 时间线`}>
        <DiaryFeed entries={parsedEntries} />
      </div>
      <BackToTopButton />
    </section>
  </main>
  <Footer />
</Layout>
