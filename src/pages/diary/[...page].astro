---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const diaryEntries = await getCollection("diary");
  const quarterKeys = new Set<string>();

  diaryEntries.forEach(entry => {
    const date = entry.id.split("/").pop()!.replace(".md", "");
    const [year, month] = date.split("-");
    quarterKeys.add(`${year}-Q${Math.ceil(parseInt(month) / 3)}`);
  });

  return [...quarterKeys].map(page => ({ params: { page } }));
}

return Astro.redirect(
  import.meta.env.BASE_URL.replace(/\/$/, "") +
    (Astro.params.page ? "/notes/" + Astro.params.page : "/notes"),
  301
);
---

<div hidden aria-hidden="true"></div>
