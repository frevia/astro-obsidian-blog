---
import { render, type CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import { getYearMonthInTimeZone } from "@/utils/calendarDate";
import AiSummaryCard from "@/components/AiSummaryCard.astro";
import { withBase } from "@/utils/withBase";
import ArticleLightbox from "@/components/ArticleLightbox.astro";
import ArticleHero from "@/components/article/ArticleHero.astro";
import ArticleReadingRail from "@/components/article/ArticleReadingRail.astro";
import {
  getArticleAccent,
  getArticleAccentStyle,
} from "@/components/article/pageAccent";
import { estimateReadingMinutes } from "@/components/article/readingTime";
import "@/styles/article-reading.css";

export interface Props {
  post: CollectionEntry<"clip">;
}

export async function getStaticPaths() {
  const posts = await getCollection("clip");
  const resolveFavoriteSlug = (post: CollectionEntry<"clip">) => {
    const trimmedSlug = post.data.slug?.trim();
    if (trimmedSlug) return trimmedSlug;
    return slugifyStr(post.data.title);
  };

  return posts.map(post => ({
    params: { slug: resolveFavoriteSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(({ depth }) => depth >= 2 && depth <= 4);

const {
  title,
  author,
  description,
  published,
  timezone,
  source,
  summary,
  tags,
} = post.data;

const titleTransitionName = toTransitionName(title);
const coverTransitionName = `${titleTransitionName}-cover`;
const favoriteCategory =
  tags.find(tag => tag.trim().toLowerCase() !== "clippings") ?? "收藏";
const favoriteTags = tags
  .filter(tag => tag.trim().toLowerCase() !== "clippings")
  .slice(0, 6);
const articleAccentInput = {
  contentType: "clip",
  tags,
  body: post.body ?? "",
};
const articleAccent = getArticleAccent(articleAccentInput);
const articleAccentStyle = getArticleAccentStyle(articleAccentInput);
const readingMinutes = estimateReadingMinutes(post.body ?? "");

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  description,
  published,
  scrollSmooth: true,
};

const allClips = await getCollection("clip");
const getGroupingDate = (item: CollectionEntry<"clip">) =>
  item.data.created || item.data.published;

const favoritePosts = Object.entries(
  getPostsByGroupCondition(
    allClips,
    item => getYearMonthInTimeZone(getGroupingDate(item)).year
  )
)
  .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
  .flatMap(([, yearGroup]) =>
    Object.entries(
      getPostsByGroupCondition(
        yearGroup,
        item => getYearMonthInTimeZone(getGroupingDate(item)).monthIndex + 1
      )
    )
      .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
      .flatMap(([, monthGroup]) =>
        [...monthGroup].sort(
          (a, b) =>
            Math.floor(
              new Date(b.data.created ?? b.data.published).getTime() / 1000
            ) -
            Math.floor(
              new Date(a.data.created ?? a.data.published).getTime() / 1000
            )
        )
      )
  );

const allFavorites = favoritePosts.map(({ data: { title, slug }, id }) => ({
  id,
  title,
  slug,
}));

const resolveFavoriteSlug = (slug: string | undefined, title: string) => {
  const trimmedSlug = slug?.trim();
  if (trimmedSlug) return trimmedSlug;
  return slugifyStr(title);
};

const getFavoritePath = (slug: string | undefined, title: string) => {
  return withBase(`/favorites/${resolveFavoriteSlug(slug, title)}`);
};

const currentPostIndex = allFavorites.findIndex(item => item.id === post.id);
const prevPost =
  currentPostIndex > 0 ? allFavorites[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex >= 0 && currentPostIndex < allFavorites.length - 1
    ? allFavorites[currentPostIndex + 1]
    : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={[
      "article-page page-shell mx-auto mt-4 w-full max-w-app px-4 pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
    style={articleAccentStyle}
    data-content-kind={articleAccent.key}
    data-pagefind-body
    data-pagefind-weight="5"
  >
    <ArticleHero
      {title}
      category={favoriteCategory}
      {description}
      {summary}
      {author}
      {published}
      {timezone}
      readingMinutes={readingMinutes}
      showMedia={false}
      tags={favoriteTags}
      {source}
      {titleTransitionName}
      {coverTransitionName}
    />

    {
      tags.length > 0 && (
        <div class="sr-only" data-pagefind-meta="tag">
          {tags.join(", ")}
        </div>
      )
    }

    {summary && <AiSummaryCard {summary} />}

    {
      tocHeadings.length > 0 && (
        <ArticleReadingRail headings={tocHeadings} title="页面导航" />
      )
    }

    <article
      id="article"
      class="article-reading-body js-toc-content app-prose relative mx-auto mt-8 max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content />
    </article>
    <ArticleLightbox />
    <BackToTopButton />

    <div data-pagefind-ignore class="favorite-context app-panel" role="note">
      <span class="favorite-context-icon" aria-hidden="true">📚</span>
      <p>
        本文转载或收集自互联网，仅作学习与整理使用。若内容涉及侵权，请联系删除。
      </p>
    </div>

    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getFavoritePath(prevPost.slug, prevPost.title)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>上一篇</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getFavoritePath(nextPost.slug, nextPost.title)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>下一篇</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .favorite-context {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin: 1.25rem 0 1.75rem;
    padding: 0.75rem 1rem;
    color: var(--foreground-muted);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .favorite-context p {
    margin: 0;
  }

  .favorite-context-icon {
    flex: none;
    color: var(--page-accent);
    filter: saturate(0.85);
  }
</style>
