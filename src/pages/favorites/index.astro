---
import { getCollection, type CollectionEntry } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import { SITE } from "@/config";
import { getYearMonthInTimeZone } from "@/utils/calendarDate";
import { slugifyStr } from "@/utils/slugify";
import { withBase } from "@/utils/withBase";

const clips = await getCollection("clip");
const DEFAULT_VISIBLE_TAGS = 20;
const tagCountMap = clips
  .flatMap(clip => clip.data.tags.map(tag => tag.trim()).filter(Boolean))
  .reduce((acc, tag) => {
    acc.set(tag, (acc.get(tag) ?? 0) + 1);
    return acc;
  }, new Map<string, number>());
const allTags = Array.from(tagCountMap.keys()).sort(
  (a, b) =>
    (tagCountMap.get(b) ?? 0) - (tagCountMap.get(a) ?? 0) ||
    a.localeCompare(b, "zh-CN")
);
const featuredTags = allTags.slice(0, DEFAULT_VISIBLE_TAGS);
const remainingTags = allTags.slice(DEFAULT_VISIBLE_TAGS);

const months = [
  "一月",
  "二月",
  "三月",
  "四月",
  "五月",
  "六月",
  "七月",
  "八月",
  "九月",
  "十月",
  "十一月",
  "十二月",
];

const resolveFavoriteSlug = (slug: string | undefined, title: string) => {
  const trimmedSlug = slug?.trim();
  if (trimmedSlug) return trimmedSlug;
  return slugifyStr(title);
};

const getFavoritePath = (
  slug: string | undefined,
  title: string,
  includeBase = true
) => {
  const basePath = includeBase ? "/favorites" : "";
  const favoriteSlug = resolveFavoriteSlug(slug, title);
  const path = [basePath, favoriteSlug].join("/");
  return includeBase ? withBase(path) : path;
};

const getGroupingDate = (post: CollectionEntry<"clip">) => {
  return post.data.created || post.data.published;
};

const yearGroups = Object.entries(
  getPostsByGroupCondition(
    clips,
    post => getYearMonthInTimeZone(getGroupingDate(post)).year
  )
).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
---

<Layout title={`收藏 | ${SITE.title}`}>
  <Header />
  <Main pageTitle="收藏">
    {
      allTags.length > 0 && (
        <section
          slot="header-extra"
          class="favorites-toolbar mt-4 border-t border-border/50 pt-3"
        >
          <div id="favorites-tag-filter" data-pagefind-ignore>
            <p class="text-sm font-semibold tracking-wide text-foreground/85">
              标签筛选
            </p>
            <p class="mt-1 mb-3 text-xs text-foreground/60">
              共 {allTags.length} 个标签，优先展示高频标签
            </p>
            <div class="flex flex-wrap gap-2.5">
              <button
                type="button"
                data-filter-tag=""
                class="favorite-filter-btn is-active"
              >
                全部
              </button>
              {featuredTags.map(tag => (
                <button
                  type="button"
                  data-filter-tag={tag}
                  class="favorite-filter-btn"
                >
                  {tag}
                </button>
              ))}
            </div>
            {remainingTags.length > 0 && (
              <details class="favorites-tag-more-wrap mt-3">
                <summary class="favorites-tag-summary">
                  更多标签（{remainingTags.length}）
                </summary>
                <div class="mt-2 flex flex-wrap gap-2.5">
                  {remainingTags.map(tag => (
                    <button
                      type="button"
                      data-filter-tag={tag}
                      class="favorite-filter-btn"
                    >
                      {tag}
                    </button>
                  ))}
                </div>
              </details>
            )}
          </div>
        </section>
      )
    }

    <div class="favorites-catalog" data-pagefind-body data-pagefind-weight="4">
      {
        yearGroups.map(([year, yearGroup]) => (
          <section class="favorites-year" data-year-group>
            <div class="favorites-year-head">
              <h2 class="favorites-year-title">{year}</h2>
              <span class="favorites-year-count">{yearGroup.length} 篇</span>
            </div>

            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post =>
                  getYearMonthInTimeZone(getGroupingDate(post)).monthIndex + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="favorites-month" data-month-group>
                  <h3 class="favorites-month-title">
                    {months[Number(month) - 1]}
                  </h3>
                  <ul class="favorites-list">
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(
                              b.data.created ?? b.data.published
                            ).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(
                              a.data.created ?? a.data.published
                            ).getTime() / 1000
                          )
                      )
                      .map(post => (
                        <li
                          class="favorites-item"
                          data-favorite-item
                          data-tags={post.data.tags.join("||")}
                        >
                          <a
                            href={getFavoritePath(
                              post.data.slug,
                              post.data.title
                            )}
                            class="favorites-item-link group"
                          >
                            <div class="favorites-item-top">
                              <div class="favorites-item-head">
                                <span class="favorites-item-title">
                                  {post.data.title}
                                </span>
                                <Datetime
                                  layout="meta"
                                  compact
                                  class="favorites-item-dates"
                                  published={post.data.published}
                                  created={post.data.created}
                                  timezone={post.data.timezone}
                                  showCreated={true}
                                />
                              </div>
                              {(post.data.description?.trim() ||
                                post.data.summary?.trim()) && (
                                <p class="favorites-item-desc">
                                  {post.data.description?.trim() ||
                                    post.data.summary?.trim()}
                                </p>
                              )}
                            </div>
                            {(post.data.source ||
                              post.data.tags.length > 0) && (
                              <div class="favorites-item-foot">
                                {post.data.source ? (
                                  <div class="favorites-item-source-wrap">
                                    <span
                                      class="favorites-item-source"
                                      title={post.data.source}
                                    >
                                      来源 · {post.data.source}
                                    </span>
                                  </div>
                                ) : (
                                  <span class="favorites-item-foot-spacer" />
                                )}
                                {post.data.tags.length > 0 && (
                                  <div class="favorites-item-tags">
                                    {post.data.tags.slice(0, 3).map(tag => (
                                      <button
                                        type="button"
                                        class="favorites-tag favorites-tag--action"
                                        data-action="filter-tag"
                                        data-filter-tag={tag}
                                      >
                                        {tag}
                                      </button>
                                    ))}
                                    {post.data.tags.length > 3 && (
                                      <span class="favorites-tag-more">
                                        +{post.data.tags.length - 3}
                                      </span>
                                    )}
                                  </div>
                                )}
                              </div>
                            )}
                          </a>
                        </li>
                      ))}
                  </ul>
                </div>
              ))}
          </section>
        ))
      }

      <div
        id="favorites-empty"
        class="favorites-empty empty-state-card hidden"
        data-pagefind-ignore
      >
        <p class="favorites-empty-title">当前标签下暂无收藏</p>
        <p class="favorites-empty-desc">试试其他标签，或查看全部内容</p>
        <button
          type="button"
          onclick="applyFilter('')"
          class="favorite-filter-btn is-active mt-4"
        >
          查看全部
        </button>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<style>
  .favorites-toolbar {
    scroll-margin-top: var(--site-header-height, 4rem);
  }

  .favorites-tag-summary {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    transition: color 0.15s ease;
  }

  .favorites-tag-summary:hover {
    color: color-mix(in oklab, var(--accent) 80%, transparent);
  }

  .favorites-tag-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .favorite-filter-btn {
    display: inline-flex;
    align-items: center;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 9999px;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    color: var(--foreground);
    background: var(--background);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .favorite-filter-btn:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    color: var(--accent);
  }

  .favorite-filter-btn.is-active {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    background: color-mix(in oklab, var(--accent) 8%, var(--background));
  }

  .favorite-filter-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    text-decoration: none;
  }

  .favorites-catalog {
    --favorites-pad-x: 0.75rem;
  }

  .favorites-year {
    margin-bottom: 2.5rem;
  }

  .favorites-year:last-child {
    margin-bottom: 0;
  }

  .favorites-year-head {
    position: sticky;
    top: var(--site-header-height, 4rem);
    z-index: 10;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 65%, transparent);
    background: color-mix(in oklab, var(--background) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .favorites-year-title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .favorites-year-count {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in oklab, var(--foreground) 45%, transparent);
    white-space: nowrap;
  }

  .favorites-month {
    margin-bottom: 1.75rem;
  }

  .favorites-month:last-child {
    margin-bottom: 0;
  }

  .favorites-month-title {
    margin: 0 0 0.65rem;
    padding-left: 0.65rem;
    border-left: 2px solid color-mix(in oklab, var(--accent) 55%, transparent);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: color-mix(in oklab, var(--foreground) 78%, transparent);
  }

  .favorites-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .favorites-item {
    margin-bottom: 0.75rem;
  }

  .favorites-item:last-child {
    margin-bottom: 0;
  }

  .favorites-item-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.85rem var(--favorites-pad-x);
    margin-inline: 0;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 0.75rem;
    background: var(--background);
    text-decoration: none;
    overflow: visible;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .favorites-item-top {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    min-width: 0;
  }

  .favorites-item-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
    width: 100%;
    min-width: 0;
  }

  .favorites-item-link:hover,
  .favorites-item-link:focus-visible {
    background: color-mix(in oklab, var(--accent) 5%, var(--background));
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
    outline: none;
  }

  .favorites-item-title {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.55;
    color: color-mix(in oklab, var(--foreground) 92%, transparent);
    transition: color 0.15s ease;
  }

  .favorites-item-link:hover .favorites-item-title,
  .favorites-item-link:focus-visible .favorites-item-title {
    color: var(--accent);
  }

  .favorites-item-desc {
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: color-mix(in oklab, var(--foreground) 55%, transparent);
  }

  .favorites-item-head :global(.favorites-item-dates) {
    flex: 0 0 auto;
    margin-left: auto;
    max-width: min(52%, 18rem);
    text-align: right;
    white-space: nowrap;
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--foreground) 42%, transparent);
  }

  .favorites-item-foot .favorites-item-tags {
    display: inline-flex;
    flex: 0 0 auto;
    flex-shrink: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    margin-left: auto;
  }

  .favorites-tag {
    display: inline-flex;
    align-items: center;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 9999px;
    padding: 0.375rem 0.625rem;
    font-size: 0.875rem;
    line-height: 1;
    color: var(--foreground);
    background: var(--background);
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .favorites-tag--action {
    cursor: pointer;
  }

  .favorites-tag--action:hover {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
  }

  .favorites-tag--action:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    text-decoration: none;
  }

  .favorites-tag--action.is-active {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
  }

  .favorites-tag-more {
    font-size: 0.6875rem;
    color: color-mix(in oklab, var(--foreground) 42%, transparent);
  }

  .favorites-item-source {
    font-size: 0.75rem;
    line-height: 1.35;
    color: color-mix(in oklab, var(--foreground) 38%, transparent);
  }

  .favorites-empty {
    padding: 3rem 1rem;
    text-align: center;
  }

  .favorites-empty-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    color: color-mix(in oklab, var(--foreground) 72%, transparent);
  }

  .favorites-empty-desc {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    color: color-mix(in oklab, var(--foreground) 48%, transparent);
  }

  @media (min-width: 640px) {
    .favorites-item-title {
      font-size: 1.125rem;
    }
  }

  @media (max-width: 480px) {
    .favorites-item-head :global(.favorites-item-dates) {
      flex: 1 1 100%;
      max-width: 100%;
      margin-left: 0;
    }

    .favorites-item-foot .favorites-item-tags {
      flex: 1 1 100%;
      justify-content: flex-start;
      max-width: 100%;
      margin-left: 0;
    }
  }

  .favorites-item-foot {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.65rem 1rem;
    width: 100%;
    min-width: 0;
    padding-top: 0.2rem;
    font-size: 0.75rem;
    line-height: 1.45;
    color: color-mix(in oklab, var(--foreground) 42%, transparent);
  }

  .favorites-item-foot-spacer {
    flex: 1 1 0%;
    min-width: 0;
  }

  .favorites-item-source-wrap {
    flex: 1 1 0%;
    min-width: 0;
    overflow: hidden;
  }

  .favorites-item-foot .favorites-item-source {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: left;
  }

  @media (max-width: 480px) {
    .favorites-item-foot {
      flex-wrap: wrap;
      row-gap: 0.35rem;
    }

    .favorites-item-source-wrap {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }
</style>

<script is:inline>
  const initFavoriteTagFilter = () => {
    const filterRoot = document.getElementById("favorites-tag-filter");
    if (!filterRoot) return;

    const buttons = Array.from(
      filterRoot.querySelectorAll("[data-filter-tag]")
    );
    const items = Array.from(document.querySelectorAll("[data-favorite-item]"));
    const monthGroups = Array.from(
      document.querySelectorAll("[data-month-group]")
    );
    const yearGroups = Array.from(
      document.querySelectorAll("[data-year-group]")
    );
    const emptyHint = document.getElementById("favorites-empty");

    const listTagButtons = Array.from(
      document.querySelectorAll('[data-action="filter-tag"]')
    );

    const applyFilter = activeTag => {
      buttons.forEach(btn => {
        btn.classList.toggle(
          "is-active",
          (btn.dataset.filterTag ?? "") === activeTag
        );
      });

      listTagButtons.forEach(btn => {
        btn.classList.toggle(
          "is-active",
          activeTag !== "" && (btn.dataset.filterTag ?? "") === activeTag
        );
      });

      items.forEach(item => {
        const tagsRaw = item.dataset.tags ?? "";
        const tags = tagsRaw ? tagsRaw.split("||").filter(Boolean) : [];
        const visible = !activeTag || tags.includes(activeTag);
        item.classList.toggle("hidden", !visible);
      });

      monthGroups.forEach(group => {
        const visibleCount = group.querySelectorAll(
          "[data-favorite-item]:not(.hidden)"
        ).length;
        group.classList.toggle("hidden", visibleCount === 0);
      });

      yearGroups.forEach(group => {
        const visibleCount = group.querySelectorAll(
          "[data-month-group]:not(.hidden)"
        ).length;
        group.classList.toggle("hidden", visibleCount === 0);
      });

      const anyVisible = items.some(item => !item.classList.contains("hidden"));
      if (emptyHint) emptyHint.classList.toggle("hidden", anyVisible);
    };

    window.applyFilter = applyFilter;

    buttons.forEach(btn => {
      btn.addEventListener("click", () => {
        applyFilter(btn.dataset.filterTag ?? "");
      });
    });

    const catalog = document.querySelector(".favorites-catalog");
    if (catalog) {
      catalog.addEventListener("click", event => {
        const tagBtn = event.target.closest('[data-action="filter-tag"]');
        if (!tagBtn) return;
        event.preventDefault();
        event.stopPropagation();
        applyFilter(tagBtn.dataset.filterTag ?? "");
      });

      catalog.addEventListener("keydown", event => {
        if (event.key !== "Enter" && event.key !== " ") return;
        const tagBtn = event.target.closest('[data-action="filter-tag"]');
        if (!tagBtn) return;
        event.preventDefault();
        event.stopPropagation();
        applyFilter(tagBtn.dataset.filterTag ?? "");
      });
    }

    applyFilter("");
  };

  initFavoriteTagFilter();
  document.addEventListener("astro:page-load", initFavoriteTagFilter);
</script>
