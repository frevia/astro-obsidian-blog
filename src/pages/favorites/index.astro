---
import { getCollection, type CollectionEntry } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import { SITE } from "@/config";
import { getYearMonthInTimeZone } from "@/utils/calendarDate";
import { slugifyStr } from "@/utils/slugify";
import { withBase } from "@/utils/withBase";

const clips = await getCollection("clip");
const DEFAULT_VISIBLE_TAGS = 20;
const tagCountMap = clips
  .flatMap(clip => clip.data.tags.map(tag => tag.trim()).filter(Boolean))
  .reduce((acc, tag) => {
    acc.set(tag, (acc.get(tag) ?? 0) + 1);
    return acc;
  }, new Map<string, number>());
const allTags = Array.from(tagCountMap.keys()).sort(
  (a, b) =>
    (tagCountMap.get(b) ?? 0) - (tagCountMap.get(a) ?? 0) ||
    a.localeCompare(b, "zh-CN")
);
const featuredTags = allTags.slice(0, DEFAULT_VISIBLE_TAGS);
const remainingTags = allTags.slice(DEFAULT_VISIBLE_TAGS);

const getGroupingDate = (post: CollectionEntry<"clip">) =>
  post.data.created || post.data.published;

const getTimestamp = (post: CollectionEntry<"clip">) =>
  getGroupingDate(post).getTime();

const sortedClips = [...clips].sort(
  (a, b) => getTimestamp(b) - getTimestamp(a)
);
const latestFavorite = sortedClips[0];
const sourceCount = new Set(
  clips.map(clip => clip.data.source?.trim()).filter(Boolean)
).size;

type FavoriteKind = "text" | "film" | "book" | "music" | "travel" | "tech";

const getFavoriteKind = (post: CollectionEntry<"clip">): FavoriteKind => {
  const tags = post.data.tags.join(" ").toLowerCase();
  if (/(电影|动画|剧集|影视|movie|film|tv)/i.test(tags)) return "film";
  if (/(阅读|书籍|读书|book|reading)/i.test(tags)) return "book";
  if (/(音乐|歌曲|music)/i.test(tags)) return "music";
  if (/(旅行|徒步|travel|hiking)/i.test(tags)) return "travel";
  if (/(技术|编程|数码|软件|pki|tech|programming)/i.test(tags)) return "tech";
  return "text";
};

const favoriteKindLabel: Record<FavoriteKind, string> = {
  text: "文字",
  film: "影视",
  book: "阅读",
  music: "音乐",
  travel: "旅途",
  tech: "技术",
};

const getSourceLabel = (source: string) => {
  try {
    return new URL(source).hostname.replace(/^www\./, "");
  } catch {
    return source.replace(/^https?:\/\//, "").split("/")[0] || source;
  }
};

const months = [
  "一月",
  "二月",
  "三月",
  "四月",
  "五月",
  "六月",
  "七月",
  "八月",
  "九月",
  "十月",
  "十一月",
  "十二月",
];

const resolveFavoriteSlug = (slug: string | undefined, title: string) => {
  const trimmedSlug = slug?.trim();
  if (trimmedSlug) return trimmedSlug;
  return slugifyStr(title);
};

const getFavoritePath = (
  slug: string | undefined,
  title: string,
  includeBase = true
) => {
  const basePath = includeBase ? "/favorites" : "";
  const favoriteSlug = resolveFavoriteSlug(slug, title);
  const path = [basePath, favoriteSlug].join("/");
  return includeBase ? withBase(path) : path;
};

const yearGroups = Object.entries(
  getPostsByGroupCondition(
    clips,
    post => getYearMonthInTimeZone(getGroupingDate(post)).year
  )
).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
---

<Layout title={`收藏 | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="收藏"
    pageDesc="把值得再次阅读、观看或实践的内容收进个人档案馆，让灵感有迹可循。"
    pageDescClass="max-w-2xl"
  >
    <section
      slot="header-extra"
      class="favorites-masthead mt-6 grid gap-4 border-y border-border/55 py-4 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.78fr)]"
      data-pagefind-ignore
    >
      <div class="favorites-masthead-copy">
        <div class="flex items-center gap-3">
          <span class="favorites-eyebrow">精选收藏</span>
          <span class="h-px flex-1 bg-border/60" aria-hidden="true"></span>
        </div>
        <p class="mt-3 max-w-xl text-sm leading-7 text-foreground/70">
          这里不是稍后阅读清单，而是一组经过时间筛选的观点、作品与方法。
          每次回看，都会为它们补上新的注脚。
        </p>
        <dl class="favorites-stats mt-5 grid grid-cols-2 gap-2 sm:grid-cols-4">
          <div class="favorites-stat">
            <dt>收藏</dt>
            <dd>{clips.length}</dd>
          </div>
          <div class="favorites-stat">
            <dt>标签</dt>
            <dd>{allTags.length}</dd>
          </div>
          <div class="favorites-stat">
            <dt>年份</dt>
            <dd>{yearGroups.length}</dd>
          </div>
          <div class="favorites-stat">
            <dt>来源</dt>
            <dd>{sourceCount}</dd>
          </div>
        </dl>
      </div>

      {
        latestFavorite && (
          <a
            href={getFavoritePath(
              latestFavorite.data.slug,
              latestFavorite.data.title
            )}
            class="favorites-latest group"
          >
            <span class="favorites-latest-kicker">最近收录</span>
            <div class="mt-3 flex items-start justify-between gap-4">
              <h2 class="favorites-latest-title">
                {latestFavorite.data.title}
              </h2>
              <span class="favorites-latest-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
            <p class="favorites-latest-summary">
              {latestFavorite.data.summary?.trim() ||
                latestFavorite.data.description?.trim() ||
                "打开这条收藏，继续回到它留下的思考现场。"}
            </p>
            <div class="favorites-latest-meta">
              <Datetime
                layout="meta"
                compact
                published={latestFavorite.data.published}
                created={latestFavorite.data.created}
                timezone={latestFavorite.data.timezone}
                showCreated={true}
              />
              {latestFavorite.data.source && (
                <span class="truncate">
                  {getSourceLabel(latestFavorite.data.source)}
                </span>
              )}
            </div>
          </a>
        )
      }
    </section>

    {
      allTags.length > 0 && (
        <section class="favorites-toolbar mt-7 border-b border-border/50 pb-5">
          <div
            id="favorites-tag-filter"
            data-pagefind-ignore
            class="favorites-filter-panel"
          >
            <div class="flex flex-wrap items-end justify-between gap-2">
              <div>
                <p class="favorites-eyebrow">主题筛选</p>
                <p class="mt-1 text-sm text-foreground/70">按主题筛选收藏</p>
              </div>
              <p class="text-xs text-foreground/55">
                {allTags.length} 个标签 · 点击条目上的标签也可筛选
              </p>
            </div>
            <div class="flex flex-wrap gap-2.5">
              <button
                type="button"
                data-filter-tag=""
                aria-pressed="true"
                class="favorite-filter-btn is-active"
              >
                全部
              </button>
              {featuredTags.map(tag => (
                <button
                  type="button"
                  data-filter-tag={tag}
                  aria-pressed="false"
                  class="favorite-filter-btn"
                >
                  {tag}
                  <span class="favorite-filter-count">
                    {tagCountMap.get(tag)}
                  </span>
                </button>
              ))}
            </div>
            {remainingTags.length > 0 && (
              <details class="favorites-tag-more-wrap mt-3">
                <summary class="favorites-tag-summary">
                  更多标签（{remainingTags.length}）
                </summary>
                <div class="mt-2 flex flex-wrap gap-2.5">
                  {remainingTags.map(tag => (
                    <button
                      type="button"
                      data-filter-tag={tag}
                      aria-pressed="false"
                      class="favorite-filter-btn"
                    >
                      {tag}
                      <span class="favorite-filter-count">
                        {tagCountMap.get(tag)}
                      </span>
                    </button>
                  ))}
                </div>
              </details>
            )}
          </div>
        </section>
      )
    }

    <div class="favorites-catalog" data-pagefind-body data-pagefind-weight="4">
      <div class="favorites-catalog-head">
        <div>
          <p class="favorites-eyebrow">收藏索引</p>
          <h2 class="mt-1 text-xl font-semibold tracking-tight text-foreground">
            按时间整理
          </h2>
        </div>
        <p
          id="favorites-filter-status"
          class="text-xs text-foreground/55"
          role="status"
          aria-live="polite"
        >
          共 {clips.length} 条收藏
        </p>
      </div>
      {
        yearGroups.map(([year, yearGroup]) => (
          <section class="favorites-year" data-year-group>
            <div class="favorites-year-head">
              <div>
                <span class="favorites-year-kicker">年份</span>
                <h2 class="favorites-year-title">{year}</h2>
              </div>
              <span class="favorites-year-count">{yearGroup.length} 条</span>
            </div>

            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post =>
                  getYearMonthInTimeZone(getGroupingDate(post)).monthIndex + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="favorites-month" data-month-group>
                  <h3 class="favorites-month-title">
                    {months[Number(month) - 1]}
                  </h3>
                  <ul class="favorites-list">
                    {monthGroup
                      .sort((a, b) => getTimestamp(b) - getTimestamp(a))
                      .map((post, index) => (
                        <li
                          class="favorites-item"
                          data-content-kind={getFavoriteKind(post)}
                          data-favorite-item
                          data-tags={post.data.tags.join("||")}
                        >
                          <div class="favorites-item-card">
                            <a
                              href={getFavoritePath(
                                post.data.slug,
                                post.data.title
                              )}
                              class="favorites-item-link group"
                            >
                              <span
                                class="favorites-item-index"
                                aria-hidden="true"
                              >
                                {String(index + 1).padStart(2, "0")}
                              </span>
                              <div class="favorites-item-top">
                                <div class="favorites-item-head">
                                  <span class="favorites-item-kind">
                                    {favoriteKindLabel[getFavoriteKind(post)]}
                                  </span>
                                  <Datetime
                                    layout="meta"
                                    compact
                                    class="favorites-item-dates"
                                    published={post.data.published}
                                    created={post.data.created}
                                    timezone={post.data.timezone}
                                    showCreated={true}
                                  />
                                </div>
                                <h3 class="favorites-item-title">
                                  {post.data.title}
                                </h3>
                                {(post.data.description?.trim() ||
                                  post.data.summary?.trim()) && (
                                  <p class="favorites-item-desc">
                                    {post.data.description?.trim() ||
                                      post.data.summary?.trim()}
                                  </p>
                                )}
                              </div>
                              <span
                                class="favorites-item-arrow"
                                aria-hidden="true"
                              >
                                ↗
                              </span>
                            </a>
                            {(post.data.source ||
                              post.data.tags.length > 0) && (
                              <div class="favorites-item-foot">
                                {post.data.source ? (
                                  <div class="favorites-item-source-wrap">
                                    <span
                                      class="favorites-item-source"
                                      title={post.data.source}
                                    >
                                      {getSourceLabel(post.data.source)}
                                    </span>
                                  </div>
                                ) : (
                                  <span class="favorites-item-foot-spacer" />
                                )}
                                {post.data.tags.length > 0 && (
                                  <div class="favorites-item-tags">
                                    {post.data.tags.slice(0, 3).map(tag => (
                                      <button
                                        type="button"
                                        class="favorites-tag favorites-tag--action"
                                        data-action="filter-tag"
                                        data-filter-tag={tag}
                                        aria-pressed="false"
                                      >
                                        {tag}
                                      </button>
                                    ))}
                                    {post.data.tags.length > 3 && (
                                      <span class="favorites-tag-more">
                                        +{post.data.tags.length - 3}
                                      </span>
                                    )}
                                  </div>
                                )}
                              </div>
                            )}
                          </div>
                        </li>
                      ))}
                  </ul>
                </div>
              ))}
          </section>
        ))
      }

      <div
        id="favorites-empty"
        class="favorites-empty empty-state-card hidden"
        data-pagefind-ignore
      >
        <p class="favorites-empty-title">当前标签下暂无收藏</p>
        <p class="favorites-empty-desc">试试其他标签，或查看全部内容</p>
        <button
          type="button"
          onclick="applyFilter('')"
          class="favorite-filter-btn is-active mt-4"
        >
          查看全部
        </button>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<style>
  .favorites-toolbar {
    position: sticky;
    top: var(--site-header-height, 4rem);
    z-index: 20;
    margin-inline: -0.25rem;
    padding-inline: 0.25rem;
    /* 吸顶层必须完全遮住滚动中的卡片，避免文字穿透造成重影。 */
    background: var(--background);
    backdrop-filter: blur(10px);
    scroll-margin-top: var(--site-header-height, 4rem);
  }

  .favorites-toolbar::after {
    position: absolute;
    inset-inline: 0;
    bottom: -0.5rem;
    height: 0.5rem;
    background: var(--background);
    content: "";
    pointer-events: none;
  }

  .favorites-eyebrow {
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .favorites-masthead-copy {
    min-width: 0;
  }

  .favorites-stats {
    margin: 0;
  }

  .favorites-stat {
    min-width: 0;
    border-left: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    padding: 0.1rem 0.75rem;
  }

  .favorites-stat dt {
    color: color-mix(in oklab, var(--foreground) 50%, transparent);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  .favorites-stat dd {
    margin: 0.2rem 0 0;
    color: var(--foreground);
    font-size: 1.35rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .favorites-latest {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--accent) 35%, var(--border));
    border-radius: 1rem;
    padding: 1rem 1.1rem;
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in oklab, var(--accent) 14%, transparent),
        transparent 48%
      ),
      var(--surface);
    box-shadow: 0 1rem 3rem -2rem var(--accent);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .favorites-latest:hover,
  .favorites-latest:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 1.25rem 3rem -1.75rem var(--accent);
    outline: none;
    transform: translateY(-2px);
  }

  .favorites-latest-kicker {
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .favorites-latest-title {
    min-width: 0;
    color: var(--foreground);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.3;
    transition: color 180ms ease;
  }

  .favorites-latest:hover .favorites-latest-title,
  .favorites-latest:focus-visible .favorites-latest-title {
    color: var(--accent);
  }

  .favorites-latest-arrow,
  .favorites-item-arrow {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 1.1rem;
    line-height: 1;
  }

  .favorites-latest-summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.6rem;
    color: color-mix(in oklab, var(--foreground) 66%, transparent);
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .favorites-latest-meta {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.9rem;
    color: color-mix(in oklab, var(--foreground) 48%, transparent);
    font-size: 0.6875rem;
  }

  .favorites-filter-panel {
    min-width: 0;
  }

  .favorites-catalog-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin: 2.25rem 0 1.5rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 68%, transparent);
  }

  .favorites-tag-summary {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    transition: color 0.15s ease;
  }

  .favorites-tag-summary:hover {
    color: color-mix(in oklab, var(--accent) 80%, transparent);
  }

  .favorites-tag-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .favorite-filter-btn {
    display: inline-flex;
    align-items: center;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 9999px;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    color: var(--foreground);
    background: var(--background);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .favorite-filter-count {
    margin-left: 0.35rem;
    color: color-mix(in oklab, currentColor 58%, transparent);
    font-size: 0.68em;
    font-variant-numeric: tabular-nums;
  }

  .favorite-filter-btn:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    color: var(--accent);
  }

  .favorite-filter-btn.is-active {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    background: color-mix(in oklab, var(--accent) 8%, var(--background));
  }

  .favorite-filter-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    text-decoration: none;
  }

  .favorites-catalog {
    --favorites-pad-x: 0.75rem;
  }

  .favorites-year {
    margin-bottom: 2.5rem;
    content-visibility: auto;
    contain-intrinsic-size: 1px 1200px;
  }

  .favorites-year:last-child {
    margin-bottom: 0;
  }

  .favorites-year-head {
    position: sticky;
    top: calc(var(--site-header-height, 4rem) + 12.5rem);
    z-index: 10;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding: 0.7rem 0 0.55rem;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 65%, transparent);
    /* 年份标题与筛选栏错层时仍需保持不透明，避免底层内容透出。 */
    background: var(--background);
    backdrop-filter: blur(8px);
  }

  .favorites-year-title {
    margin-top: 0.2rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.9;
    color: color-mix(in oklab, var(--foreground) 18%, transparent);
  }

  .favorites-year-kicker {
    color: var(--accent);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .favorites-year-count {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in oklab, var(--foreground) 45%, transparent);
    white-space: nowrap;
  }

  .favorites-month {
    margin-bottom: 1.75rem;
  }

  .favorites-month:last-child {
    margin-bottom: 0;
  }

  .favorites-month-title {
    margin: 0 0 0.65rem;
    padding-left: 0.65rem;
    border-left: 2px solid color-mix(in oklab, var(--accent) 55%, transparent);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: color-mix(in oklab, var(--foreground) 78%, transparent);
  }

  .favorites-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .favorites-item {
    margin-bottom: 0.75rem;
  }

  .favorites-item:last-child {
    margin-bottom: 0;
  }

  .favorites-item-card {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
    border-radius: 0.9rem;
    background: var(--background);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .favorites-item-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--page-accent, var(--accent));
    content: "";
    opacity: 0.5;
    transition: opacity 180ms ease;
  }

  .favorites-item-card:hover,
  .favorites-item-card:focus-within {
    border-color: color-mix(
      in oklab,
      var(--page-accent, var(--accent)) 55%,
      transparent
    );
    background: color-mix(
      in oklab,
      var(--page-accent, var(--accent)) 4%,
      var(--background)
    );
    box-shadow: 0 1rem 2.5rem -2rem var(--page-accent, var(--accent));
  }

  .favorites-item-card:hover::before,
