---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import {
  buildWikiCatalog,
  selectWikiHighlights,
  WIKI_DOMAINS,
} from "@/utils/wikiCatalog";
import { getWikiTitle } from "@/utils/wikiPath";
import { buildWikilinkGraph } from "@/utils/wikilinkGraph";
import { SITE } from "@/config";
import { withBase } from "@/utils/withBase";
import "@/styles/wiki-index.css";

const entries = [...(await getCollection("wiki"))].sort((a, b) =>
  getWikiTitle(a).localeCompare(getWikiTitle(b), "zh-Hans")
);
const graphEntries = entries.map(entry => ({
  id: entry.id,
  filePath: entry.filePath,
  body: entry.body,
  data: { title: getWikiTitle(entry), slug: entry.data.title },
  routePrefix: "/wiki" as const,
}));
const graph = buildWikilinkGraph(graphEntries);
const catalog = buildWikiCatalog(entries, graph);
const highlights = selectWikiHighlights(catalog, 3);
const layoutProps = {
  title: `知识库 | ${SITE.title}`,
  description: "把收藏、文章和实践沉淀成持续更新的知识网络。",
  canonicalURL: new URL(withBase("/wiki"), Astro.url.origin).href,
  noindex: true,
  includeRss: false,
  includeStructuredData: false,
  contentType: "wiki" as const,
};
---

<Layout {...layoutProps}>
  <Header />
  <main
    id="main-content"
    class="wiki-library page-shell mx-auto mt-4 w-full max-w-app px-4 pb-16"
    data-content-kind="wiki"
    data-pagefind-body
    data-pagefind-weight="4"
  >
    <span class="sr-only" data-pagefind-meta="type">wiki</span>

    <header class="wiki-hero">
      <div class="wiki-hero-copy">
        <p class="wiki-kicker">Knowledge Base · 持续整理</p>
        <h1 data-pagefind-meta="title">知识库</h1>
        <p class="wiki-intro">
          把值得反复使用的概念整理出来，连接来源、实践与新的问题。这里记录的不是结论清单，而是一张可以继续生长的理解网络。
        </p>
      </div>
      <label class="wiki-search">
        <span class="sr-only">搜索知识页</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <input
          id="wiki-search-input"
          type="search"
          placeholder="搜索概念或描述…"
          autocomplete="off"
        />
        <kbd>⌘ K</kbd>
      </label>
    </header>

    <section
      class="wiki-recommendations"
      aria-labelledby="wiki-recommendations-title"
      data-pagefind-ignore
    >
      <header class="wiki-section-heading">
        <div>
          <p class="wiki-section-number">01 / SELECTED</p>
          <h2 id="wiki-recommendations-title">推荐阅读</h2>
        </div>
        <p>按知识连接数挑选，作为进入知识网络的几个入口。</p>
      </header>

      {
        highlights.length > 0 ? (
          <div class="wiki-recommendation-layout">
            {highlights[0] && (
              <article
                class="wiki-recommendation-feature"
                data-wiki-domain={highlights[0].domain.key}
              >
                <a href={highlights[0].href} data-astro-prefetch="hover">
                  <div class="wiki-recommendation-meta">
                    <span>{highlights[0].domain.label}</span>
                    <span>{highlights[0].relations} 个知识连接</span>
                  </div>
                  <h3>{highlights[0].title}</h3>
                  <p>{highlights[0].description}</p>
                  <span class="wiki-recommendation-link">
                    打开概念 <b aria-hidden="true">↗</b>
                  </span>
                </a>
              </article>
            )}

            {highlights.length > 1 && (
              <ol class="wiki-recommendation-extensions" aria-label="延伸阅读">
                {highlights.slice(1).map(item => (
                  <li
                    class="wiki-recommendation-extension"
                    data-wiki-domain={item.domain.key}
                  >
                    <a href={item.href} data-astro-prefetch="hover">
                      <span class="wiki-recommendation-domain">
                        {item.domain.label}
                      </span>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                      <span class="wiki-recommendation-link">
                        {item.relations} 个知识连接 <b aria-hidden="true">↗</b>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </div>
        ) : (
          <p class="wiki-recommendation-empty">知识网络正在整理中。</p>
        )
      }
    </section>

    <section class="wiki-explorer" aria-labelledby="wiki-explorer-title">
      <header class="wiki-explorer-head">
        <div>
          <p class="wiki-section-number">02 / BROWSE</p>
          <h2 id="wiki-explorer-title">知识目录</h2>
        </div>
        <p>按领域浏览全部 {catalog.length} 个概念，或使用上方搜索快速定位。</p>
      </header>

      <div
        class="wiki-domain-tabs"
        role="group"
        aria-label="知识领域筛选"
        data-pagefind-ignore
      >
        <button
          type="button"
          class="is-active"
          data-wiki-filter="all"
          aria-pressed="true"
        >
          全部 <span>{catalog.length}</span>
        </button>
        {
          WIKI_DOMAINS.map(domain => (
            <button
              type="button"
              data-wiki-filter={domain.key}
              aria-pressed="false"
            >
              {domain.label}{" "}
              <span>
                {catalog.filter(item => item.domain.key === domain.key).length}
              </span>
            </button>
          ))
        }
      </div>

      <p
        id="wiki-filter-status"
        class="sr-only"
        role="status"
        aria-live="polite"
      >
        共 {catalog.length} 个知识页
      </p>

      <div class="wiki-directory">
        {
          WIKI_DOMAINS.map(domain => {
            const items = catalog.filter(
              item => item.domain.key === domain.key
            );
            return (
              <section
                id={`wiki-domain-${domain.key}`}
                class={`wiki-directory-group wiki-directory-group--${domain.key}`}
                data-wiki-domain-section={domain.key}
              >
                <header class="wiki-directory-heading">
                  <span class="wiki-directory-index">{domain.index}</span>
                  <div class="wiki-directory-title">
                    <p>{domain.eyebrow}</p>
                    <h3>{domain.label}</h3>
                  </div>
                  <span class="wiki-directory-count">
                    {items.length} 个概念
                  </span>
                  <p class="wiki-directory-description">{domain.description}</p>
                </header>
                <ul
                  class="wiki-directory-list"
                  aria-label={`${domain.label}知识目录`}
                >
                  {items.map((item, index) => (
                    <li
                      class="wiki-directory-row"
                      data-wiki-entry
                      data-wiki-domain={domain.key}
                      data-wiki-search={`${item.title} ${item.description}`.toLocaleLowerCase()}
                    >
                      <a href={item.href} data-astro-prefetch="hover">
                        <span class="wiki-directory-row-index">
                          {domain.index}.{String(index + 1).padStart(2, "0")}
                        </span>
                        <span class="wiki-directory-row-copy">
                          <strong>{item.title}</strong>
                          <span>{item.description}</span>
                        </span>
                        <span class="wiki-directory-row-meta">
                          <span>{item.relations} 个知识连接</span>
                          <b aria-hidden="true">↗</b>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>

      <div id="wiki-empty" class="wiki-empty" hidden data-pagefind-ignore>
        <span>⌁</span>
        <h3>没有找到对应概念</h3>
        <p>换一个关键词，或者浏览全部知识领域。</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  declare global {
    interface Window {
      __wikiExplorerCleanup?: () => void;
    }
  }

  function initWikiExplorer() {
    window.__wikiExplorerCleanup?.();
    const input =
      document.querySelector<HTMLInputElement>("#wiki-search-input");
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-wiki-filter]")
    );
    const entries = Array.from(
      document.querySelectorAll<HTMLElement>("[data-wiki-entry]")
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-wiki-domain-section]")
    );
    const empty = document.querySelector<HTMLElement>("#wiki-empty");
    const status = document.querySelector<HTMLElement>("#wiki-filter-status");
    if (!input || !empty || !status) return;

    let domain = "all";
    const apply = () => {
      const query = input.value.trim().toLocaleLowerCase();
      let visible = 0;

      entries.forEach(entry => {
        const matchesDomain =
          domain === "all" || entry.dataset.wikiDomain === domain;
        const matchesQuery =
          !query || entry.dataset.wikiSearch?.includes(query);
        entry.hidden = !(matchesDomain && matchesQuery);
        if (!entry.hidden) visible += 1;
      });

      sections.forEach(section => {
        section.hidden = !Array.from(
          section.querySelectorAll<HTMLElement>("[data-wiki-entry]")
        ).some(entry => !entry.hidden);
      });

      empty.hidden = visible > 0;
      status.textContent = `找到 ${visible} 个知识页`;
    };

    const cleanups: Array<() => void> = [];
    const onInput = () => apply();
    input.addEventListener("input", onInput);
    cleanups.push(() => input.removeEventListener("input", onInput));

    buttons.forEach(button => {
      const onClick = () => {
        domain = button.dataset.wikiFilter ?? "all";
        buttons.forEach(item => {
          const active = item === button;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        apply();
      };
      button.addEventListener("click", onClick);
      cleanups.push(() => button.removeEventListener("click", onClick));
    });

    const onKeydown = (event: KeyboardEvent) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        input.focus();
      }
    };
    document.addEventListener("keydown", onKeydown);
    cleanups.push(() => document.removeEventListener("keydown", onKeydown));
    window.__wikiExplorerCleanup = () => cleanups.forEach(cleanup => cleanup());
    apply();
  }

  document.addEventListener("astro:page-load", initWikiExplorer);
  document.addEventListener("astro:before-swap", () =>
    window.__wikiExplorerCleanup?.()
  );
  initWikiExplorer();
</script>
