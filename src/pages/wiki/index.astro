---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { buildWikiCatalog, WIKI_DOMAINS } from "@/utils/wikiCatalog";
import { getWikiTitle } from "@/utils/wikiPath";
import { buildWikilinkGraph } from "@/utils/wikilinkGraph";
import { SITE } from "@/config";
import { withBase } from "@/utils/withBase";
import "@/styles/wiki-index.css";

const entries = [...(await getCollection("wiki"))].sort((a, b) =>
  getWikiTitle(a).localeCompare(getWikiTitle(b), "zh-Hans")
);
const graphEntries = entries.map(entry => ({
  id: entry.id,
  filePath: entry.filePath,
  body: entry.body,
  data: { title: getWikiTitle(entry), slug: entry.data.title },
  routePrefix: "/wiki" as const,
}));
const graph = buildWikilinkGraph(graphEntries);
const catalog = buildWikiCatalog(entries, graph);
const domainIcons = {
  trust: "M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z M8 12l3 3 5-6",
  learning: "M4 19h16 M6 15v-4 M12 15V7 M18 15V3",
  thinking: "M9 18h6 M10 21h4 M8 14a6 6 0 1 1 8 0c-1 1-1 2-1 2H9s0-1-1-2Z",
  living:
    "M12 21v-9 M12 16C5 16 3 12 3 6c6 0 9 3 9 8 M12 12c0-6 4-9 9-9 0 6-3 10-9 10",
};
const layoutProps = {
  title: `知识库 | ${SITE.title}`,
  description: "把收藏、文章和实践沉淀成持续更新的知识网络。",
  canonicalURL: new URL(withBase("/wiki"), Astro.url.origin).href,
  noindex: true,
  includeRss: false,
  includeStructuredData: false,
  contentType: "wiki" as const,
};
---

<Layout {...layoutProps}>
  <Header />
  <main
    id="main-content"
    class="wiki-library page-shell mx-auto mt-6 w-full max-w-app px-4 pb-16"
    data-content-kind="wiki"
    data-pagefind-body
    data-pagefind-weight="4"
  >
    <span class="sr-only" data-pagefind-meta="type">wiki</span>

    <header class="wiki-hero">
      <div class="page-intro">
        <h1
          class="page-title text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
          data-pagefind-meta="title"
        >
          知识库
        </h1>
        <p
          class="page-desc mt-2 text-sm leading-7 text-foreground/75 sm:text-base"
        >
          从一个概念出发，找到新的连接。
        </p>
      </div>
      <label class="wiki-search">
        <span class="sr-only">搜索知识页</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <input
          id="wiki-search-input"
          type="search"
          placeholder="搜索概念、关键词…"
          autocomplete="off"
        />
      </label>
    </header>

    <section class="wiki-domains" aria-label="知识领域" data-pagefind-ignore>
      <div class="wiki-domain-grid" role="group" aria-label="知识领域筛选">
        {
          WIKI_DOMAINS.map(domain => (
            <button
              type="button"
              class="wiki-domain-card"
              data-wiki-domain={domain.key}
              data-wiki-filter={domain.key}
              aria-pressed="false"
              aria-controls="wiki-directory"
            >
              <span class="wiki-domain-top">
                <span>{domain.index}</span>
                <span>
                  {
                    catalog.filter(item => item.domain.key === domain.key)
                      .length
                  }{" "}
                  个概念
                </span>
              </span>
              <svg
                class="wiki-domain-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d={domainIcons[domain.key]} />
              </svg>
              <span class="wiki-domain-bottom">
                <strong>{domain.label}</strong>
                <span class="wiki-domain-arrow" aria-hidden="true">
                  ↗
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="wiki-explorer" aria-labelledby="wiki-explorer-title">
      <header class="wiki-explorer-head">
        <h2 id="wiki-explorer-title">概念目录</h2>
        <div class="wiki-explorer-tools">
          <p id="wiki-filter-status" role="status" aria-live="polite">
            共 {catalog.length} 个概念
          </p>
          <button
            type="button"
            class="wiki-all is-active"
            data-wiki-filter="all"
            aria-pressed="true"
            aria-controls="wiki-directory">查看全部</button
          >
        </div>
      </header>

      <div id="wiki-directory" class="wiki-directory">
        {
          WIKI_DOMAINS.map(domain => {
            const items = catalog.filter(
              item => item.domain.key === domain.key
            );
            return (
              <section
                id={`wiki-domain-${domain.key}`}
                class={`wiki-directory-group wiki-directory-group--${domain.key}`}
                data-wiki-domain-section={domain.key}
              >
                <header class="wiki-directory-heading">
                  <h3>{domain.label}</h3>
                  <span class="wiki-directory-count">{items.length}</span>
                </header>
                <ul
                  class="wiki-directory-list"
                  aria-label={`${domain.label}知识目录`}
                >
                  {items.map(item => (
                    <li
                      class="wiki-directory-row"
                      data-wiki-entry
                      data-wiki-domain={domain.key}
                      data-wiki-search={`${item.title} ${item.description}`.toLocaleLowerCase()}
                    >
                      <a
                        class="app-hover-row"
                        href={item.href}
                        data-astro-prefetch="hover"
                      >
                        <strong>{item.title}</strong>
                        <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>

      <div id="wiki-empty" class="wiki-empty" hidden data-pagefind-ignore>
        <span>⌁</span>
        <h3>没有找到对应概念</h3>
        <p>换一个关键词，或者浏览全部知识领域。</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  declare global {
    interface Window {
      __wikiExplorerCleanup?: () => void;
    }
  }

  function initWikiExplorer() {
    window.__wikiExplorerCleanup?.();
    const input =
      document.querySelector<HTMLInputElement>("#wiki-search-input");
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-wiki-filter]")
    );
    const entries = Array.from(
      document.querySelectorAll<HTMLElement>("[data-wiki-entry]")
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-wiki-domain-section]")
    );
    const empty = document.querySelector<HTMLElement>("#wiki-empty");
    const status = document.querySelector<HTMLElement>("#wiki-filter-status");
    if (!input || !empty || !status) return;

    let domain = "all";
    const apply = () => {
      const query = input.value.trim().toLocaleLowerCase();
      let visible = 0;

      entries.forEach(entry => {
        const matchesDomain =
          domain === "all" || entry.dataset.wikiDomain === domain;
        const matchesQuery =
          !query || entry.dataset.wikiSearch?.includes(query);
        entry.hidden = !(matchesDomain && matchesQuery);
        if (!entry.hidden) visible += 1;
      });

      sections.forEach(section => {
        section.hidden = !Array.from(
          section.querySelectorAll<HTMLElement>("[data-wiki-entry]")
        ).some(entry => !entry.hidden);
      });

      empty.hidden = visible > 0;
      status.textContent = `${visible} 个概念`;
    };

    const cleanups: Array<() => void> = [];
    const onInput = () => apply();
    input.addEventListener("input", onInput);
    cleanups.push(() => input.removeEventListener("input", onInput));

    buttons.forEach(button => {
      const onClick = () => {
        domain = button.dataset.wikiFilter ?? "all";
        buttons.forEach(item => {
          const active = item === button;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        apply();
      };
      button.addEventListener("click", onClick);
      cleanups.push(() => button.removeEventListener("click", onClick));
    });

    window.__wikiExplorerCleanup = () => cleanups.forEach(cleanup => cleanup());
    apply();
  }

  document.addEventListener("astro:page-load", initWikiExplorer);
  document.addEventListener("astro:before-swap", () =>
    window.__wikiExplorerCleanup?.()
  );
  initWikiExplorer();
</script>
