---
/**
 * 关于页布局
 *
 * @fileoverview 关于页的特殊布局，包含博客统计与时间轴
 *
 * 核心逻辑：
 * 1. 获取博客统计数据（运行天数、文章数、字数）
 * 2. 通过 data 属性传递统计值给客户端脚本
 * 3. 在页面切换后恢复统计与时间轴内容
 * 4. 支持渲染时间轴（从 JSON 数据）
 *
 * 依赖关系：
 * - 被 /about.astro 页面使用
 * - 继承 Layout.astro
 * - 导入 Header、Footer 组件
 * - 使用 getBlogMetrics 获取统计数据
 */

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Twikoo from "@/components/Twikoo.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import { getYMDParts } from "@/utils/calendarDate";
import { getBlogMetrics } from "@/utils/getBlogMetrics";
import "@/styles/about-page.css";
import {
  PUBLIC_TWIKOO_ENABLED,
  PUBLIC_TWIKOO_ENV_ID,
  PUBLIC_TWIKOO_REGION,
} from "astro:env/client";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
// 获取博客统计数据
const blogStats = await getBlogMetrics();
const commentsEnabled =
  SITE.comments.enabled && PUBLIC_TWIKOO_ENABLED !== "false";
const hasTwikooEnv =
  (PUBLIC_TWIKOO_ENV_ID ?? "").trim().length > 0 &&
  (PUBLIC_TWIKOO_REGION ?? "").trim().length > 0;

// 解析博客创建日期
const {
  year: startYear,
  month: startMonth,
  day: startDay,
} = getYMDParts(SITE.createdAt);
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header />
  <main
    id="main-content"
    class="about-page page-shell mx-auto mt-6 w-full max-w-app px-4 pb-12"
  >
    <section class="about-hero" aria-labelledby="about-heading">
      <div class="about-hero-copy">
        <span class="about-eyebrow">Frevia 的记录</span>
        <h1 id="about-heading">{frontmatter.title}</h1>
        {
          frontmatter.description && (
            <p class="about-hero-description">{frontmatter.description}</p>
          )
        }
        <div class="about-hero-meta">
          <span>
            开始于
            <time datetime={`${startYear}-${startMonth}-${startDay}`}>
              <span id="start-year">{startYear}</span>.<span id="start-month"
                >{startMonth}</span
              >.<span id="start-day">{startDay}</span>
            </time>
          </span>
          <span class="about-hero-meta-dot" aria-hidden="true">·</span>
          <span>持续更新的档案</span>
        </div>
      </div>
      <div class="about-hero-mark" aria-hidden="true">
        <span class="about-hero-mark-letter">F</span>
        <span>继续<br />记录</span>
      </div>
    </section>

    <section class="about-stats" aria-labelledby="about-stats-title">
      <header class="about-stats-head">
        <div>
          <span class="about-eyebrow">记录数据</span>
          <h2 id="about-stats-title">一段持续更新的记录</h2>
        </div>
        <span class="about-stats-status">持续书写</span>
      </header>
      <div class="about-stat-grid">
        <article class="about-stat about-stat--days">
          <span class="about-stat-label">运行天数</span>
          <div class="about-stat-value">
            <strong id="running-days">{blogStats.runningDays}</strong>
            <span>天</span>
          </div>
          <p>把日子写成可以回访的坐标。</p>
        </article>
        <article class="about-stat">
          <span class="about-stat-label">已发表</span>
          <div class="about-stat-value">
            <strong id="total-posts">{blogStats.totalPosts}</strong>
            <span>篇</span>
          </div>
          <p>
            <span id="blog-posts">{blogStats.blogPosts}</span> 篇文章 ·
            <span id="diary-posts">{blogStats.diaryPosts}</span> 篇碎片
          </p>
        </article>
        <article class="about-stat about-stat--words">
          <span class="about-stat-label">估算字数</span>
          <div class="about-stat-value">
            <strong id="total-words">{blogStats.totalWordsInWan}</strong>
            <span>万字</span>
          </div>
          <p>按每篇文章约 1500 字估算，实际内容持续增长。</p>
        </article>
      </div>
    </section>

    <section id="about" class="about-content app-prose prose-img:border-0">
      <!-- 统计数据容器（隐藏） -->
      <!-- 通过 data 属性传递值给客户端脚本 -->
      <div
        id="blog-stats-data"
        data-running-days={blogStats.runningDays}
        data-total-posts={blogStats.totalPosts}
        data-blog-posts={blogStats.blogPosts}
        data-diary-posts={blogStats.diaryPosts}
        data-total-words={blogStats.totalWordsInWan}
        data-start-year={startYear}
        data-start-month={startMonth}
        data-start-day={startDay}
        style="display: none;"
      >
      </div>
      <!-- 插槽：页面内容 -->
      <slot />

      {
        commentsEnabled && (
          <>
            <hr class="my-8 border-dashed" />
            <h2 class="mb-4 text-xl font-semibold">留言</h2>
          </>
        )
      }

      {commentsEnabled && hasTwikooEnv && <Twikoo />}

      {
        commentsEnabled && !hasTwikooEnv && (
          <div class="mt-8 rounded-xl border border-border/60 bg-muted/15 px-4 py-3 text-sm text-foreground/80">
            留言功能已开启，但尚未完成 Twikoo 配置。请在环境变量中设置
            <code class="mx-1 rounded bg-muted/30 px-1.5 py-0.5 text-xs">
              PUBLIC_TWIKOO_ENV_ID
            </code>
            与
            <code class="mx-1 rounded bg-muted/30 px-1.5 py-0.5 text-xs">
              PUBLIC_TWIKOO_REGION
            </code>
            后重新部署。
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  /**
   * 恢复 SSR 统计值。
   *
   * 统计值直接在 HTML 中渲染，避免客户端动画期间出现误导性的 0，
   * 同时保证 View Transition 导航后内容仍然可见。
   */
  function renderStats() {
    const statsData = document.getElementById("blog-stats-data");
    if (!statsData) return;

    // 读取 data 属性中的统计值
    const runningDays = parseInt(statsData.dataset.runningDays || "0");
    const totalPosts = parseInt(statsData.dataset.totalPosts || "0");
    const blogPosts = parseInt(statsData.dataset.blogPosts || "0");
    const diaryPosts = parseInt(statsData.dataset.diaryPosts || "0");
    const totalWords = parseFloat(statsData.dataset.totalWords || "0");
    const startYear = parseInt(statsData.dataset.startYear || "2025");
    const startMonth = parseInt(statsData.dataset.startMonth || "3");
    const startDay = parseInt(statsData.dataset.startDay || "17");

    const elYear = document.getElementById("start-year");
    const elMonth = document.getElementById("start-month");
    const elDay = document.getElementById("start-day");
    const elDays = document.getElementById("running-days");
    const elPosts = document.getElementById("total-posts");
    const elBlogPosts = document.getElementById("blog-posts");
    const elDiaryPosts = document.getElementById("diary-posts");
    const elWords = document.getElementById("total-words");

    if (elYear) elYear.textContent = String(startYear);
    if (elMonth) elMonth.textContent = String(startMonth);
    if (elDay) elDay.textContent = String(startDay);
    if (elDays) elDays.textContent = String(runningDays);
    if (elPosts) elPosts.textContent = String(totalPosts);
    if (elBlogPosts) elBlogPosts.textContent = String(blogPosts);
    if (elDiaryPosts) elDiaryPosts.textContent = String(diaryPosts);
    if (elWords) elWords.textContent = totalWords.toFixed(1);
  }

  /**
   * 渲染博客进程时间轴
   *
   * 从 #blog-timeline-data 读取 JSON 数据
   * 生成时间轴列表项
   */
  function renderTimeline() {
    const timeline = document.getElementById("blog-timeline");
    const dataEl = document.getElementById("blog-timeline-data");

    if (!timeline || !dataEl) return;
    if (timeline.dataset.initialized === "true") return;

    try {
      const events = JSON.parse(dataEl.textContent || "[]");
      const frag = document.createDocumentFragment();

      events.forEach((evt: { date?: string; text: string }) => {
        const li = document.createElement("li");
        li.className = "flex items-center gap-2 leading-6";

        // 解析日期（格式：YYYY-MM-DD 或自定义）
        const parts = (evt.date || "").split("-");
        const ymd =
          parts.length === 3
            ? `${parts[0]}-${parts[1]}-${parts[2]}`
            : evt.date || "";

        const date = document.createElement("span");
        date.className = "text-right tabular-nums text-sm opacity-80";
        date.textContent = ymd;

        const sep = document.createElement("span");
        sep.className = "opacity-80";
        sep.textContent = "»";

        const text = document.createElement("span");
        text.className = "flex-1 text-sm text-accent truncate";
        text.textContent = evt.text;

        li.append(date, sep, text);
        frag.appendChild(li);
      });

      timeline.appendChild(frag);
      timeline.dataset.initialized = "true";
    } catch {
      /* 忽略渲染错误 */
    }
  }

  function initializeAboutPage() {
    renderStats();
    renderTimeline();
  }

  // View Transitions 导航后初始化
  document.addEventListener("astro:page-load", () => {
    initializeAboutPage();
  });

  // 初始加载时初始化
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeAboutPage, {
      once: true,
    });
  } else {
    initializeAboutPage();
  }
</script>
