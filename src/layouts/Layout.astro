---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { SITE, config } from "@/config";
import "@/styles/global.css";

import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import CalendarModal from "@/components/CalendarModal.astro";
import CalendarWidget from "@/components/CalendarWidget.astro";
import SearchDialog from "@/components/SearchDialog.astro";
import { getAssetPath, withBase } from "@/utils/withBase";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  cover?: string;
  canonicalURL?: string;
  published?: Date;
  scrollSmooth?: boolean;
  /** Suppress indexing for private/projection pages such as the public wiki. */
  noindex?: boolean;
  /** Wiki pages are intentionally excluded from the site's RSS discovery link. */
  includeRss?: boolean;
  /** Content family exposed to search/consumers as a stable page-level marker. */
  contentType?: "post" | "wiki" | "page";
  /** Wiki pages are reference documents, not BlogPosting records. */
  includeStructuredData?: boolean;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  cover = SITE.cover ? getAssetPath(`/${SITE.cover}`) : getAssetPath("/og.png"),
  canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url),
  published,
  scrollSmooth = false,
  noindex = false,
  includeRss = true,
  contentType = "page",
  includeStructuredData = true,
} = Astro.props;

const showCalendar = SITE.showCalendar;
const useNativeViewTransitions = config.features.viewTransitions === "native";

const socialImageURL = new URL(cover, Astro.site ?? Astro.url);
const rssURL = new URL(withBase("/rss.xml"), Astro.site ?? Astro.url);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: `${title}`,
  image: `${socialImageURL}`,
  datePublished: `${published?.toISOString()}`,
  author: [
    {
      "@type": "Person",
      name: `${author}`,
      ...(profile && { url: profile }),
    },
  ],
};
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={`${SITE.lang ?? "en"}`}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-noto-sans-sc" />
    <Font cssVariable="--font-noto-serif-sc" />
    <link rel="icon" type="image/png" href={getAssetPath("/favicon.png")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="content-type" content={contentType} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      published && (
        <meta
          property="article:published_time"
          content={published.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    {
      includeStructuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    {
      includeRss && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={SITE.title}
          href={rssURL}
        />
      )
    }

    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111827"
      media="(prefers-color-scheme: dark)"
    />

    {
      SITE.googleVerification && (
        <meta
          name="google-site-verification"
          content={SITE.googleVerification}
        />
      )
    }

    {!useNativeViewTransitions && <ClientRouter />}

    <script is:inline src={getAssetPath("/app-controls.js")}></script>

    <style is:global>
      /* Astro 7 native cross-document View Transition experiment. */
      @view-transition {
        navigation: auto;
      }

      #site-header {
        view-transition-name: site-header;
      }

      ::view-transition-group(site-brand) {
        z-index: 3;
      }

      ::view-transition-old(site-brand) {
        animation: 140ms cubic-bezier(0.4, 0, 1, 1) both brand-out;
      }

      ::view-transition-new(site-brand) {
        animation: 220ms cubic-bezier(0, 0, 0.2, 1) both brand-in;
      }

      ::view-transition-old(site-header),
      ::view-transition-new(site-header) {
        animation-duration: 180ms;
      }

      ::view-transition-old(root) {
        animation: 120ms cubic-bezier(0.4, 0, 1, 1) both native-page-out;
      }

      ::view-transition-new(root) {
        animation: 220ms cubic-bezier(0, 0, 0.2, 1) both native-page-in;
      }

      @keyframes native-page-out {
        to {
          opacity: 0;
          transform: translateY(-0.25rem);
        }
      }

      @keyframes native-page-in {
        from {
          opacity: 0;
          transform: translateY(0.25rem);
        }
      }

      @keyframes brand-out {
        to {
          opacity: 0.72;
          transform: translateX(-0.15rem);
        }
      }

      @keyframes brand-in {
        from {
          opacity: 0.72;
          transform: translateX(0.15rem);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation-duration: 1ms !important;
        }
      }
    </style>
  </head>
  <body data-content-type={contentType}>
    <slot />
    <Analytics />
    <SpeedInsights />
    {
      showCalendar && (
        <CalendarModal>
          <CalendarWidget compact />
        </CalendarModal>
      )
    }
    {SITE.search === "pagefind" && <SearchDialog />}
    <script>
      import { setupMermaidEnhancer } from "@/scripts/mermaid-enhancer";

      setupMermaidEnhancer();
    </script>
  </body>
</html>
