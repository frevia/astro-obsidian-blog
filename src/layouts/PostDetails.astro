---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getPath } from "@/utils/getPath";
import { toTransitionName } from "@/utils/toTransitionName";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import MediaCard from "../components/MediaCard.astro";
import Twikoo from "@/components/Twikoo.astro";
import AiSummaryCard from "@/components/AiSummaryCard.astro";
import ArticleLightbox from "@/components/ArticleLightbox.astro";
import WikilinkPanel from "@/components/WikilinkPanel.astro";
import ArticleHero from "@/components/article/ArticleHero.astro";
import ArticleReadingRail from "@/components/article/ArticleReadingRail.astro";
import {
  getArticleAccent,
  getArticleAccentStyle,
} from "@/components/article/pageAccent";
import { estimateReadingMinutes } from "@/components/article/readingTime";
import { buildWikilinkGraph } from "@/utils/wikilinkGraph";
import { PUBLIC_TWIKOO_ENV_ID } from "astro:env/client";
import { tplStr, useTranslations } from "@/i18n";
import "@/styles/article-reading.css";

const commentsEnabled = SITE.comments.enabled;
const hasTwikooEnv = Boolean(PUBLIC_TWIKOO_ENV_ID?.trim());
const t = useTranslations(SITE.lang);

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  cover: initOgImage,
  canonicalURL,
  published,
  timezone,
  hideEditPost,
  summary,
  tags,
} = post.data;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter(({ depth }) => depth >= 2 && depth <= 4);
const titleTransitionName = toTransitionName(title);
const coverTransitionName = `${titleTransitionName}-cover`;
const articleCategory = tags[0] ?? post.id.split("/")[0] ?? "文章";
const articleAccentInput = {
  contentType: post.id.split("/")[0],
  tags,
  body: post.body ?? "",
};
const articleAccent = getArticleAccent(articleAccentInput);
const articleAccentStyle = getArticleAccentStyle(articleAccentInput);
const readingMinutes = estimateReadingMinutes(post.body ?? "");

let coverUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  coverUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  coverUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local cover
if (!coverUrl && SITE.dynamicOgImage) {
  coverUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.cover / default `og.png`)
const cover = coverUrl ? new URL(coverUrl, Astro.url.origin).href : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  published,
  canonicalURL,
  cover,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;

const postDetailsLabels = {
  tocTitle: t.post.tocTitle,
  previousPost: t.post.previousPost,
  nextPost: t.post.nextPost,
  copyCode: t.post.copyCode,
  copiedCode: t.post.copiedCode,
  wikilinksTitle: t.post.wikilinksTitle,
  wikilinksOutgoing: t.post.wikilinksOutgoing,
  wikilinksBacklinks: t.post.wikilinksBacklinks,
};
const twikooEnvName = "PUBLIC_TWIKOO_ENV_ID";
const commentsMissingTwikoo = tplStr(t.post.commentsMissingTwikoo, {
  env: twikooEnvName,
});
const [commentsMissingTwikooBefore, commentsMissingTwikooAfter = ""] =
  commentsMissingTwikoo.split(twikooEnvName);
const wikilinkGraph = buildWikilinkGraph(posts);
const outgoingWikilinks = wikilinkGraph.outgoing.get(post.id) ?? [];
const backlinks = wikilinkGraph.backlinks.get(post.id) ?? [];
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={[
      "article-page mx-auto mt-4 w-full max-w-app px-4 pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
    style={articleAccentStyle}
    data-content-kind={articleAccent.key}
    data-pagefind-body
    data-pagefind-weight="5"
    data-copy-label={postDetailsLabels.copyCode}
    data-copied-label={postDetailsLabels.copiedCode}
  >
    <ArticleHero
      {title}
      category={articleCategory}
      {description}
      {summary}
      {published}
      {timezone}
      readingMinutes={readingMinutes}
      cover={cover}
      {titleTransitionName}
      {coverTransitionName}
    />

    {summary && <AiSummaryCard {summary} />}

    {
      tocHeadings.length > 0 && (
        <ArticleReadingRail
          headings={tocHeadings}
          title={postDetailsLabels.tocTitle}
        />
      )
    }

    <article
      id="article"
      class="article-reading-body js-toc-content app-prose relative mx-auto mt-8 max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content components={{ MediaCard }} />
    </article>
    <ArticleLightbox />

    <WikilinkPanel
      outgoing={outgoingWikilinks}
      {backlinks}
      title={postDetailsLabels.wikilinksTitle}
      outgoingLabel={postDetailsLabels.wikilinksOutgoing}
      backlinksLabel={postDetailsLabels.wikilinksBacklinks}
    />

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ShareLinks />

    {commentsEnabled && hasTwikooEnv && <Twikoo />}

    {
      commentsEnabled && !hasTwikooEnv && (
        <div class="app-notice mt-8 px-4 py-3 text-sm">
          {commentsMissingTwikooBefore}
          <code class="app-code mx-1">{twikooEnvName}</code>
          {commentsMissingTwikooAfter}
        </div>
      )
    }

    <hr
      class={`my-6 ${SITE.comments.enabled ? "border-none" : "border-dashed"}`}
    />

    <BackToTopButton />

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            data-astro-prefetch="hover"
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>{postDetailsLabels.previousPost}</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            data-astro-prefetch="hover"
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>{postDetailsLabels.nextPost}</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<script>
  declare global {
    interface Window {
      __postDetailsCleanup?: () => void;
      __postDetailsLifecycleBound?: boolean;
    }
  }

  function initPostDetails() {
    window.__postDetailsCleanup?.();

    const article = document.getElementById("article");
    if (!(article instanceof HTMLElement)) return;

    const cleanupCallbacks: Array<() => void> = [];
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });

    /** Create a progress indicator
     *  at the top */
    function createProgressBar() {
      // Create the main container div
      const progressContainer = document.createElement("div");
      progressContainer.className =
        "progress-container fixed top-0 z-10 h-1 w-full bg-background";

      // Create the progress bar div
      const progressBar = document.createElement("div");
      progressBar.className = "progress-bar h-1 w-0 bg-accent/15";
      progressBar.id = "myBar";

      // Append the progress bar to the progress container
      progressContainer.appendChild(progressBar);

      // Append the progress container to the document body or any other desired parent element
      document.body.appendChild(progressContainer);
      cleanupCallbacks.push(() => progressContainer.remove());
    }

    /** Update the progress bar
     *  when user scrolls */
    function updateScrollProgress() {
      const onScroll = () => {
        const winScroll =
          document.body.scrollTop || document.documentElement.scrollTop;
        const height =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        if (document) {
          const myBar = document.getElementById("myBar");
          if (myBar) {
            myBar.style.width = scrolled + "%";
          }
        }
      };

      document.addEventListener("scroll", onScroll, { passive: true });
      cleanupCallbacks.push(() =>
        document.removeEventListener("scroll", onScroll)
      );
      onScroll();
    }

    /** 为服务端目录补充当前章节反馈 */
    function setupTableOfContents() {
      const desktopLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("#sidebar [data-toc-link]")
      );
      const mobileLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(
          "#mobile-sidebar [data-toc-link]"
        )
      );
      const links = [...desktopLinks, ...mobileLinks];
      const entries = links.flatMap(link => {
        const href = link.getAttribute("href");
        if (!href?.startsWith("#")) return [];

        let id = href.slice(1);
        try {
          id = decodeURIComponent(id);
        } catch {
          // Keep the literal id when the fragment is not URI encoded.
        }

        const heading = document.getElementById(id);
        return heading instanceof HTMLElement ? [{ heading, link }] : [];
      });
      if (!entries.length) return;
      const headings = Array.from(
        new Map(
          entries.map(entry => [entry.heading.id, entry.heading])
        ).values()
      );
      const progressLabels = Array.from(
        document.querySelectorAll<HTMLElement>("[data-toc-progress]")
      );

      const updateActiveLink = () => {
        const header = document.getElementById("site-header");
        const offset =
          (header instanceof HTMLElement ? header.offsetHeight : 0) + 8;
        let activeHeading = entries[0].heading;

        for (const heading of headings) {
          if (heading.getBoundingClientRect().top > offset) break;
          activeHeading = heading;
        }

        const activeIndex = Math.max(0, headings.indexOf(activeHeading));
        progressLabels.forEach(label => {
          label.textContent = `${activeIndex + 1} / ${headings.length}`;
        });

        links.forEach(link => {
          const isActive = entries.some(
            entry => entry.link === link && entry.heading === activeHeading
          );
          link.classList.toggle("is-active-link", isActive);
          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      document.addEventListener("scroll", updateActiveLink, { passive: true });
      window.addEventListener("resize", updateActiveLink, { passive: true });
      cleanupCallbacks.push(() => {
        document.removeEventListener("scroll", updateActiveLink);
        window.removeEventListener("resize", updateActiveLink);
      });
      updateActiveLink();
    }

    /** 激活构建阶段生成的代码复制按钮 */
    function setupCopyButtons() {
      const main = document.getElementById("main-content");
      if (!(main instanceof HTMLElement)) return;

      const copyLabel = main.dataset.copyLabel;
      const copiedLabel = main.dataset.copiedLabel;
      if (!copyLabel || !copiedLabel) return;

      const copyButtons = main.querySelectorAll<HTMLButtonElement>(
        '[data-copy-button="true"]'
      );

      copyButtons.forEach(copyButton => {
        const toolbar = copyButton.closest("[data-code-toolbar]");
        const pre = toolbar?.querySelector("pre");
        if (!(pre instanceof HTMLPreElement)) return;

        copyButton.textContent = copyLabel;
        copyButton.hidden = false;
        let resetTimer: number | undefined;

        const onCopy = async () => {
          const code = pre.querySelector("code");
          const text = code?.textContent || code?.innerText || "";

          try {
            await navigator.clipboard.writeText(text);
            copyButton.textContent = copiedLabel;

            if (resetTimer !== undefined) window.clearTimeout(resetTimer);
            resetTimer = window.setTimeout(() => {
              copyButton.textContent = copyLabel;
              resetTimer = undefined;
            }, 700);
          } catch {
            // console.error("Failed to copy code:", err);
          }
        };

        copyButton.addEventListener("click", onCopy);
        cleanupCallbacks.push(() => {
          copyButton.removeEventListener("click", onCopy);
          if (resetTimer !== undefined) window.clearTimeout(resetTimer);
          copyButton.textContent = copyLabel;
        });
      });
    }

    createProgressBar();
    updateScrollProgress();
    setupTableOfContents();
    setupCopyButtons();

    window.__postDetailsCleanup = () => {
      cleanupCallbacks.forEach(cleanup => cleanup());
      window.__postDetailsCleanup = undefined;
    };
  }

  if (!window.__postDetailsLifecycleBound) {
    document.addEventListener("astro:page-load", initPostDetails);
    document.addEventListener("astro:before-swap", () => {
      window.__postDetailsCleanup?.();
    });
    window.__postDetailsLifecycleBound = true;
  }

  initPostDetails();
</script>
