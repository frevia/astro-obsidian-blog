---
import "tocbot/dist/tocbot.css";
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import { getPath } from "@/utils/getPath";
import { toTransitionName } from "@/utils/toTransitionName";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import MediaCard from "../components/MediaCard.astro";
import Twikoo from "@/components/Twikoo.astro";
import AiSummaryCard from "@/components/AiSummaryCard.astro";
import ArticleLightbox from "@/components/ArticleLightbox.astro";
import { PUBLIC_TWIKOO_ENV_ID } from "astro:env/client";
import { tplStr, useTranslations } from "@/i18n";

const commentsEnabled = SITE.comments.enabled;
const hasTwikooEnv = Boolean(PUBLIC_TWIKOO_ENV_ID?.trim());
const t = useTranslations(SITE.lang);

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  cover: initOgImage,
  canonicalURL,
  published,
  timezone,
  hideEditPost,
  summary,
  // keywords,
  // mainPoints,
} = post.data;

const { Content } = await render(post);

let coverUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  coverUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  coverUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local cover
if (!coverUrl && SITE.dynamicOgImage) {
  coverUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.cover / default `og.png`)
const cover = coverUrl ? new URL(coverUrl, Astro.url.origin).href : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  published,
  canonicalURL,
  cover,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length ? allPosts[currentPostIndex + 1] : null;

const postDetailsLabels = {
  tocTitle: t.post.tocTitle,
  previousPost: t.post.previousPost,
  nextPost: t.post.nextPost,
  copyCode: t.post.copyCode,
  copiedCode: t.post.copiedCode,
};
const twikooEnvName = "PUBLIC_TWIKOO_ENV_ID";
const commentsMissingTwikoo = tplStr(t.post.commentsMissingTwikoo, {
  env: twikooEnvName,
});
const [commentsMissingTwikooBefore, commentsMissingTwikooAfter = ""] =
  commentsMissingTwikoo.split(twikooEnvName);
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class:list={[
      "mx-auto mt-4 w-full max-w-app px-4 pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
    data-pagefind-body
    data-pagefind-weight="5"
    data-copy-label={postDetailsLabels.copyCode}
    data-copied-label={postDetailsLabels.copiedCode}
  >
    <h1
      transition:name={toTransitionName(title)}
      class="inline-block text-2xl font-bold text-accent sm:text-3xl"
    >
      {title}
    </h1>
    <div class="my-2 flex items-center gap-2">
      <Datetime {published} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "max-sm:hidden",
          { hidden: !SITE.editPost.enabled || hideEditPost },
        ]}>|</span
      >
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>

    {summary && <AiSummaryCard {summary} />}

    <article
      id="article"
      class="js-toc-content app-prose relative mx-auto mt-8 max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
    >
      <Content components={{ MediaCard }} />
    </article>
    <ArticleLightbox />

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ShareLinks />

    {commentsEnabled && hasTwikooEnv && <Twikoo />}

    {
      commentsEnabled && !hasTwikooEnv && (
        <div class="app-notice mt-8 px-4 py-3 text-sm">
          {commentsMissingTwikooBefore}
          <code class="app-code mx-1">{twikooEnvName}</code>
          {commentsMissingTwikooAfter}
        </div>
      )
    }

    <hr
      class={`my-6 ${SITE.comments.enabled ? "border-none" : "border-dashed"}`}
    />

    <BackToTopButton />

    <!-- 目录侧边栏 -->
    <aside id="sidebar" class="sidebar toc-empty hidden lg:block">
      <div class="toc-title mb-2 text-sm font-medium">
        {postDetailsLabels.tocTitle}
      </div>
      <div id="toc-container" class="js-toc"></div>
    </aside>

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPath(prevPost.id, prevPost.filePath)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>{postDetailsLabels.previousPost}</span>
              <div class="text-sm text-accent/85">{prevPost.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPath(nextPost.id, nextPost.filePath)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>{postDetailsLabels.nextPost}</span>
              <div class="text-sm text-accent/85">{nextPost.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import tocbot from "tocbot";

  declare global {
    interface Window {
      __postDetailsCleanup?: () => void;
      __postDetailsLifecycleBound?: boolean;
    }
  }

  function initPostDetails() {
    window.__postDetailsCleanup?.();

    const article = document.getElementById("article");
    if (!(article instanceof HTMLElement)) return;

    const cleanupCallbacks: Array<() => void> = [];
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });

    /** Create a progress indicator
     *  at the top */
    function createProgressBar() {
      // Create the main container div
      const progressContainer = document.createElement("div");
      progressContainer.className =
        "progress-container fixed top-0 z-10 h-1 w-full bg-background";

      // Create the progress bar div
      const progressBar = document.createElement("div");
      progressBar.className = "progress-bar h-1 w-0 bg-accent/15";
      progressBar.id = "myBar";

      // Append the progress bar to the progress container
      progressContainer.appendChild(progressBar);

      // Append the progress container to the document body or any other desired parent element
      document.body.appendChild(progressContainer);
      cleanupCallbacks.push(() => progressContainer.remove());
    }

    /** Update the progress bar
     *  when user scrolls */
    function updateScrollProgress() {
      const onScroll = () => {
        const winScroll =
          document.body.scrollTop || document.documentElement.scrollTop;
        const height =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        if (document) {
          const myBar = document.getElementById("myBar");
          if (myBar) {
            myBar.style.width = scrolled + "%";
          }
        }
      };

      document.addEventListener("scroll", onScroll, { passive: true });
      cleanupCallbacks.push(() =>
        document.removeEventListener("scroll", onScroll)
      );
      onScroll();
    }

    /** 为代码块添加复制按钮 */
    function addCopyButtons() {
      const main = document.getElementById("main-content");
      if (!(main instanceof HTMLElement)) return;

      const copyLabel = main.dataset.copyLabel;
      const copiedLabel = main.dataset.copiedLabel;
      if (!copyLabel || !copiedLabel) return;

      const preElements = document.querySelectorAll("pre");

      // 使用 DocumentFragment 批量处理 DOM 操作
      const elementsToProcess: {
        pre: HTMLPreElement;
        parent: Node;
        nextSibling: Node | null;
      }[] = [];

      preElements.forEach(pre => {
        // 检查是否已经被包装过（即已经有复制按钮）
        if (
          pre.parentElement?.tagName === "DIV" &&
          pre.parentElement?.style.position === "relative" &&
          pre.parentElement?.querySelector('[data-copy-button="true"]')
        ) {
          return;
        }

        // 记录需要处理的元素信息
        const parent = pre.parentNode;
        const nextSibling = pre.nextSibling;
        if (parent) {
          elementsToProcess.push({ pre, parent, nextSibling });
        }
      });

      // 批量创建包装器和按钮
      elementsToProcess.forEach(({ pre, parent, nextSibling }) => {
        // 添加 tabindex 属性
        pre.setAttribute("tabindex", "0");

        // 创建包装器
        const wrapper = document.createElement("div");
        wrapper.style.position = "relative";

        // 创建复制按钮
        const copyButton = document.createElement("button");
        copyButton.className = [
          "copy-code",
          "absolute",
          "end-3",
          "-top-3",
          "rounded",
          "bg-muted",
          "border",
          "border-muted/30",
          "hover:border-muted/60",
          "hover:bg-surface-muted",
          "px-2",
          "py-1",
          "text-xs",
          "leading-4",
          "text-foreground",
          "font-medium",
          "transition-colors",
          "duration-200",
        ].join(" ");
        copyButton.setAttribute("data-copy-button", "true");
        copyButton.setAttribute("type", "button");
        copyButton.textContent = copyLabel;

        // 添加点击事件
        copyButton.addEventListener("click", async () => {
          const code = pre.querySelector("code");
          const text = code?.textContent || code?.innerText || "";

          try {
            await navigator.clipboard.writeText(text);

            // 视觉反馈
            const originalText = copyButton.textContent;
            copyButton.textContent = copiedLabel;

            setTimeout(() => {
              copyButton.textContent = originalText;
            }, 700);
          } catch {
            // console.error("Failed to copy code:", err);
          }
        });

        wrapper.appendChild(pre);
        wrapper.appendChild(copyButton);

        // 一次性插入到 DOM 中
        parent.insertBefore(wrapper, nextSibling);
      });
    }

    createProgressBar();
    updateScrollProgress();
    addCopyButtons();

    // Match TOC calculations with the fixed header height.
    function getTocOffset() {
      const header = document.getElementById("site-header");
      if (!(header instanceof HTMLElement)) return 0;
      return header.offsetHeight + 8;
    }

    const sidebar = document.getElementById("sidebar");
    const tocContainer = document.getElementById("toc-container");

    // initialize tocbot if sidebar exists
    if (tocContainer) {
      const tocOffset = getTocOffset();
      tocbot.destroy();
      tocbot.init({
        tocSelector: ".js-toc",
        contentSelector: ".js-toc-content",
        headingSelector: "h2, h3, h4",
        ignoreSelector: ".media-card h3, h1",
        hasInnerContainers: true,
        headingsOffset: tocOffset,
        scrollSmoothDuration: 300,
        scrollSmoothOffset: -tocOffset,
      });

      const hasTocItem =
        tocContainer.querySelector(".toc-list-item, .toc-link") !== null;
      if (sidebar) {
        sidebar.classList.toggle("toc-empty", !hasTocItem);
        sidebar.setAttribute("aria-hidden", String(!hasTocItem));
      }
    }

    window.__postDetailsCleanup = () => {
      cleanupCallbacks.forEach(cleanup => cleanup());
      tocbot.destroy();
      window.__postDetailsCleanup = undefined;
    };
  }

  if (!window.__postDetailsLifecycleBound) {
    document.addEventListener("astro:page-load", initPostDetails);
    document.addEventListener("astro:before-swap", () => {
      window.__postDetailsCleanup?.();
    });
    window.__postDetailsLifecycleBound = true;
  }

  initPostDetails();
</script>
