---
import Breadcrumb from "@/components/Breadcrumb.astro";
interface StringTitleProp {
  pageTitle: string;
  pageDesc?: string;
  pageDescClass?: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
  titleTransition: string;
  pageDesc?: string;
  pageDescClass?: string;
}

export type Props = StringTitleProp | ArrayTitleProp;

const { props } = Astro;
---

<Breadcrumb />
<main id="main-content" class="mx-auto mt-6 w-full max-w-app px-4 pb-8">
  <header class="mb-7" aria-labelledby="page-heading">
    {
      "titleTransition" in props ? (
        <h1 id="page-heading" class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
          {props.pageTitle[0]}
          <span transition:name={props.titleTransition}>
            {props.pageTitle[1]}
          </span>
        </h1>
      ) : (
        <h1 id="page-heading" class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
          {props.pageTitle}
        </h1>
      )
    }
    {
      props.pageDesc ? (
        <p class:list={["mt-2 text-sm leading-7 text-foreground/75 sm:text-base", props.pageDescClass]}>
          {props.pageDesc}
        </p>
      ) : null
    }
    <slot name="header-extra" />
  </header>
  <slot />
</main>
