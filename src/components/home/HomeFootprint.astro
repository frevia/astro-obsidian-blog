---
import type { CollectionEntry } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { toPlaceRecords } from "@/utils/footprintPlaces";
import { getPath } from "@/utils/getPath";
import CardCoverImage from "@/components/CardCoverImage.astro";
import { withBase } from "@/utils/withBase";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const posts = getSortedPosts(Astro.props.posts).filter(
  post => toPlaceRecords(post).length > 0
);
const places = [
  ...new Map(
    posts
      .flatMap(toPlaceRecords)
      .map(place => [`${place.name}:${place.lng},${place.lat}`, place])
  ).values(),
];
const latest = posts[0];
const latestPlace = latest ? toPlaceRecords(latest)[0] : undefined;
const pinPath = "M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z";
---

{
  latest && (
    <section class="home-section" aria-labelledby="home-footprint-heading">
      <header class="home-section-heading">
        <h2 id="home-footprint-heading">足迹</h2>
        <a
          href={withBase("/footprint")}
          data-astro-prefetch="hover"
          class="home-section-link"
        >
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18-6 3V6l6-3 6 3 6-3v15l-6 3-6-3ZM9 3v15M15 6v15" />
          </svg>
          查看足迹地图
        </a>
      </header>
      <div class="footprint-panel">
        <a
          href={getPath(latest.id, latest.filePath)}
          data-astro-prefetch="hover"
          class:list={[
            "footprint-story",
            { "has-photo": Boolean(latest.data.cover) },
          ]}
        >
          {latest.data.cover && (
            <figure class="footprint-print">
              <CardCoverImage
                src={latest.data.cover}
                alt={latest.data.title}
                width={960}
                height={720}
                preserveAspect
                sizes="(min-width: 900px) 430px, (min-width: 640px) 52vw, 100vw"
                loading="lazy"
                class="footprint-photo"
              />
              <figcaption>{latestPlace?.name ?? "旅途一帧"}</figcaption>
            </figure>
          )}
          <div class="footprint-copy">
            {latestPlace && (
              <span class="footprint-location">
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={pinPath} />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                {latestPlace.name}
              </span>
            )}
            <p class="footprint-meta">
              最近的记录 ·{" "}
              <time datetime={latest.data.published.toISOString()}>
                {latest.data.published.toISOString().slice(0, 10)}
              </time>
            </p>
            <h3>{latest.data.title}</h3>
            {latest.data.description && (
              <p class="footprint-description">{latest.data.description}</p>
            )}
            <span class="footprint-read">阅读这段旅程</span>
          </div>
        </a>
        <div class="footprint-footer">
          <p class="footprint-count">
            <strong>{places.length}</strong> 个地点
            <>
              <span aria-hidden="true">/</span>
              <strong>{posts.length}</strong>
            </>{" "}
            篇记录
          </p>
          <ul class="footprint-places" aria-label="最近记录的地点">
            {places.slice(0, 5).map(place => (
              <li>
                <svg
                  aria-hidden="true"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={pinPath} />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                {place.name}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}
<style>
  .footprint-panel {
    border-block: 1px solid var(--border);
  }
  .footprint-story {
    display: grid;
    text-decoration: none;
    gap: 1rem;
    align-items: center;
    padding: 1.75rem 0 1.25rem;
  }
  .footprint-story:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }
  .footprint-print {
    position: relative;
    min-width: 0;
    margin: 0;
    padding: 0.5rem 0.5rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgb(0 0 0 / 5%);
  }
  .footprint-print::before {
    content: "";
    position: absolute;
    top: -0.6rem;
    left: 1.5rem;
    width: 3.5rem;
    height: 1.2rem;
    background: color-mix(in oklab, var(--foreground-muted) 18%, transparent);
    transform: rotate(-7deg);
    pointer-events: none;
    z-index: 1;
  }
  .footprint-story :global(.footprint-photo) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 20rem;
    object-fit: contain;
    border-radius: 0;
  }
  .footprint-print figcaption {
    padding: 0.65rem 0.25rem 0;
    color: var(--foreground-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .footprint-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.5rem 0;
    min-width: 0;
  }
  .footprint-meta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }
  .footprint-copy h3 {
    margin-top: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.7;
    color: var(--foreground);
  }
  .footprint-description {
    margin-top: 0.75rem;
    color: var(--foreground-muted);
    font-size: 0.9rem;
    line-height: 1.85;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .footprint-story:hover h3 {
    color: var(--accent-strong);
  }
  .home-section-link {
    gap: 0.5rem;
  }
  .footprint-location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    color: var(--accent-strong);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .footprint-read {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--foreground-muted);
    text-underline-offset: 0.25em;
  }
  .footprint-story:hover .footprint-read {
    text-decoration: underline;
    color: var(--accent-strong);
  }
  .footprint-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--border);
  }
  .footprint-count {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }
  .footprint-count strong {
    font-size: 1rem;
    font-weight: 600;
    color: var(--foreground);
    font-variant-numeric: tabular-nums;
  }
  .footprint-count > span {
    margin: 0 0.4rem;
    color: var(--border-strong);
  }
  .footprint-places {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }
  .footprint-places li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .footprint-places svg {
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .footprint-story.has-photo {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
      gap: 2rem;
    }
    .footprint-story :global(.footprint-photo) {
      max-height: 18rem;
    }
  }
</style>
