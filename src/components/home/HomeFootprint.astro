---
import type { CollectionEntry } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { toPlaceRecords } from "@/utils/footprintPlaces";
import { getPath } from "@/utils/getPath";
import CardCoverImage from "@/components/CardCoverImage.astro";
import { withBase } from "@/utils/withBase";
import {
  formatEventPeriod,
  getEventPeriod,
  publicationDay,
} from "@/utils/contentDates";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const posts = getSortedPosts(Astro.props.posts).filter(
  post => toPlaceRecords(post).length > 0
);
const places = [
  ...new Map(
    posts
      .flatMap(toPlaceRecords)
      .map(place => [`${place.name}:${place.lng},${place.lat}`, place])
  ).values(),
];
const latest = posts[0];
const latestPlace = latest ? toPlaceRecords(latest)[0] : undefined;
const latestEvent = latest ? getEventPeriod(latest.data) : undefined;
const latestPublishedDay = latest
  ? publicationDay(latest.data.published, latest.data.timezone)
  : undefined;
const pinPath = "M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z";
---

{
  latest && (
    <section class="home-section" aria-labelledby="home-footprint-heading">
      <header class="home-section-heading">
        <h2 id="home-footprint-heading">足迹</h2>
        <a
          href={withBase("/footprint")}
          data-astro-prefetch="hover"
          class="home-section-link"
        >
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18-6 3V6l6-3 6 3 6-3v15l-6 3-6-3ZM9 3v15M15 6v15" />
          </svg>
          查看足迹地图
        </a>
      </header>
      <div class="footprint-panel">
        <a
          href={getPath(latest.id, latest.filePath)}
          data-astro-prefetch="hover"
          class:list={[
            "footprint-story",
            { "has-photo": Boolean(latest.data.cover) },
          ]}
        >
          {latest.data.cover && (
            <figure class="footprint-print">
              <svg
                class="footprint-cord"
                aria-hidden="true"
                viewBox="0 0 440 36"
                preserveAspectRatio="none"
                fill="none"
              >
                <path d="M-10 5 Q220 40 450 5" />
              </svg>
              <span class="footprint-peg" aria-hidden="true" />
              <CardCoverImage
                src={latest.data.cover}
                alt={latest.data.title}
                width={960}
                height={720}
                preserveAspect
                sizes="(min-width: 900px) 340px, (min-width: 640px) 42vw, calc(100vw - 80px)"
                loading="lazy"
                class="footprint-photo"
              />
            </figure>
          )}
          <div class="footprint-copy">
            <div class="footprint-details">
              {latestPlace && (
                <span class="footprint-location">
                  <svg
                    aria-hidden="true"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={pinPath} />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  {latestPlace.name}
                </span>
              )}
              <p class="footprint-meta">
                {latestEvent && (
                  <span>发生于 {formatEventPeriod(latestEvent)} · </span>
                )}
                <time datetime={latestPublishedDay}>
                  发布于 {latestPublishedDay}
                </time>
              </p>
            </div>
            <h3>{latest.data.title}</h3>
            {latest.data.description && (
              <p class="footprint-description">{latest.data.description}</p>
            )}
            <span class="footprint-read">阅读这段旅程</span>
          </div>
        </a>
        <div class="footprint-footer">
          <p class="footprint-count">
            <strong>{places.length}</strong> 个地点
            <>
              <span aria-hidden="true">/</span>
              <strong>{posts.length}</strong>
            </>{" "}
            篇记录
          </p>
          <ul class="footprint-places" aria-label="最近记录的地点">
            {places
              .filter(
                place =>
                  !(
                    place.name === latestPlace?.name &&
                    place.lng === latestPlace?.lng &&
                    place.lat === latestPlace?.lat
                  )
              )
              .slice(0, 5)
              .map(place => (
                <li>
                  <svg
                    aria-hidden="true"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={pinPath} />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  {place.name}
                </li>
              ))}
          </ul>
        </div>
      </div>
    </section>
  )
}
<style>
  .footprint-panel {
    border-block: 1px solid var(--border);
  }
  .footprint-story {
    display: grid;
    text-decoration: none;
    gap: 1rem;
    align-items: center;
    padding: 3rem 0.25rem 1.5rem;
  }
  .footprint-story:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }
  .footprint-print {
    position: relative;
    min-width: 0;
    width: calc(100% - 1.5rem);
    max-width: 22rem;
    justify-self: center;
    margin: 0;
    padding: 0.75rem 0.75rem 0.9rem;
    background: linear-gradient(
      135deg,
      var(--surface-elevated),
      var(--surface)
    );
    border: 1px solid
      color-mix(in oklab, var(--foreground-muted) 32%, var(--surface));
    border-radius: 2px;
    transform: rotate(-0.9deg);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 6%),
      0 6px 12px -8px rgb(0 0 0 / 18%),
      0 16px 24px -20px rgb(0 0 0 / 22%),
      inset 0 0 0 1px rgb(255 255 255 / 12%);
  }
  .footprint-cord {
    position: absolute;
    top: -2.6rem;
    left: -0.25rem;
    width: calc(100% + 0.5rem);
    height: 2.25rem;
    overflow: visible;
    pointer-events: none;
    transform: rotate(0.9deg);
    filter: drop-shadow(0 1px 1px rgb(65 41 19 / 16%));
  }
  .footprint-cord path {
    stroke: #b49a72;
    stroke-width: 1.3;
    vector-effect: non-scaling-stroke;
  }
  .footprint-peg {
    position: absolute;
    top: -1.65rem;
    left: 50%;
    width: 0.65rem;
    height: 2.15rem;
    border: 1px solid #b68d59;
    border-radius: 2px;
    background: repeating-linear-gradient(
      88deg,
      #dfbd87 0px,
      #f0d3a1 2px,
      #e7c591 4px
    );
    box-shadow:
      inset 1px 0 rgb(255 255 255 / 50%),
      2px 3px 3px rgb(52 35 19 / 24%);
    transform: translateX(-50%) rotate(8deg);
    pointer-events: none;
    z-index: 2;
  }
  .footprint-peg::after {
    content: "";
    position: absolute;
    top: 55%;
    left: -2px;
    width: calc(100% + 4px);
    height: 4px;
    border-block: 1px solid #84745e;
    border-radius: 1px;
    background: #b8aa91;
    box-shadow: 0 1px 1px rgb(0 0 0 / 12%);
  }
  .footprint-story :global(.footprint-photo) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 20rem;
    object-fit: contain;
    border: 1px solid
      color-mix(in oklab, var(--foreground-muted) 24%, var(--surface));
    border-radius: 0;
  }
  .footprint-details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .footprint-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.5rem 0;
    min-width: 0;
  }
  .footprint-meta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }
  .footprint-copy h3 {
    margin-top: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.7;
    color: var(--foreground);
  }
  .footprint-description {
    margin-top: 0.75rem;
    color: var(--foreground-muted);
    font-size: 0.9rem;
    line-height: 1.85;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .footprint-story:hover h3 {
    color: var(--accent-strong);
  }
  .home-section-link {
    gap: 0.5rem;
  }
  .footprint-location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0;
    color: var(--accent-strong);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
  }
  .footprint-read {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--foreground-muted);
    text-underline-offset: 0.25em;
  }
  .footprint-story:hover .footprint-read {
    text-decoration: underline;
    color: var(--accent-strong);
  }
  .footprint-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--border);
  }
  .footprint-count {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }
  .footprint-count strong {
    font-size: 1rem;
    font-weight: 600;
    color: var(--foreground);
    font-variant-numeric: tabular-nums;
  }
  .footprint-count > span {
    margin: 0 0.4rem;
    color: var(--border-strong);
  }
  .footprint-places {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }
  .footprint-places li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .footprint-places svg {
    flex-shrink: 0;
  }
  @media (max-width: 639px) {
    .footprint-story {
      gap: 1.25rem;
      padding-bottom: 1rem;
    }
    .footprint-copy {
      padding: 0;
    }
    .footprint-copy h3,
    .footprint-description,
    .footprint-read {
      margin-top: 0.5rem;
    }
    .footprint-footer {
      gap: 0.5rem 1rem;
    }
  }
  @media (min-width: 640px) {
    .footprint-story.has-photo {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: 2rem;
    }
    .footprint-print {
      width: 100%;
    }
    .footprint-story :global(.footprint-photo) {
      max-height: 18rem;
    }
  }
</style>
