---
import type { CollectionEntry } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { toPlaceRecords } from "@/utils/footprintPlaces";
import { getPath } from "@/utils/getPath";
import { withBase } from "@/utils/withBase";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const posts = getSortedPosts(Astro.props.posts).filter(
  post => toPlaceRecords(post).length > 0
);
const places = [
  ...new Map(
    posts
      .flatMap(toPlaceRecords)
      .map(place => [`${place.name}:${place.lng},${place.lat}`, place])
  ).values(),
];
const latest = posts[0];
---

{
  latest && (
    <section class="mb-6" aria-labelledby="home-footprint-heading">
      <header class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-semibold tracking-[0.22em] text-accent">
            走过的地方
          </p>
          <h2
            id="home-footprint-heading"
            class="mt-1 text-2xl font-semibold tracking-tight text-foreground"
          >
            足迹
          </h2>
        </div>
        <a
          href={withBase("/footprint")}
          data-astro-prefetch="hover"
          class="inline-flex min-h-11 items-center rounded-md px-2 text-sm font-medium text-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          查看足迹地图
        </a>
      </header>
      <div class="grid overflow-hidden rounded-[var(--radius-card)] border border-border bg-surface sm:grid-cols-2">
        <div class="p-6 sm:p-8">
          <p class="text-sm text-foreground-muted">
            <strong class="text-2xl font-semibold text-foreground">
              {places.length}
            </strong>{" "}
            个地点
            <span class="mx-3 text-border" aria-hidden="true">
              /
            </span>
            <strong class="text-2xl font-semibold text-foreground">
              {posts.length}
            </strong>{" "}
            篇记录
          </p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="最近记录的地点">
            {places.slice(0, 5).map(place => (
              <li class="rounded-full border border-border px-3 py-1.5 text-sm text-foreground-muted">
                {place.name}
              </li>
            ))}
          </ul>
        </div>
        <a
          href={getPath(latest.id, latest.filePath)}
          data-astro-prefetch="hover"
          class="group flex min-w-0 flex-col justify-center border-t border-border p-6 no-underline hover:bg-accent/5 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-accent sm:border-t-0 sm:border-l sm:p-8"
        >
          <span class="text-xs text-foreground-muted">
            最近的记录 ·{" "}
            <time datetime={latest.data.published.toISOString()}>
              {latest.data.published.toISOString().slice(0, 10)}
            </time>
          </span>
          <h3 class="mt-3 text-lg leading-8 font-semibold text-foreground group-hover:text-accent">
            {latest.data.title}
          </h3>
          <span class="mt-4 text-sm font-medium text-accent">阅读这段旅程</span>
        </a>
      </div>
    </section>
  )
}
