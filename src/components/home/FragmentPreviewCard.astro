---
import type { HomeFragmentPreview } from "./fragmentPreviews";

interface Props {
  preview: HomeFragmentPreview;
}

const { preview } = Astro.props;
---

<li data-content-kind={preview.kind} class="note-preview">
  <a
    href={preview.href}
    data-astro-prefetch="tap"
    class="note-preview-link focus-visible:outline-2 focus-visible:outline-accent"
  >
    <time class="note-date" datetime={`${preview.date}T${preview.time}`}>
      <span class="note-month">{preview.date.slice(5).replace("-", "/")}</span>
      <span class="note-year">{preview.date.slice(0, 4)}</span>
    </time>
    <span class="note-marker" aria-hidden="true"></span>
    <div class="note-content">
      <div class="note-meta">
        <span>{preview.time}</span>{
          preview.mediaLabel && <span>{preview.mediaLabel}</span>
        }
      </div>
      <div class="note-body">
        <p class="note-excerpt line-clamp-3">{preview.excerpt}</p>
        {
          preview.image && (
            <img
              src={preview.image.src}
              alt={preview.image.alt || "Notes 配图"}
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
              class="note-thumbnail"
            />
          )
        }
      </div>
    </div>
  </a>
</li>
<style>
  .note-preview {
    position: relative;
    min-width: 0;
  }
  .note-preview:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 1.1rem;
    bottom: -1.1rem;
    left: 6.25rem;
    width: 1px;
    background: var(--border);
    pointer-events: none;
  }
  .note-preview-link {
    display: grid;
    grid-template-columns: 5rem 1px minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
    padding: 0.5rem 0 1.5rem;
    text-decoration: none;
    outline-offset: 4px;
  }
  .note-date {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-variant-numeric: tabular-nums;
  }
  .note-month {
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--foreground);
  }
  .note-year,
  .note-meta {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }
  .note-marker {
    position: relative;
    z-index: 1;
    width: 0.5rem;
    height: 0.5rem;
    margin-left: -0.21875rem;
    margin-top: 0.6rem;
    border: 1px solid var(--accent-strong);
    border-radius: 50%;
    background: var(--background);
  }
  .note-preview-link:hover .note-marker {
    background: var(--accent-strong);
  }
  .note-content {
    min-width: 0;
  }
  .note-meta {
    display: flex;
    gap: 0.75rem;
    line-height: 1.75;
  }
  .note-body {
    display: flex;
    align-items: start;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .note-excerpt {
    flex: 1;
    min-width: 0;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--foreground);
    transition: color 0.2s;
  }
  .note-preview-link:hover .note-excerpt {
    color: var(--accent-strong);
  }
  .note-thumbnail {
    width: 5rem;
    height: auto;
    max-height: 7rem;
    flex-shrink: 0;
    border-radius: 0.5rem;
    object-fit: contain;
  }
  .note-preview:last-child .note-preview-link {
    padding-bottom: 0;
  }
  @media (max-width: 480px) {
    .note-preview-link {
      grid-template-columns: 3.5rem 1px minmax(0, 1fr);
      gap: 0.75rem;
    }
    .note-preview:not(:last-child)::after {
      left: 4.25rem;
    }
    .note-month {
      font-size: 1.05rem;
    }
    .note-body {
      gap: 0.75rem;
    }
    .note-thumbnail {
      width: 3rem;
      height: auto;
      max-height: 4.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .note-excerpt {
      transition: none;
    }
  }
</style>
