---
import type { HomeFragmentPreview } from "./fragmentPreviews";

interface Props {
  preview: HomeFragmentPreview;
  index: number;
}

const { preview, index } = Astro.props;
const dateLabel = preview.date.replace(/-/g, ".");
---

<li
  data-content-kind={preview.kind}
  style={preview.style}
  class:list={[
    "min-w-0",
    { "sm:mt-8": index % 2 === 1, "sm:mb-8": index % 2 === 0 },
  ]}
>
  <a
    href={preview.href}
    class="group relative isolate flex h-full min-h-48 flex-col overflow-hidden rounded-2xl border border-border/65 bg-surface px-4 py-4 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-accent/55 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-10 -right-8 -z-10 h-32 w-32 rounded-full bg-[var(--content-accent-soft)] opacity-[var(--content-image-opacity)] blur-2xl"
    ></span>
    {
      preview.image && (
        <div class="mb-4 aspect-[16/9] overflow-hidden rounded-xl border border-border/50 bg-muted/15">
          <img
            src={preview.image.src}
            alt={preview.image.alt}
            width="480"
            height="270"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
          />
        </div>
      )
    }
    <div
      class="flex items-center justify-between gap-3 text-xs tracking-wide text-foreground/55 tabular-nums"
    >
      <span>{preview.mediaLabel ?? "碎片"}</span>
      <time datetime={`${preview.date}T${preview.time}`}>
        {dateLabel} · {preview.time}
      </time>
    </div>
    <p class="mt-3 text-base leading-7 text-foreground/88">
      {preview.excerpt}
    </p>
    <span class="mt-auto pt-4 text-sm font-medium text-accent">
      回到时间线 <span aria-hidden="true">↘</span>
    </span>
  </a>
</li>
