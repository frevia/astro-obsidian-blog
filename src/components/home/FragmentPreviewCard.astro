---
import type { HomeFragmentPreview } from "./fragmentPreviews";

interface Props {
  preview: HomeFragmentPreview;
}

const { preview } = Astro.props;
const dateLabel = preview.date.replace(/-/g, ".");
---

<li data-content-kind={preview.kind} style={preview.style} class="min-w-0">
  <a
    href={preview.href}
    data-astro-prefetch="tap"
    class="app-card home-lift-card group relative isolate flex h-full min-h-72 flex-col overflow-hidden rounded-[var(--radius-card)] px-4 py-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:min-h-80"
  >
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-10 -right-8 -z-10 h-32 w-32 rounded-full bg-[var(--content-accent-soft)] opacity-[var(--content-image-opacity)] blur-2xl"
    ></span>
    {
      preview.image && (
        <div class="mb-4 aspect-[16/9] overflow-hidden rounded-xl border border-border/50 bg-muted/15">
          <img
            src={preview.image.src}
            alt={preview.image.alt}
            width="480"
            height="270"
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
            loading="lazy"
            decoding="async"
            class="app-card-media h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
          />
        </div>
      )
    }
    <div
      class="flex items-center justify-between gap-3 text-xs tracking-wide text-foreground/55 tabular-nums"
    >
      <span>{preview.mediaLabel ?? "Notes"}</span>
      <time datetime={`${preview.date}T${preview.time}`}>
        {dateLabel} · {preview.time}
      </time>
    </div>
    <p class="mt-3 line-clamp-4 text-base leading-7 text-foreground/88">
      {preview.excerpt}
    </p>
    <span class="mt-auto pt-4 text-sm font-medium text-accent">
      查看这条 Notes <span aria-hidden="true">↘</span>
    </span>
  </a>
</li>
