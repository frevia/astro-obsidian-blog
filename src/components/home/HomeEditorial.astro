---
import type { CollectionEntry } from "astro:content";
import Card from "@/components/Card.astro";
import { withBase } from "@/utils/withBase";
import FragmentPreviewCard from "./FragmentPreviewCard.astro";
import type { HomeFragmentPreview } from "./fragmentPreviews";
import type { WikiCatalogItem } from "@/utils/wikiCatalog";

interface Props {
  featuredPost?: CollectionEntry<"blog">;
  fragments?: HomeFragmentPreview[];
  wikiHighlights?: WikiCatalogItem[];
}

const { featuredPost, fragments = [], wikiHighlights = [] } = Astro.props;
---

{
  (featuredPost || fragments.length > 0 || wikiHighlights.length > 0) && (
    <>
      {(featuredPost || fragments.length > 0) && (
        <section
          class="mb-12 border-b border-border/50 pb-10"
          aria-labelledby="home-editorial-heading"
        >
          <header class="mb-5 flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-xs font-semibold tracking-[0.22em] text-accent uppercase">
                最近写下
              </p>
              <h2
                id="home-editorial-heading"
                class="mt-1 text-2xl font-semibold tracking-tight text-foreground"
              >
                文章与 Notes
              </h2>
            </div>
            <div class="flex flex-wrap items-center gap-1">
              <a
                href={withBase("/posts")}
                data-astro-prefetch="hover"
                class="rounded-md px-2 py-1 text-sm font-medium text-accent hover:underline"
              >
                看全部文章 <span aria-hidden="true">↗</span>
              </a>
              <a
                href={withBase("/notes")}
                data-astro-prefetch="hover"
                class="rounded-md px-2 py-1 text-sm font-medium text-accent hover:underline"
              >
                查看全部 Notes <span aria-hidden="true">↗</span>
              </a>
            </div>
          </header>

          {featuredPost && (
            <ul class="mb-6" aria-label="最新精选文章">
              <Card {...featuredPost} presentation="featured" variant="h3" />
            </ul>
          )}

          {fragments.length > 0 && (
            <ol
              class="grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-3"
              aria-label="近期 Notes 预览"
            >
              {fragments.map(preview => (
                <FragmentPreviewCard {preview} />
              ))}
            </ol>
          )}
        </section>
      )}

      {wikiHighlights.length > 0 && (
        <section
          class="home-wiki-editorial mb-12 border-b border-border/50 pb-10"
          aria-labelledby="home-wiki-heading"
        >
          <header class="mb-5 flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-xs font-semibold tracking-[0.22em] text-accent uppercase">
                持续积累
              </p>
              <h2
                id="home-wiki-heading"
                class="mt-1 text-2xl font-semibold tracking-tight text-foreground"
              >
                知识库
              </h2>
            </div>
            <a
              href={withBase("/wiki")}
              data-astro-prefetch="hover"
              class="rounded-md px-2 py-1 text-sm font-medium text-accent hover:underline"
            >
              浏览全部知识 <span aria-hidden="true">↗</span>
            </a>
          </header>

          <ul class="grid gap-3 sm:grid-cols-3" aria-label="精选知识概念">
            {wikiHighlights.map(item => (
              <li class="min-w-0">
                <a
                  href={item.href}
                  data-astro-prefetch="hover"
                  class="home-lift-card group flex h-full min-h-36 flex-col rounded-[var(--radius-card)] border border-border bg-surface p-5 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                  <span class="text-xs text-foreground-muted">
                    {item.domain.label}
                  </span>
                  <h3 class="mt-3 text-base leading-7 font-semibold text-foreground group-hover:text-accent">
                    {item.title}
                  </h3>
                  <span
                    class="mt-auto self-end pt-3 text-accent"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </>
  )
}
