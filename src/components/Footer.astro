---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { getSiteYear } from "@/utils/calendarDate";

const currentYear = getSiteYear(new Date());

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="mx-auto flex w-full max-w-app flex-col items-center justify-between gap-3 px-4 py-7 text-foreground/78 sm:flex-row-reverse sm:gap-4 sm:py-5"
  >
    <div class="flex flex-col items-center gap-1.5 sm:flex-row">
      <span class="italic text-foreground/70">联系我<span class="hidden sm:inline">：</span></span>
      <Socials centered />
    </div>
    <div class="my-1 flex flex-col items-center whitespace-nowrap text-sm sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>Frevia</span>
    </div>
  </div>
</footer>
