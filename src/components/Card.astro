---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";
import Datetime from "./Datetime.astro";
import { Image } from "astro:assets";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  itemClass?: string;
  hidden?: boolean;
}

const { variant = "h2", itemClass, hidden, data, id, filePath } = Astro.props;

const { title, description, published, timezone } = data;

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class:
    "text-lg font-semibold leading-7 text-foreground transition-colors group-hover:text-accent group-focus-visible:text-accent",
};

const fallbackCover = SITE.dynamicOgImage
  ? `${getPath(id, filePath)}/cover.png`
  : undefined;
const cardCover = data.cover ?? fallbackCover;
---

<li class:list={["my-5", itemClass]} hidden={hidden}>
  <a
    href={getPath(id, filePath)}
    class="group block rounded-xl border border-border/70 bg-background px-4 py-4 transition-colors hover:border-accent/55 hover:bg-accent/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-start sm:gap-4">
      <div
        class="hidden h-[88px] w-[88px] shrink-0 overflow-hidden rounded-lg border border-border/60 sm:block"
      >
        {
          cardCover &&
            (typeof cardCover === "string" ? (
              <Image
                src={cardCover}
                alt={title}
                width={88}
                height={88}
                class="h-full w-full object-cover"
              />
            ) : (
              <Image
                src={cardCover}
                alt={title}
                width={88}
                height={88}
                format="webp"
                quality={80}
                class="h-full w-full object-cover"
              />
            ))
        }
      </div>

      <div class="min-w-0 flex-1">
        {
          variant === "h2" ? (
            <h2 {...headerProps}>{title}</h2>
          ) : (
            <h3 {...headerProps}>{title}</h3>
          )
        }
        <Datetime
          {published}
          {timezone}
          layout="meta"
          compact
          class="mt-1 text-xs text-foreground/65"
        />
        <p class="mt-2 text-sm leading-7 text-foreground/80">{description}</p>
      </div>
    </div>
  </a>
</li>
