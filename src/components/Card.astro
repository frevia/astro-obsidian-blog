---
import { toTransitionName } from "@/utils/toTransitionName";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";
import Datetime from "./Datetime.astro";
import { toYMDInTimeZone } from "@/utils/calendarDate";
import { getAssetPath } from "@/utils/withBase";
import CardCoverImage from "./CardCoverImage.astro";
import {
  contentKindStyle,
  inferPostContentKind,
  type ContentKind,
} from "@/components/post-list/contentPresentation";
import { classifyCoverOrientation } from "@/components/post-list/coverPresentation";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  itemClass?: string;
  hidden?: boolean;
  presentation?: "standard" | "editorial" | "featured";
  mediaAlign?: "start" | "end";
}

const {
  variant = "h2",
  itemClass,
  hidden,
  presentation = "standard",
  mediaAlign = "start",
  data,
  id,
  filePath,
  body,
} = Astro.props;

const { title, description, published, timezone } = data;
const isStandard = presentation === "standard";
const isFeatured = presentation === "featured";
const isEditorial = presentation === "editorial";
const inferredKind = inferPostContentKind({ data, body });
const contentKind: ContentKind = isFeatured ? "featured" : inferredKind;
const contentKindLabel: Record<ContentKind, string> = {
  text: "文字",
  media: "媒体",
  image: "图像",
  featured: "精选",
};
const titleTransitionName = toTransitionName(title);
const coverTransitionName = `${titleTransitionName}-cover`;

const fallbackCover = SITE.dynamicOgImage
  ? `${getPath(id, filePath)}/cover.png`
  : undefined;
const defaultCover = SITE.cover
  ? getAssetPath(`/${SITE.cover}`)
  : getAssetPath("/og.png");
const hasAuthoredCover = Boolean(data.cover);
const cardCover = isStandard
  ? (data.cover ?? fallbackCover ?? defaultCover)
  : isEditorial
    ? data.cover
    : (data.cover ?? fallbackCover);
const coverOrientation = !isStandard
  ? classifyCoverOrientation(data.cover)
  : "unknown";

const editorialCoverWidth =
  coverOrientation === "portrait"
    ? 320
    : coverOrientation === "landscape"
      ? 640
      : 400;
const editorialCoverHeight =
  coverOrientation === "portrait"
    ? 450
    : coverOrientation === "landscape"
      ? 360
      : 400;
const coverWidth = isFeatured ? 720 : isStandard ? 88 : editorialCoverWidth;
const coverHeight = isFeatured ? 405 : isStandard ? 88 : editorialCoverHeight;
const editorialCoverSizes =
  coverOrientation === "portrait"
    ? "(min-width: 640px) 160px, 80px"
    : coverOrientation === "balanced"
      ? "(min-width: 640px) 160px, 88px"
      : "(min-width: 640px) 160px, 112px";
const coverSizes = isStandard
  ? "(min-width: 640px) 88px, 56px"
  : isFeatured
    ? coverOrientation === "portrait"
      ? "(min-width: 640px) 176px, 144px"
      : "(min-width: 640px) 52vw, 100vw"
    : editorialCoverSizes;
const titleClass = isStandard
  ? "text-lg font-semibold leading-7"
  : isFeatured
    ? "text-2xl font-semibold leading-tight sm:text-3xl"
    : "text-lg font-semibold leading-snug sm:text-xl";
---

<li
  data-content-kind={contentKind}
  data-cover-orientation={!isStandard ? coverOrientation : undefined}
  data-transition-title={titleTransitionName}
  data-transition-cover={coverTransitionName}
  style={contentKindStyle(contentKind)}
  class:list={[isStandard ? "my-5" : "my-0", itemClass]}
  hidden={hidden}
>
  <a
    href={getPath(id, filePath)}
    data-astro-prefetch={isFeatured ? "viewport" : "tap"}
    class:list={[
      "app-card group relative isolate block overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
      isStandard
        ? "rounded-[var(--radius-card)] px-4 py-4 hover:border-accent/55"
        : isEditorial
          ? "post-card-editorial rounded-[var(--radius-card-emphasis)] px-4 py-4"
          : "home-lift-card rounded-[var(--radius-card-emphasis)] px-4 py-4 sm:px-5 sm:py-5",
    ]}
  >
    {
      isFeatured && (
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -top-16 -right-10 -z-10 h-48 w-48 rounded-full bg-[var(--content-accent-soft)] opacity-[var(--content-image-opacity)] blur-3xl"
        />
      )
    }

    <div
      class:list={[
        isEditorial ? "post-card-layout" : "flex min-w-0 gap-4",
        {
          "home-featured-layout": isFeatured,
          "flex-col sm:flex-row sm:items-start sm:gap-4": isStandard,
          "flex-col sm:flex-row sm:items-center sm:gap-6":
            isFeatured && Boolean(cardCover) && mediaAlign === "start",
          "flex-col sm:flex-row-reverse sm:items-center sm:gap-6":
            isFeatured && Boolean(cardCover) && mediaAlign === "end",
        },
      ]}
    >
      {
        cardCover && (
          <div
            transition:name={coverTransitionName}
            class:list={[
              "relative shrink-0 overflow-hidden",
              {
                "post-card-cover-frame": isEditorial,
                "home-featured-cover": isFeatured,
                "border border-border/60 bg-muted/15": isStandard,
              },
              isStandard
                ? "block h-14 w-14 rounded-lg sm:h-[88px] sm:w-[88px]"
                : isFeatured
                  ? coverOrientation === "portrait"
                    ? "w-36 self-center rounded-xl sm:w-44"
                    : "aspect-video w-full rounded-xl sm:w-[52%]"
                  : "post-card-thumbnail",
            ]}
          >
            {!isStandard ? (
              <>
                <CardCoverImage
                  src={cardCover}
                  alt={title}
                  width={coverWidth}
                  height={coverHeight}
                  sizes={coverSizes}
                  loading={isFeatured ? "eager" : "lazy"}
                  preserveAspect={hasAuthoredCover}
                  fit="contain"
                  style={
                    isEditorial || coverOrientation === "portrait"
                      ? undefined
                      : "height: 100%;"
                  }
                  class={
                    isEditorial || coverOrientation === "portrait"
                      ? "app-card-media post-card-cover-image relative z-10 block object-contain transition duration-500"
                      : "app-card-media relative z-10 block h-full w-full object-contain transition duration-500"
                  }
                />
              </>
            ) : (
              <CardCoverImage
                src={cardCover}
                alt={title}
                width={coverWidth}
                height={coverHeight}
                sizes={coverSizes}
                loading={isFeatured ? "eager" : "lazy"}
                fit="cover"
                style="height: 100%;"
                class="app-card-media h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]"
              />
            )}
          </div>
        )
      }

      <div
        class:list={[
          isEditorial ? "post-card-copy" : "min-w-0 flex-1",
          {
            "home-featured-copy": isFeatured,
            "flex flex-col justify-center py-1 sm:py-3": isFeatured,
          },
        ]}
      >
        {
          isFeatured && (
            <div class="mb-3 flex flex-wrap items-center gap-2 text-xs tracking-wide text-foreground/55">
              <span class="font-semibold text-accent uppercase">
                {contentKindLabel[contentKind]}
              </span>
              {data.tags.slice(0, 2).map(tag => (
                <span class="app-chip">{tag}</span>
              ))}
            </div>
          )
        }
        {
          variant === "h2" ? (
            <h2
              transition:name={titleTransitionName}
              class:list={[
                titleClass,
                isFeatured
                  ? "text-foreground"
                  : "text-foreground transition-colors group-hover:text-accent group-focus-visible:text-accent",
                { "post-card-title": isEditorial },
              ]}
            >
              {title}
            </h2>
          ) : (
            <h3
              transition:name={titleTransitionName}
              class:list={[
                titleClass,
                isFeatured
                  ? "text-foreground"
                  : "text-foreground transition-colors group-hover:text-accent group-focus-visible:text-accent",
                { "post-card-title": isEditorial },
              ]}
            >
              {title}
            </h3>
          )
        }
        {
          isEditorial ? (
            <p class="post-card-meta">
              <time datetime={published.toISOString()}>
                {toYMDInTimeZone(published, timezone)}
              </time>
              {data.tags.length > 0 && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{data.tags.slice(0, 2).join(" / ")}</span>
                </>
              )}
            </p>
          ) : (
            <Datetime
              {published}
              {timezone}
              layout="meta"
              compact
              class="mt-1 text-xs text-foreground/65"
            />
          )
        }
        <p
          class:list={[
            "mt-2 text-foreground/80",
            isStandard
              ? "text-sm leading-7"
              : isFeatured
                ? "line-clamp-3 text-sm leading-7 sm:text-base"
                : "post-card-excerpt line-clamp-2 text-sm leading-6",
          ]}
        >
          {description}
        </p>
        {
          isFeatured && (
            <span
              class:list={[
                "inline-flex items-center gap-1 text-sm font-medium text-accent",
                isEditorial ? "mt-2 hidden sm:inline-flex" : "mt-4",
              ]}
            >
              阅读全文
            </span>
          )
        }
      </div>
    </div>
  </a>
</li>

<style>
  .post-card-editorial {
    border-color: var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .post-card-editorial:hover {
    border-color: color-mix(in oklab, var(--content-accent) 52%, var(--border));
    background: var(--interactive-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .post-card-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 1.25rem;
    row-gap: 0.5rem;
    align-items: start;
  }
  .post-card-layout:has(.post-card-thumbnail) {
    grid-template-columns: 160px minmax(0, 1fr);
  }
  .post-card-copy {
    display: grid;
    min-width: 0;
    gap: 0.5rem;
    align-self: center;
  }
  .post-card-title {
    grid-row: 1;
    overflow-wrap: anywhere;
  }
  .post-card-excerpt {
    grid-row: 2;
    margin-top: 0;
  }
  .post-card-meta {
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--foreground-muted);
    overflow-wrap: anywhere;
  }
  .post-card-meta time {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .post-card-layout:has(.post-card-thumbnail) .post-card-copy {
    grid-column: 2;
    grid-row: 1;
  }
  .post-card-thumbnail {
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: center;
  }
  .post-card-thumbnail :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 150px;
    object-fit: contain;
  }
  @media (max-width: 639px) {
    .home-featured-layout:has(.home-featured-cover) {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 0.5rem 1rem;
      align-items: start;
    }
    .home-featured-layout:has(.home-featured-cover) .home-featured-copy {
      display: contents;
    }
    .home-featured-cover {
      grid-column: 1;
      grid-row: 1 / 4;
      width: 88px;
      aspect-ratio: auto;
      align-self: center;
    }
    .home-featured-cover :global(img) {
      max-height: 128px;
      object-fit: contain;
    }
    .home-featured-copy > div {
      grid-column: 2;
      grid-row: 1;
      margin-bottom: 0;
    }
    .home-featured-copy > h2,
    .home-featured-copy > h3 {
      grid-column: 2;
      grid-row: 2;
      font-size: 1.25rem;
      line-height: 1.4;
    }
    .home-featured-copy > :global(.datetime-meta) {
      grid-column: 2;
      grid-row: 3;
      margin-top: 0;
      font-size: 0.75rem;
      line-height: 1.5;
      white-space: normal;
    }
    .home-featured-copy :global(.datetime-meta-part) {
      display: inline;
      white-space: normal;
    }
    .home-featured-copy > p,
    .home-featured-copy > span {
      grid-column: 1 / -1;
      margin-top: 0.5rem;
    }

    .post-card-copy {
      display: contents;
    }
    .post-card-layout:has(.post-card-thumbnail) {
      grid-template-columns: clamp(96px, 29vw, 112px) minmax(0, 1fr);
      column-gap: 1rem;
    }
    [data-cover-orientation="portrait"]
      .post-card-layout:has(.post-card-thumbnail) {
      grid-template-columns: 80px minmax(0, 1fr);
    }
    [data-cover-orientation="balanced"]
      .post-card-layout:has(.post-card-thumbnail) {
      grid-template-columns: 88px minmax(0, 1fr);
    }
    .post-card-layout:has(.post-card-thumbnail) .post-card-title {
      grid-column: 1 / -1;
    }
    .post-card-layout:has(.post-card-thumbnail) .post-card-excerpt,
    .post-card-layout:has(.post-card-thumbnail) .post-card-meta {
      grid-column: 2;
    }
    .post-card-thumbnail {
      grid-column: 1;
      grid-row: 2 / 4;
      align-self: start;
    }
    .post-card-thumbnail :global(img) {
      max-height: 100px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card-editorial:hover {
      transform: none;
    }
  }

  :global(.post-card-cover-image) {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
    animation: none;
    border-radius: 0.55rem;
  }
</style>
