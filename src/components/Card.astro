---
import { toTransitionName } from "@/utils/toTransitionName";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";
import Datetime from "./Datetime.astro";
import { getAssetPath } from "@/utils/withBase";
import CardCoverImage from "./CardCoverImage.astro";
import {
  contentKindStyle,
  inferPostContentKind,
  type ContentKind,
} from "@/components/post-list/contentPresentation";
import { classifyCoverOrientation } from "@/components/post-list/coverPresentation";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  itemClass?: string;
  hidden?: boolean;
  presentation?: "standard" | "editorial" | "featured";
  mediaAlign?: "start" | "end";
}

const {
  variant = "h2",
  itemClass,
  hidden,
  presentation = "standard",
  mediaAlign = "start",
  data,
  id,
  filePath,
  body,
} = Astro.props;

const { title, description, published, timezone } = data;
const isStandard = presentation === "standard";
const isFeatured = presentation === "featured";
const isEditorial = presentation === "editorial";
const inferredKind = inferPostContentKind({ data, body });
const contentKind: ContentKind = isFeatured ? "featured" : inferredKind;
const contentKindLabel: Record<ContentKind, string> = {
  text: "文字",
  media: "媒体",
  image: "图像",
  featured: "精选",
};
const titleTransitionName = toTransitionName(title);
const coverTransitionName = `${titleTransitionName}-cover`;

const fallbackCover = SITE.dynamicOgImage
  ? `${getPath(id, filePath)}/cover.png`
  : undefined;
const defaultCover = SITE.cover
  ? getAssetPath(`/${SITE.cover}`)
  : getAssetPath("/og.png");
const hasAuthoredCover = Boolean(data.cover);
const cardCover = isStandard
  ? (data.cover ?? fallbackCover ?? defaultCover)
  : (data.cover ?? fallbackCover);
const coverOrientation = isEditorial
  ? classifyCoverOrientation(data.cover)
  : "unknown";

const editorialCoverWidth =
  coverOrientation === "portrait"
    ? 320
    : coverOrientation === "landscape"
      ? 640
      : 400;
const editorialCoverHeight =
  coverOrientation === "portrait"
    ? 450
    : coverOrientation === "landscape"
      ? 360
      : 400;
const coverWidth = isFeatured ? 720 : isStandard ? 88 : editorialCoverWidth;
const coverHeight = isFeatured ? 405 : isStandard ? 88 : editorialCoverHeight;
const editorialCoverSizes =
  coverOrientation === "portrait"
    ? "(min-width: 640px) 160px, 96px"
    : coverOrientation === "landscape"
      ? "(min-width: 1024px) 320px, (min-width: 640px) 42vw, 100vw"
      : "(min-width: 640px) 176px, 96px";
const coverSizes = isStandard
  ? "(min-width: 640px) 88px, 56px"
  : isFeatured
    ? "(min-width: 640px) 52vw, 100vw"
    : editorialCoverSizes;
const titleClass = isStandard
  ? "text-lg font-semibold leading-7"
  : isFeatured
    ? "text-2xl font-semibold leading-tight sm:text-3xl"
    : "text-lg font-semibold leading-snug sm:text-xl";
---

<li
  data-content-kind={contentKind}
  data-cover-orientation={isEditorial ? coverOrientation : undefined}
  data-transition-title={titleTransitionName}
  data-transition-cover={coverTransitionName}
  style={contentKindStyle(contentKind)}
  class:list={[isStandard ? "my-5" : "my-0", itemClass]}
  hidden={hidden}
>
  <a
    href={getPath(id, filePath)}
    data-astro-prefetch={isFeatured ? "viewport" : "tap"}
    class:list={[
      "app-card group relative isolate block overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
      isStandard
        ? "rounded-[var(--radius-card)] px-4 py-4 hover:border-accent/55"
        : isEditorial
          ? "post-card-editorial rounded-[var(--radius-card-emphasis)] px-4 py-4 sm:px-5 sm:py-5"
          : "home-lift-card rounded-[var(--radius-card-emphasis)] px-4 py-4 sm:px-5 sm:py-5",
    ]}
  >
    {
      !isStandard && (
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -top-16 -right-10 -z-10 h-48 w-48 rounded-full bg-[var(--content-accent-soft)] opacity-[var(--content-image-opacity)] blur-3xl"
        />
      )
    }

    <div
      class:list={[
        "flex min-w-0 gap-4",
        {
          "flex-col sm:flex-row sm:items-start sm:gap-4": isStandard,
          "flex-col sm:flex-row sm:items-center sm:gap-6":
            isFeatured && Boolean(cardCover) && mediaAlign === "start",
          "flex-col sm:flex-row-reverse sm:items-center sm:gap-6":
            isFeatured && Boolean(cardCover) && mediaAlign === "end",
          "flex-row items-stretch gap-4 sm:gap-6":
            isEditorial &&
            Boolean(cardCover) &&
            coverOrientation !== "landscape",
          "flex-col gap-4 sm:flex-row sm:items-stretch sm:gap-6":
            isEditorial &&
            Boolean(cardCover) &&
            coverOrientation === "landscape",
          "flex-col": isEditorial && !Boolean(cardCover),
        },
      ]}
    >
      {
        cardCover && (
          <div
            transition:name={coverTransitionName}
            class:list={[
              "relative shrink-0 overflow-hidden",
              {
                "post-card-cover-frame": isEditorial,
                "border border-border/60 bg-muted/15": isStandard,
              },
              isStandard
                ? "block h-14 w-14 rounded-lg sm:h-[88px] sm:w-[88px]"
                : isFeatured
                  ? "aspect-video w-full rounded-xl sm:w-[52%]"
                  : coverOrientation === "portrait"
                    ? "w-24 self-center rounded-xl sm:w-40"
                    : coverOrientation === "landscape"
                      ? "w-full self-center rounded-xl sm:w-[42%] sm:max-w-80"
                      : "w-24 self-center rounded-xl sm:w-44",
            ]}
          >
            {!isStandard ? (
              <>
                <CardCoverImage
                  src={cardCover}
                  alt={title}
                  width={coverWidth}
                  height={coverHeight}
                  sizes={coverSizes}
                  loading={isFeatured ? "eager" : "lazy"}
                  preserveAspect={hasAuthoredCover}
                  fit="contain"
                  style={isEditorial ? undefined : "height: 100%;"}
                  class={
                    isEditorial
                      ? "app-card-media post-card-cover-image relative z-10 block object-contain transition duration-500"
                      : "app-card-media relative z-10 block h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]"
                  }
                />
              </>
            ) : (
              <CardCoverImage
                src={cardCover}
                alt={title}
                width={coverWidth}
                height={coverHeight}
                sizes={coverSizes}
                loading={isFeatured ? "eager" : "lazy"}
                fit="cover"
                style="height: 100%;"
                class="app-card-media h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]"
              />
            )}
          </div>
        )
      }

      <div
        class:list={[
          "min-w-0 flex-1",
          {
            "flex flex-col justify-center py-1 sm:py-3": isFeatured,
            "flex flex-col justify-center py-0.5 sm:py-1": isEditorial,
          },
        ]}
      >
        {
          !isStandard && (
            <div class="mb-3 flex flex-wrap items-center gap-2 text-xs tracking-wide text-foreground/55">
              <span class="font-semibold text-accent uppercase">
                {contentKindLabel[contentKind]}
              </span>
              {data.tags.slice(0, 2).map(tag => (
                <span class="app-chip">{tag}</span>
              ))}
            </div>
          )
        }
        {
          variant === "h2" ? (
            <h2
              transition:name={titleTransitionName}
              class:list={[
                titleClass,
                isFeatured
                  ? "text-foreground"
                  : "text-foreground transition-colors group-hover:text-accent group-focus-visible:text-accent",
                { "line-clamp-2": isEditorial },
              ]}
            >
              {title}
            </h2>
          ) : (
            <h3
              transition:name={titleTransitionName}
              class:list={[
                titleClass,
                isFeatured
                  ? "text-foreground"
                  : "text-foreground transition-colors group-hover:text-accent group-focus-visible:text-accent",
                { "line-clamp-2": isEditorial },
              ]}
            >
              {title}
            </h3>
          )
        }
        <Datetime
          {published}
          {timezone}
          layout="meta"
          compact
          class="mt-1 text-xs text-foreground/65"
        />
        <p
          class:list={[
            "mt-2 text-foreground/80",
            isStandard
              ? "text-sm leading-7"
              : isFeatured
                ? "line-clamp-3 text-sm leading-7 sm:text-base"
                : "line-clamp-2 hidden text-sm leading-6 sm:block",
          ]}
        >
          {description}
        </p>
        {
          !isStandard && (
            <span
              class:list={[
                "inline-flex items-center gap-1 text-sm font-medium text-accent",
                isEditorial ? "mt-2 hidden sm:inline-flex" : "mt-4",
              ]}
            >
              阅读全文 <span aria-hidden="true">↗</span>
            </span>
          )
        }
      </div>
    </div>
  </a>
</li>

<style>
  .post-card-editorial {
    border-color: color-mix(in oklab, var(--content-accent) 24%, var(--border));
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .post-card-editorial:hover {
    border-color: color-mix(in oklab, var(--content-accent) 52%, var(--border));
    background: var(--interactive-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .post-card-editorial .app-chip {
    max-width: 8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-card-cover-frame {
    display: grid;
    place-items: center;
    transform: translateY(-2px);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.post-card-cover-image) {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
    animation: none;
    border-radius: 0.55rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card-editorial:hover .post-card-cover-frame {
      transform: translateY(-4px);
    }

    .post-card-editorial:hover :global(.post-card-cover-image) {
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card-cover-frame,
    :global(.post-card-cover-image) {
      transition: none;
    }

    .post-card-editorial:hover .post-card-cover-frame {
      transform: translateY(-2px);
    }

    .post-card-editorial:hover :global(.post-card-cover-image) {
      transform: none;
    }
  }
</style>
