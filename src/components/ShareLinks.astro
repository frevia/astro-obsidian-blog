---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { tplStr, useTranslations } from "@/i18n";

const URL = Astro.url;
const t = useTranslations(SITE.lang);
const encodedCurrentUrl = encodeURIComponent(URL.href);

const getShareLinkTitle = (social: (typeof SHARE_LINKS)[number]) => {
  if (social.linkTitle) return social.linkTitle;
  if (
    social.name.toLowerCase() === "mail" ||
    social.href.toLowerCase().startsWith("mailto:")
  ) {
    return t.post.sharePostViaEmail;
  }

  return tplStr(t.post.sharePostOn, {
    platform: social.name,
  });
};
---

{
  SHARE_LINKS.length > 0 && (
    <div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start">
      <span class="italic">{t.post.sharePostIntro}</span>
      <div class="text-center">
        {SHARE_LINKS.map(social => {
          const linkTitle = getShareLinkTitle(social);

          return (
            <LinkButton
              href={`${social.href}${encodedCurrentUrl}`}
              class="scale-90 p-2 hover:rotate-6 sm:p-1"
              title={linkTitle}
              ariaLabel={linkTitle}
            >
              <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 outline-0 group-hover:fill-transparent sm:scale-110" />
              <span class="sr-only">{linkTitle}</span>
            </LinkButton>
          );
        })}
      </div>
    </div>
  )
}
