---
import IconHash from "@/assets/icons/IconHash.svg";
import { withBase } from "@/utils/withBase";

export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  count?: number;
}

const { tag, tagName, size = "sm", count } = Astro.props;
---

<li class="group shrink-0 group-hover:cursor-pointer">
  <a
    href={withBase(`/posts/${tag}/`)}
    transition:name={tag}
    class:list={[
      "relative inline-flex items-center gap-0.5 underline decoration-dashed underline-offset-2 group-hover:-top-0.5 group-hover:text-accent focus-visible:p-1 focus-visible:no-underline",
      size === "sm" ? "text-sm" : "text-lg underline-offset-4",
    ]}
  >
    <IconHash
      class:list={[
        "inline-block shrink-0 opacity-80",
        size === "sm" ? "size-3.5" : "size-5",
      ]}
    />
    <span>{tagName}</span>
    {
      count !== undefined && (
        <span class="tag-count" aria-label={`${count} 篇文章`}>
          {count}
        </span>
      )
    }
  </a>
</li>

<style>
  .tag-count {
    display: inline-flex;
    min-width: 1.2rem;
    justify-content: center;
    border-radius: 999px;
    padding: 0 0.3rem;
    color: var(--accent);
    background: var(--accent-soft);
    font-size: 0.68em;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }
</style>
