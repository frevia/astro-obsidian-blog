---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import IconFavorite from "@/assets/icons/IconFavorite.svg";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n";
import { SITE_TIMEZONE } from "@/utils/calendarDate";
import "dayjs/locale/zh-cn";

dayjs.extend(utc);
dayjs.extend(timezone);

export interface Props {
  class?: string;
  size?: "sm" | "lg";
  /** inline：横排图标+日期；stack：纵排；meta：纯文字标签（列表底栏） */
  layout?: "inline" | "stack" | "meta";
  /** 使用 YYYY-MM-DD 短格式（列表底栏等窄空间） */
  compact?: boolean;
  timezone: string | undefined;
  published: Date;
  created?: Date;
  showCreated?: boolean;
  detailPage?: boolean;
}

const {
  published,
  created,
  size = "sm",
  layout = "inline",
  compact = false,
  class: className = "",
  timezone: postTimezone,
  showCreated = false,
  detailPage = false,
} = Astro.props;

const t = useTranslations(SITE.lang);
const dayjsLocale = SITE.lang.toLowerCase().startsWith("zh") ? "zh-cn" : "en";

const hasExplicitTime = (value: string | Date | undefined | null) => {
  if (!value) return false;
  if (typeof value === "string") {
    return /[T\s]\d{2}:\d{2}/.test(value.trim());
  }
  if (value instanceof Date) {
    return !(
      value.getUTCHours() === 0 &&
      value.getUTCMinutes() === 0 &&
      value.getUTCSeconds() === 0 &&
      value.getUTCMilliseconds() === 0
    );
  }
  return false;
};

const formatDate = (
  date: string | Date,
  timezone: string | undefined,
  compact = false
) => {
  const datetime = dayjs(date).tz(timezone || SITE_TIMEZONE);
  if (compact) {
    return datetime
      .locale(dayjsLocale)
      .format(hasExplicitTime(date) ? "YYYY-MM-DD HH:mm" : "YYYY-MM-DD");
  }
  return datetime
    .locale(dayjsLocale)
    .format(
      hasExplicitTime(date) ? "ddd / YYYY-MM-DD HH:mm" : "ddd / YYYY-MM-DD"
    );
};

const formatDateTitle = (date: string | Date, timezone: string | undefined) => {
  const datetime = dayjs(date).tz(timezone || SITE_TIMEZONE);
  return datetime
    .locale(dayjsLocale)
    .format(
      hasExplicitTime(date) ? "ddd / YYYY-MM-DD HH:mm" : "ddd / YYYY-MM-DD"
    );
};

const useCompact = compact || layout === "stack" || layout === "meta";
const publishedDate = formatDate(published, postTimezone, useCompact);
const createdDate = created
  ? formatDate(created, postTimezone, useCompact)
  : null;
const publishedTitle = formatDateTitle(published, postTimezone);
const createdTitle = created ? formatDateTitle(created, postTimezone) : null;

// 智能判断是否显示收录时间
const shouldShowCreated =
  showCreated &&
  createdDate &&
  created &&
  Math.abs(new Date(published).getTime() - new Date(created).getTime()) >
    7 * 24 * 60 * 60 * 1000;
---

{
  layout === "meta" ? (
    <div class:list={["datetime-meta", className]}>
      <span class="datetime-meta-part">
        <span class="datetime-meta-label">{t.post.publishedMeta}</span>
        <time
          class="datetime-meta-time"
          datetime={dayjs(published).toISOString()}
          title={`${t.post.originalPublishedAt}：${publishedTitle}`}
        >
          {publishedDate}
        </time>
      </span>
      {shouldShowCreated && (
        <>
          <span class="datetime-meta-sep" aria-hidden="true">
            ·
          </span>
          <span class="datetime-meta-part">
            <span class="datetime-meta-label">{t.post.collectedMeta}</span>
            <time
              class:list={[
                "datetime-meta-time",
                {
                  "datetime-meta-time--muted": !detailPage,
                },
              ]}
              datetime={dayjs(created!).toISOString()}
              title={`${t.post.collectedAt}：${createdTitle}`}
            >
              {createdDate}
            </time>
          </span>
        </>
      )}
    </div>
  ) : layout === "stack" ? (
    <div class:list={["datetime-stack", className]}>
      <div class="datetime-stack-row">
        <span class="datetime-stack-icon" aria-hidden="true">
          <IconCalendar />
        </span>
        <time
          class="datetime-stack-time"
          datetime={dayjs(published).toISOString()}
          title={`${t.post.originalPublishedAt}：${publishedTitle}`}
        >
          {publishedDate}
        </time>
      </div>
      {shouldShowCreated && (
        <div class="datetime-stack-row">
          <span class="datetime-stack-icon" aria-hidden="true">
            <IconFavorite />
          </span>
          <time
            class:list={[
              "datetime-stack-time",
              {
                "text-foreground/60": !detailPage,
                "text-foreground": detailPage,
              },
            ]}
            datetime={dayjs(created).toISOString()}
            title={`${t.post.collectedAt}：${createdTitle}`}
          >
            {createdDate}
          </time>
        </div>
      )}
    </div>
  ) : (
    <div class:list={["flex items-center gap-x-2 opacity-80", className]}>
      <IconCalendar
        class:list={[
          "inline-block size-6 min-w-[1.375rem]",
          { "scale-90": size === "sm" },
        ]}
      />
      <time
        class:list={["text-sm", { "sm:text-base": size === "lg" }]}
        datetime={dayjs(published).toISOString()}
        title={t.post.originalPublishedAt}
      >
        {publishedDate}
      </time>

      {shouldShowCreated && (
        <>
          <span class="text-foreground/40">|</span>
          <IconFavorite
            class:list={[
              "inline-block size-6 min-w-[1.375rem] text-foreground",
              { "scale-90": size === "sm" },
            ]}
          />
          <time
            class:list={[
              "text-sm",
              { "sm:text-base": size === "lg" },
              {
                "text-foreground/60": !detailPage,
                "text-foreground": detailPage,
              },
            ]}
            datetime={dayjs(created).toISOString()}
            title={t.post.collectedAt}
          >
            {createdDate}
          </time>
        </>
      )}
    </div>
  )
}

<style>
  .datetime-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    overflow: visible;
    font-size: 0.8125rem;
    line-height: 1.5;
    opacity: 0.8;
  }

  .datetime-stack-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 1.25rem;
    overflow: visible;
    white-space: nowrap;
  }

  .datetime-stack-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    overflow: visible;
  }

  .datetime-stack-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .datetime-stack-time {
    line-height: 1.5;
  }

  .datetime-meta {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .datetime-meta-part {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .datetime-meta-label {
    color: color-mix(in oklab, currentColor 72%, transparent);
  }

  .datetime-meta-time {
    font-variant-numeric: tabular-nums;
  }

  .datetime-meta-time--muted {
    opacity: 0.88;
  }

  .datetime-meta-sep {
    opacity: 0.45;
    user-select: none;
  }
</style>
