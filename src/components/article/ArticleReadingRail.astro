---
export interface ArticleHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: ArticleHeading[];
  title: string;
}

const { headings, title } = Astro.props;

type TocEntry = ArticleHeading & {
  topLevelSlug: string;
  branchSlug?: string;
};

const tocEntries = headings.reduce<TocEntry[]>((entries, heading) => {
  const previous = entries.at(-1);
  const topLevelSlug =
    heading.depth === 2 ? heading.slug : (previous?.topLevelSlug ?? "");
  const branchSlug =
    heading.depth === 3
      ? heading.slug
      : heading.depth >= 4
        ? previous?.branchSlug
        : undefined;

  entries.push({ ...heading, topLevelSlug, branchSlug });
  return entries;
}, []);
---

<div class="article-reading-rail-shell">
  <aside id="sidebar" class="sidebar article-reading-rail">
    <div class="article-reading-rail-card">
      <header class="article-reading-rail-header">
        <div class="min-w-0">
          <span class="article-reading-rail-kicker">Reading map</span>
          <h2 id="post-toc-title" class="toc-title">{title}</h2>
        </div>
        <span
          class="article-reading-rail-count"
          aria-label={`${headings.length} 个章节`}>{headings.length}</span
        >
      </header>

      <div class="article-reading-rail-progress-wrap">
        <div class="article-reading-rail-progress-label">
          <span>当前章节</span>
          <span
            class="article-reading-rail-progress"
            data-toc-progress
            aria-live="polite"
          >
            1 / {headings.length}
          </span>
        </div>
        <div class="article-reading-rail-progress-track" aria-hidden="true">
          <span data-toc-progress-bar></span>
        </div>
        <p class="article-reading-rail-current" data-toc-current>
          {headings[0]?.text ?? "开始阅读"}
        </p>
      </div>

      <nav aria-labelledby="post-toc-title" class="article-reading-rail-nav">
        <ol class="toc-list">
          {
            tocEntries.map(heading => (
              <li
                class="toc-list-item"
                data-toc-item
                data-toc-depth={heading.depth}
                data-toc-top-level={heading.topLevelSlug}
                data-toc-branch={heading.branchSlug}
              >
                <a
                  href={`#${heading.slug}`}
                  class:list={["toc-link", `node-name--H${heading.depth}`]}
                  data-toc-link
                >
                  {heading.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </aside>

  <details id="mobile-sidebar" class="article-reading-rail-mobile">
    <summary class="article-reading-rail-mobile-toggle">
      <span class="article-reading-rail-mobile-label">
        <span class="article-reading-rail-mobile-kicker">章节索引</span>
        <span class="article-reading-rail-mobile-title">{title}</span>
        <span
          class="article-reading-rail-progress"
          data-toc-progress
          aria-live="polite"
        >
          1 / {headings.length}
        </span>
      </span>
      <span class="article-reading-rail-mobile-icon" aria-hidden="true">⌄</span>
    </summary>
    <div class="article-reading-rail-mobile-panel">
      <div class="article-reading-rail-progress-label">
        <span class="article-reading-rail-mobile-current" data-toc-current>
          {headings[0]?.text ?? "开始阅读"}
        </span>
        <span
          class="article-reading-rail-progress"
          data-toc-progress
          aria-live="polite"
        >
          1 / {headings.length}
        </span>
      </div>
      <div class="article-reading-rail-progress-track" aria-hidden="true">
        <span data-toc-progress-bar></span>
      </div>
      <nav aria-label={title} class="article-reading-rail-mobile-nav">
        <ol class="toc-list">
          {
            tocEntries.map(heading => (
              <li
                class="toc-list-item"
                data-toc-item
                data-toc-depth={heading.depth}
                data-toc-top-level={heading.topLevelSlug}
                data-toc-branch={heading.branchSlug}
              >
                <a
                  href={`#${heading.slug}`}
                  class:list={["toc-link", `node-name--H${heading.depth}`]}
                  data-toc-link
                >
                  {heading.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </details>
</div>

<script>
  import { initArticleReadingRail } from "./article-reading-rail";

  declare global {
    interface Window {
      __articleReadingRailCleanup?: () => void;
      __articleReadingRailPageLoadHandler?: () => void;
      __articleReadingRailBeforeSwapHandler?: () => void;
    }
  }

  const onPageLoad = () => {
    window.__articleReadingRailCleanup?.();
    window.__articleReadingRailCleanup = initArticleReadingRail();
  };

  const onBeforeSwap = () => {
    window.__articleReadingRailCleanup?.();
    window.__articleReadingRailCleanup = undefined;
  };

  if (window.__articleReadingRailPageLoadHandler) {
    document.removeEventListener(
      "astro:page-load",
      window.__articleReadingRailPageLoadHandler
    );
  }
  if (window.__articleReadingRailBeforeSwapHandler) {
    document.removeEventListener(
      "astro:before-swap",
      window.__articleReadingRailBeforeSwapHandler
    );
  }

  window.__articleReadingRailPageLoadHandler = onPageLoad;
  window.__articleReadingRailBeforeSwapHandler = onBeforeSwap;
  document.addEventListener("astro:page-load", onPageLoad);
  document.addEventListener("astro:before-swap", onBeforeSwap);

  onPageLoad();
</script>
