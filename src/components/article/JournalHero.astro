---
import ArticleHero from "@/components/article/ArticleHero.astro";

export interface Props {
  title: string;
  description: string;
  published: Date;
  eventDate?: string;
  eventEndDate?: string;
  timezone?: string;
  titleTransitionName: string;
  category: string;
  readingMinutes: number;
}

const { titleTransitionName } = Astro.props;
---

<ArticleHero
  {...Astro.props}
  showMedia={false}
  coverTransitionName={`${titleTransitionName}-cover`}
>
  <slot name="places" slot="places" />
</ArticleHero>

<script>
  let cleanupTimeline: (() => void) | undefined;

  function initTimeline() {
    cleanupTimeline?.();
    const page = document.querySelector<HTMLElement>(".journal-page");
    const chapters = [
      ...document.querySelectorAll<HTMLElement>(".journal-timeline-chapter"),
    ];
    if (!page || !chapters.length) return;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let previousY = window.scrollY;
    let travel = 0;
    let frame = 0;
    let idle = 0;

    const update = () => {
      frame = 0;
      const distance = Math.abs(window.scrollY - previousY);
      previousY = window.scrollY;
      if (motion.matches) return;
      travel = (travel + distance * 0.4) % 14;
      for (const chapter of chapters) {
        const bounds = chapter.getBoundingClientRect();
        if (bounds.bottom < 0 || bounds.top > window.innerHeight) continue;
        const date = chapter.querySelector<HTMLElement>(
          ".journal-timeline-date"
        );
        if (!date) continue;
        const next = chapter.nextElementSibling;
        const nextDate = next?.classList.contains("journal-timeline-chapter")
          ? next.querySelector<HTMLElement>(".journal-timeline-date")
          : null;
        const start = date.getBoundingClientRect().top + 27;
        // Connect the actual moving nodes, including the next chapter's top padding.
        const end = nextDate
          ? nextDate.getBoundingClientRect().top + 14
          : bounds.bottom;
        chapter.style.setProperty(
          "--journal-thread-start",
          `${start - bounds.top}px`
        );
        chapter.style.setProperty(
          "--journal-thread-height",
          `${Math.max(0, end - start)}px`
        );
        chapter.style.setProperty("--journal-thread-offset", `${-travel}px`);
      }
      if (distance === 0) return;
      page.classList.add("journal-scrolling");
      window.clearTimeout(idle);
      idle = window.setTimeout(
        () => page.classList.remove("journal-scrolling"),
        180
      );
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const observer = new ResizeObserver(onScroll);
    chapters.forEach(chapter => observer.observe(chapter));
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    cleanupTimeline = () => {
      observer.disconnect();
      window.removeEventListener("resize", onScroll);
      window.removeEventListener("scroll", onScroll);
      cancelAnimationFrame(frame);
      window.clearTimeout(idle);
      page.classList.remove("journal-scrolling");
      for (const chapter of chapters) {
        chapter.style.removeProperty("--journal-thread-start");
        chapter.style.removeProperty("--journal-thread-offset");
        chapter.style.removeProperty("--journal-thread-height");
      }
    };
  }

  document.addEventListener("astro:page-load", initTimeline);
  document.addEventListener("astro:before-swap", () => cleanupTimeline?.());
  initTimeline();
</script>
