---
import Datetime from "@/components/Datetime.astro";
import IconCalendar from "@/assets/icons/IconCalendar.svg";

export interface Props {
  title: string;
  description: string;
  published: Date;
  timezone?: string;
  titleTransitionName: string;
}

const { title, description, published, timezone, titleTransitionName } =
  Astro.props;
---

<header class="journal-hero">
  <h1
    transition:name={titleTransitionName}
    class="journal-hero-title"
    data-pagefind-meta="title"
  >
    {title}
  </h1>
  <div class="journal-hero-intro">
    <div class="journal-hero-context">
      <div class="journal-hero-published">
        <IconCalendar aria-hidden="true" />
        <Datetime
          {published}
          {timezone}
          layout="meta"
          compact
          class="journal-hero-date"
        />
      </div>
      <div class="journal-hero-places">
        <span aria-hidden="true">·</span>
        <slot name="places" />
      </div>
    </div>
    {description && <p class="journal-hero-description">{description}</p>}
  </div>
</header>
