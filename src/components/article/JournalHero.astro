---
import Datetime from "@/components/Datetime.astro";

export interface Props {
  title: string;
  category: string;
  description: string;
  published: Date;
  timezone?: string;
  cover?: string;
  titleTransitionName: string;
  coverTransitionName: string;
}

const {
  title,
  category,
  description,
  published,
  timezone,
  cover,
  titleTransitionName,
  coverTransitionName,
} = Astro.props;
---

<header class:list={["journal-hero", { "journal-hero--text-only": !cover }]}>
  <div class="journal-hero-copy">
    <p class="journal-hero-category">{category} · 手记</p>
    <h1
      transition:name={titleTransitionName}
      class="journal-hero-title"
      data-pagefind-meta="title"
    >
      {title}
    </h1>
    <Datetime
      {published}
      {timezone}
      layout="meta"
      compact
      class="journal-hero-date"
    />
    <p class="journal-hero-description">{description}</p>
  </div>

  {
    cover && (
      <figure class="journal-hero-cover-wrap">
        <img
          transition:name={coverTransitionName}
          class="journal-hero-cover"
          src={cover}
          alt={title}
          width="1280"
          height="853"
          sizes="(min-width: 768px) 48vw, 100vw"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )
  }
</header>
