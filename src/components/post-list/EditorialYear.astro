---
import type { CollectionEntry } from "astro:content";
import Card from "@/components/Card.astro";

interface Props {
  year: string;
  posts: CollectionEntry<"blog">[];
}

const { year, posts } = Astro.props;
---

<section
  class="mx-0 mb-12 grid max-w-none gap-5 px-0 md:grid-cols-[3.25rem_minmax(0,1fr)] md:gap-3"
  aria-labelledby={`year-${year}`}
>
  <header class="relative">
    <h2
      id={`year-${year}`}
      class="text-4xl leading-none font-semibold tracking-[-0.06em] text-foreground/18 tabular-nums md:sticky md:top-[calc(var(--site-header-height,4rem)+1.25rem)] md:[writing-mode:vertical-rl]"
    >
      {year}
    </h2>
  </header>
  <ol class="flex min-w-0 flex-col gap-6" aria-label={`${year} 年文章`}>
    {
      posts.map((post, index) => (
        <Card
          {...post}
          presentation="editorial"
          variant="h3"
          mediaAlign={index % 2 === 0 ? "start" : "end"}
        />
      ))
    }
  </ol>
</section>
