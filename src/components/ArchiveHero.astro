---
import { SITE } from "@/config";
import { getBlogMetrics } from "@/utils/getBlogMetrics";

const { runningDays } = await getBlogMetrics();
---

<header class="mb-6">
  <h1 class="text-2xl font-semibold sm:text-3xl">时间档案</h1>
  <p class="mt-2 mb-3 italic text-foreground/75">{SITE.desc}</p>
  <p class="text-sm text-foreground/55">
    本站已运行
    <span class="tabular-nums font-normal text-accent">{runningDays}</span>
    天 · 记录仍在继续
  </p>
</header>
