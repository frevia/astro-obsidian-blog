---
import { SITE } from "@/config";
---

<header class="archive-hero mb-8 border-b border-border/50 pb-6">
  <p class="font-hand text-2xl text-accent sm:text-3xl">时间档案</p>
  <p class="mt-2 max-w-prose text-base leading-relaxed text-foreground/80">
    {SITE.desc}
  </p>
  <p class="mt-3 text-sm text-foreground/60">
    本站已运行
    <span id="hero-running-days" class="text-accent tabular-nums">—</span>
    天 · 记录仍在继续
  </p>
</header>

<script>
  async function fillRunningDays() {
    const el = document.getElementById("hero-running-days");
    if (!el) return;
    try {
      const res = await fetch("/about");
      const html = await res.text();
      const match = html.match(/id="running-days"[^>]*>(\d+)</);
      if (match) el.textContent = match[1];
    } catch {
      el.textContent = "…";
    }
  }
  document.addEventListener("astro:page-load", fillRunningDays);
  fillRunningDays();
</script>
