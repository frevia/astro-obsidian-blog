---
import type { FootprintRecord } from "../FootprintMap";
import { groupFootprintStories } from "@/utils/footprintStories";
import { formatEventPeriod } from "@/utils/contentDates";

interface Props {
  records: FootprintRecord[];
}
const stories = groupFootprintStories(Astro.props.records);
---

{
  stories.length > 0 && (
    <section
      class="footprint-stories"
      aria-labelledby="footprint-stories-title"
    >
      <header>
        <h2 id="footprint-stories-title">路上的记录</h2>
        <span>{stories.length} 篇</span>
      </header>
      <ul>
        {stories.map(({ post, places, period }) => (
          <li>
            <a
              class:list={[
                "footprint-story",
                { "has-thumbnail": post.thumbnail },
              ]}
              href={post.url}
              data-astro-prefetch="tap"
            >
              {post.thumbnail && (
                <img
                  src={post.thumbnail.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div>
                <p class="story-date">
                  {period
                    ? `${period.kind === "published" ? "发布于 " : ""}${formatEventPeriod(period)}`
                    : "日期未记录"}
                </p>
                <h3>{post.title}</h3>
                <p class="story-places">{places.join(" · ")}</p>
              </div>
              <span class="story-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .footprint-stories {
    margin-top: 2.5rem;
  }
  header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  h2 {
    font-size: 1.2rem;
    font-weight: 600;
  }
  header span,
  .story-date,
  .story-places {
    color: var(--foreground-muted);
    font-size: 0.8rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    border-bottom: 1px solid var(--border);
  }
  .footprint-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 0;
    color: inherit;
    text-decoration: none;
  }
  .footprint-story.has-thumbnail {
    grid-template-columns: 7rem minmax(0, 1fr) auto;
  }
  img {
    width: 7rem;
    height: 5.5rem;
    object-fit: contain;
    background: var(--surface-muted);
    border-radius: 4px;
  }
  h3 {
    margin: 0.3rem 0;
    font-size: 1.05rem;
    font-weight: 550;
    overflow-wrap: anywhere;
  }
  .story-places {
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .story-arrow {
    color: var(--foreground-muted);
  }
  .footprint-story:hover h3 {
    color: var(--accent);
  }
  .footprint-story:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  @media (max-width: 639px) {
    .footprint-story {
      gap: 0.75rem;
    }
    .footprint-story.has-thumbnail {
      grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    }
    img {
      width: 4.5rem;
      height: 4.5rem;
    }
    h3 {
      font-size: 1rem;
    }
  }
</style>
