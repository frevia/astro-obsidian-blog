---
import { groupAlbumPhotos, type AlbumPhoto } from "@/utils/album";
import { formatEventPeriod } from "@/utils/contentDates";
interface Props {
  photos: AlbumPhoto[];
}
const { photos } = Astro.props;
const groups = groupAlbumPhotos(photos);
---

<div id="article" class="album-gallery">
  {
    groups.length === 0 ? (
      <p class="album-empty">还没有收录照片。</p>
    ) : (
      groups.map(({ kind, start, end, photos }) => (
        <section
          class="album-date"
          aria-labelledby={`date-${kind}-${start}-${end ?? ""}`}
        >
          <header class="album-date-heading">
            <h2 id={`date-${kind}-${start}-${end ?? ""}`}>
              <span>
                {kind === "event"
                  ? formatEventPeriod({ start, end })
                  : `发布于 ${formatEventPeriod({ start })}`}
              </span>
            </h2>
            <span>
              {photos.length} 张 ·{" "}
              {kind === "event" ? "按事件期间" : "事件日期未记录，按发布日期"}
            </span>
          </header>
          <div class="album-grid">
            {photos.map(photo => (
              <figure class="album-photo">
                <img
                  src={photo.src}
                  width={photo.width}
                  height={photo.height}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                  data-lightbox-src={photo.original}
                  data-photo-exif={photo.exif}
                />
                <figcaption>
                  {photo.alt && <p>{photo.alt}</p>}
                  {photo.sources.map(source => (
                    <a
                      data-photo-source
                      href={source.url}
                      title={`阅读原文：${source.title}`}
                    >
                      {source.title}
                    </a>
                  ))}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    )
  }
</div>

<style>
  .album-empty {
    padding-block: 3rem;
    color: var(--foreground-muted);
  }
  .album-date {
    margin-bottom: 3rem;
  }
  .album-date-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .album-date-heading h2 {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .album-date-heading span {
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }
  .album-grid {
    columns: 3;
    column-gap: 1.25rem;
  }
  .album-photo {
    break-inside: avoid;
    margin: 0 0 1.5rem;
  }
  .album-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    background: var(--surface-muted);
  }
  .album-photo img:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  figcaption {
    padding-top: 0.6rem;
    font-size: 0.8rem;
    line-height: 1.7;
  }
  figcaption p {
    margin: 0 0 0.2rem;
  }
  figcaption a {
    display: block;
    color: var(--foreground-muted);
    text-decoration: none;
  }
  figcaption a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  @media (max-width: 639px) {
    .album-grid {
      columns: 2;
      column-gap: 0.75rem;
    }
    .album-photo {
      margin-bottom: 1.25rem;
    }
  }
  @media (max-width: 359px) {
    .album-grid {
      columns: 1;
    }
  }
</style>
