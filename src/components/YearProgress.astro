---
import { SITE } from "@/config";

const siteTimezone = SITE.timezone;
---

<!-- 年度进度条（客户端计算并自动更新）：用单层 linear-gradient 画进度，避免 PC 端双元素高度错位 -->
<div
  class="year-progress"
  data-ready="0"
  role="progressbar"
  aria-label="年度进度"
  aria-valuetext="正在计算年度进度"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  style="--year-progress: 0%"
>
  <div class="year-progress-bar" data-active="0" style="width: 0%">
    <div class="year-progress-tooltip end">0%</div>
  </div>
</div>

<script is:inline define:vars={{ siteTimezone }}>
  function getSiteDateParts(d) {
    const formatter = new Intl.DateTimeFormat("en-US", {
      timeZone: siteTimezone,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });
    const parts = formatter.formatToParts(d);
    const get = type =>
      Number(parts.find(part => part.type === type)?.value ?? 0);
    return {
      year: get("year"),
      month: get("month"),
      day: get("day"),
      hour: get("hour"),
      minute: get("minute"),
      second: get("second"),
    };
  }

  function getSiteYear(d) {
    return getSiteDateParts(d).year;
  }

  function getYearProgress() {
    const now = getSiteDateParts(new Date());
    const nowTs = Date.UTC(
      now.year,
      now.month - 1,
      now.day,
      now.hour,
      now.minute,
      now.second
    );
    const startOfYear = Date.UTC(now.year, 0, 1, 0, 0, 0);
    const endOfYear = Date.UTC(now.year, 11, 31, 23, 59, 59);

    const total = endOfYear - startOfYear;
    const elapsed = nowTs - startOfYear;
    return (elapsed / total) * 100;
  }

  function getCurrentYear() {
    return getSiteYear(new Date());
  }

  function easeOutCubic(t) {
    return 1 - Math.pow(1 - t, 3);
  }

  let animationId = null;
  let animating = false;
  let tooltipHideTimer = null;
  const GLOBAL_FLAG = "__yearProgressDidInitialAnimation";
  const PAGE_LOAD_HANDLER = "__yearProgressPageLoadHandler";
  const DOM_READY_HANDLER = "__yearProgressDomReadyHandler";
  const INTERVAL_FLAG = "__yearProgressIntervalId";

  function getElements() {
    const root = document.querySelector(".year-progress");
    if (!root) return null;
    const bar = root.querySelector(".year-progress-bar");
    const tooltip = root.querySelector(".year-progress-tooltip");
    if (!bar || !tooltip) return null;
    return { root, bar, tooltip };
  }

  function animateTo(target, duration = 900) {
    const els = getElements();
    if (!els) return;
    const { root, bar, tooltip } = els;

    const startLeft = parseFloat(bar.style.width) || 0;
    const from = Math.min(Math.max(startLeft, 0), 100);
    const to = Math.min(Math.max(target, 0), 100);
    const start = performance.now();
    animating = true;
    tooltip.classList.add("visible");
    if (tooltipHideTimer) window.clearTimeout(tooltipHideTimer);
    if (animationId) cancelAnimationFrame(animationId);

    function frame(now) {
      const t = Math.min((now - start) / duration, 1);
      const eased = easeOutCubic(t);
      const current = from + (to - from) * eased;

      bar.style.width = current + "%";
      bar.dataset.active = current > 0.05 ? "1" : "0";
      root.style.setProperty("--year-progress", current + "%");
      root.setAttribute("aria-valuenow", current.toFixed(1));
      const year = getCurrentYear();
      const label = `${year}年已走完 ${current.toFixed(1)}%`;
      root.setAttribute("aria-valuetext", label);
      tooltip.textContent = label;

      tooltip.classList.remove("end", "center");
      tooltip.classList.add(current > 90 ? "center" : "end");

      if (t < 1) {
        animationId = requestAnimationFrame(frame);
      } else {
        animating = false;
        animationId = null;
        tooltipHideTimer = window.setTimeout(() => {
          tooltip.classList.remove("visible");
          tooltipHideTimer = null;
        }, 2400);
      }
    }

    animationId = requestAnimationFrame(frame);
  }

  function updateToCurrent(animate = true) {
    const progress = getYearProgress();
    if (animate) animateTo(progress);
    else {
      const els = getElements();
      if (!els) return;
      const { root, bar, tooltip } = els;
      bar.style.width = progress + "%";
      bar.dataset.active = progress > 0.05 ? "1" : "0";
      root.style.setProperty("--year-progress", progress + "%");
      root.setAttribute("aria-valuenow", progress.toFixed(1));
      const year = getCurrentYear();
      const label = `${year}年已走完 ${progress.toFixed(1)}%`;
      root.setAttribute("aria-valuetext", label);
      tooltip.textContent = label;
      tooltip.classList.remove("end", "center");
      tooltip.classList.add(progress > 90 ? "center" : "end");
    }
  }

  function initYearProgress() {
    if (animating) return;
    const els = getElements();
    if (!els) return;
    const { root, bar, tooltip } = els;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.dataset.ready = "1";
      updateToCurrent(false);
      window[GLOBAL_FLAG] = true;
      return;
    }

    const hasAnimated = Boolean(window[GLOBAL_FLAG]);
    root.dataset.ready = "1";

    // 首次进入/刷新：从 0 动画到当前进度（但先隐藏，避免 0% 闪一下）
    if (!hasAnimated) {
      bar.style.width = "0%";
      root.style.setProperty("--year-progress", "0%");
      tooltip.textContent = "0%";
      window[GLOBAL_FLAG] = true;
      updateToCurrent(true);
      return;
    }

    // Astro 视图切换导航：不要回到 0%，直接同步到当前进度
    updateToCurrent(false);
  }

  // 初次加载 + Astro ClientRouter（视图切换）都会触发；重复执行脚本时先移除旧监听，避免累计处理器。
  const previousPageLoadHandler = window[PAGE_LOAD_HANDLER];
  if (previousPageLoadHandler) {
    document.removeEventListener("astro:page-load", previousPageLoadHandler);
  }
  window[PAGE_LOAD_HANDLER] = initYearProgress;
  document.addEventListener("astro:page-load", initYearProgress);

  // 兜底：如果未启用 ClientRouter，也能正常初始化。
  const previousDomReadyHandler = window[DOM_READY_HANDLER];
  if (previousDomReadyHandler) {
    document.removeEventListener("DOMContentLoaded", previousDomReadyHandler);
  }
  if (document.readyState === "loading") {
    window[DOM_READY_HANDLER] = initYearProgress;
    document.addEventListener("DOMContentLoaded", initYearProgress, {
      once: true,
    });
  } else {
    initYearProgress();
  }

  // 每分钟静默校准一次；年度变化幅度很小，不再重复播放提示动画。
  if (!window[INTERVAL_FLAG]) {
    window[INTERVAL_FLAG] = window.setInterval(() => {
      if (!animating) updateToCurrent(false);
    }, 60 * 1000);
  }
</script>

<style>
  .year-progress {
    position: absolute;
    left: 0;
    right: 0;
    /* 细轨道与 header 边界融为一体，避免抢过导航内容的视觉重量。 */
    bottom: -1px;
    height: 3px;
    background: color-mix(in oklab, var(--border) 62%, var(--surface));
    background-origin: border-box;
    background-clip: border-box;
    overflow: visible;
    cursor: pointer;
    opacity: 0;
    transition: opacity 180ms ease;
    box-sizing: border-box;
    /* 独立层 + 不参与 flex 拉伸，减少 PC 端渲染差异。 */
    transform: translateZ(0);
    flex-shrink: 0;
  }

  .year-progress[data-ready="1"] {
    opacity: 1;
  }

  .year-progress-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0%;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--year-progress-start) 82%, var(--accent)),
      var(--year-progress-end)
    );
    border-radius: 0 9999px 9999px 0;
    box-shadow: 0 0 0.4rem
      color-mix(in oklab, var(--year-progress-end) 36%, transparent);
    box-sizing: border-box;
    display: block;
    pointer-events: none;
  }

  .year-progress-bar::after {
    position: absolute;
    top: 50%;
    right: -0.22rem;
    width: 0.44rem;
    height: 0.44rem;
    border: 2px solid var(--surface);
    border-radius: 9999px;
    background: var(--year-progress-end);
    box-shadow: 0 0 0 1px
      color-mix(in oklab, var(--year-progress-end) 48%, transparent);
    content: "";
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 160ms ease;
  }

  .year-progress-bar[data-active="1"]::after {
    opacity: 1;
  }

  .year-progress-tooltip {
    position: absolute;
    top: calc(100% + 0.45rem);
    background: color-mix(
      in oklab,
      var(--surface) 94%,
      var(--year-progress-end) 6%
    );
    color: var(--foreground-muted);
    padding: 0.2rem 0.55rem;
    border: 1px solid
      color-mix(in oklab, var(--year-progress-end) 24%, var(--border));
    border-radius: 9999px;
    box-shadow: var(--shadow-sm);
    font-size: 0.68rem;
    line-height: 1.35;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
    pointer-events: none;
    z-index: 100;
  }

  /* 在动画或 JS 显示时使用 */
  .year-progress-tooltip.visible {
    opacity: 1;
    visibility: visible;
  }

  /* 显示在进度条末尾 */
  .year-progress-tooltip.end {
    left: 100%;
    transform: none;
  }

  /* 显示在进度条中间 */
  .year-progress-tooltip.center {
    left: 50%;
    transform: translateX(-50%);
  }

  .year-progress:hover .year-progress-tooltip {
    opacity: 1;
    visibility: visible;
  }

  @media (max-width: 639px) {
    .year-progress {
      height: 2px;
    }

    .year-progress-tooltip {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .year-progress,
    .year-progress-bar::after,
    .year-progress-tooltip {
      transition: none;
    }
  }
</style>
