---
/**
 * Twikoo 评论组件
 * 参考：https://www.iamlm.com/blog/170.Astro%20%E6%B7%BB%E5%8A%A0%20Twikoo%20%E8%AF%84%E8%AE%BA/
 * 官方 CDN：https://twikoo.js.org/frontend.html#%E9%80%9A%E8%BF%87-cdn-%E5%BC%95%E5%85%A5
 */
import {
  PUBLIC_TWIKOO_ENV_ID,
  PUBLIC_TWIKOO_REGION,
  PUBLIC_TWIKOO_LANG,
} from "astro:env/client";
---

<div id="tcomment" class="twikoo-root mt-8" aria-live="polite">
  <p class="twikoo-state twikoo-state--loading">正在加载留言…</p>
  <p class="twikoo-state twikoo-state--error" hidden>
    留言服务暂时没有响应，请稍后重试。
  </p>
</div>

<script
  is:inline
  define:vars={{
    envId: (PUBLIC_TWIKOO_ENV_ID ?? "").trim(),
    region: PUBLIC_TWIKOO_REGION ?? "",
    lang: PUBLIC_TWIKOO_LANG ?? "zh-CN",
  }}
>
  const TWIKOO_CDN =
    "https://cdn.jsdelivr.net/npm/twikoo@1.7.3/dist/twikoo.min.js";
  const TWIKOO_CSS =
    "https://cdn.jsdelivr.net/npm/twikoo@1.7.3/dist/twikoo.css";
  const HANDLER_KEY = "__twikooPageLoadHandler";
  const SCRIPT_PROMISE_KEY = "__twikooScriptPromise";

  function ensureStyle() {
    if (typeof document === "undefined") return;
    if (document.querySelector('link[data-twikoo-style="1"]')) return;
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = TWIKOO_CSS;
    link.setAttribute("data-twikoo-style", "1");
    document.head.appendChild(link);
  }

  function ensureScript() {
    if (typeof window === "undefined") return Promise.resolve();
    if (typeof twikoo !== "undefined") return Promise.resolve();
    if (window[SCRIPT_PROMISE_KEY]) return window[SCRIPT_PROMISE_KEY];

    window[SCRIPT_PROMISE_KEY] = new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = TWIKOO_CDN;
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error("Failed to load Twikoo script"));
      document.body.appendChild(script);
    });

    return window[SCRIPT_PROMISE_KEY];
  }

  async function loadTwikoo() {
    const stateLoading = document.querySelector(".twikoo-state--loading");
    const stateError = document.querySelector(".twikoo-state--error");
    const setState = state => {
      if (stateLoading) stateLoading.hidden = state !== "loading";
      if (stateError) stateError.hidden = state !== "error";
    };

    if (!envId) {
      setState("error");
      return;
    }

    const container = document.getElementById("tcomment");
    if (!container) return;

    try {
      setState("loading");
      ensureStyle();
      await ensureScript();
      if (typeof twikoo === "undefined") {
        setState("error");
        return;
      }

      // 路由切换时清理旧挂载，避免重复 init 导致评论区尺寸异常
      container
        .querySelectorAll(":scope > .twikoo-state")
        .forEach(node => node.remove());

      const options = {
        envId,
        el: "#tcomment",
        path: location.pathname,
        lang: lang || "zh-CN",
      };
      if (region && (region === "ap-shanghai" || region === "ap-guangzhou")) {
        options.region = region;
      }
      twikoo.init(options);
      window.setTimeout(() => {
        const hasRenderedComments = container.querySelector(
          ".tk-comments, .tk-comments-container, .tk-main"
        );
        if (!hasRenderedComments) setState("error");
      }, 6000);
    } catch {
      setState("error");
    }
  }

  // 避免视图切换后重复绑定事件
  if (window[HANDLER_KEY]) {
    document.removeEventListener("astro:page-load", window[HANDLER_KEY]);
  }
  window[HANDLER_KEY] = loadTwikoo;
  document.addEventListener("astro:page-load", window[HANDLER_KEY]);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadTwikoo, { once: true });
  } else {
    loadTwikoo();
  }
</script>

<style is:global>
  .twikoo-root {
    min-height: 5rem;
  }

  .twikoo-state {
    border: 1px dashed color-mix(in oklab, var(--border) 78%, transparent);
    border-radius: var(--radius-card);
    padding: 1rem;
    color: var(--foreground-muted);
    background: var(--surface-muted);
    font-size: 0.8rem;
    line-height: 1.6;
    text-align: center;
  }

  .twikoo-state--error {
    border-color: color-mix(in oklab, var(--danger) 38%, var(--border));
    color: var(--danger);
    background: color-mix(in oklab, var(--danger) 5%, var(--surface));
  }
</style>
