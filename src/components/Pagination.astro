---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="mt-auto mb-8 flex items-center justify-center gap-3" aria-label="分页导航">
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={[
          "inline-flex min-h-11 items-center gap-1 rounded-lg border border-border/70 px-3 py-2 text-sm transition-colors",
          {
            "opacity-50": !page.url.prev,
            "hover:border-accent/50 hover:text-accent": page.url.prev,
          },
        ]}
        ariaLabel="上一页"
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        上一页
      </LinkButton>
      <span class="min-w-20 text-center text-sm tabular-nums text-foreground/75">
        {page.currentPage} / {page.lastPage}
      </span>
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={[
          "inline-flex min-h-11 items-center gap-1 rounded-lg border border-border/70 px-3 py-2 text-sm transition-colors",
          {
            "opacity-50": !page.url.next,
            "hover:border-accent/50 hover:text-accent": page.url.next,
          },
        ]}
        ariaLabel="下一页"
      >
        下一页
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
