---
// import Hr from "./Hr.astro";
import YearProgress from "./YearProgress.astro";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import LinkButton from "./LinkButton.astro";
import DateDisplay from "./DateDisplay.astro";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n";
import { stripBase, withBase } from "@/utils/withBase";

const t = useTranslations(SITE.lang);

// Remove trailing slash from current pathname if exists
const pathname = stripBase(Astro.url.pathname);
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navItems = [
  { href: "/", label: t.nav.fragments },
  { href: "/posts", label: t.nav.posts },
  { href: "/favorites", label: t.nav.favorites },
  { href: "/footprint", label: t.nav.footprint },
  { href: "/feeds", label: t.nav.feeds },
  { href: "/about", label: t.nav.about },
];

const headerLabels = {
  skipToContent: t.a11y.skipToContent,
  openMenu: t.a11y.openMenu,
  closeMenu: t.a11y.closeMenu,
  toggleTheme: t.a11y.toggleTheme,
  themeLight: t.a11y.themeLight,
  themeDark: t.a11y.themeDark,
  themeAuto: t.a11y.themeAuto,
  search: t.nav.search,
  searchTooltip: t.pages.searchTooltip,
  archives: t.pages.archivesTitle,
  archivesTooltip: t.pages.archivesTooltip,
  rssFeed: t.nav.rssFeed,
  mainNav: t.nav.mainLabel,
  mobileNav: t.nav.mobileLabel,
};
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-50 w-full border-b border-border/70 bg-surface/90 shadow-sm backdrop-blur-xl"
>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-4 -top-[100vh] z-50 rounded-md border border-border/70 bg-surface px-3 py-2 text-sm font-medium text-accent shadow-sm transition-all focus:top-3"
  >
    {headerLabels.skipToContent}
  </a>
  <div
    id="nav-container"
    class="mx-auto flex w-full max-w-app flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-center justify-between bg-surface px-4 py-3 sm:h-16 sm:justify-start sm:py-0"
    >
      <!-- 左侧：网站标题 -->
      <a
        href={withBase("/")}
        data-astro-prefetch="hover"
        class="mr-8 py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:my-auto sm:flex-shrink-0 sm:leading-none"
      >
        <div class="relative -left-1.5 flex items-center">
          <img src={withBase("/favicon.png")} alt="favicon" class="h-10 w-10" />
          <span class="ml-2">{SITE.title}</span>
        </div>
      </a>

      <!-- 主导航菜单（桌面端） -->
      <nav
        id="main-nav"
        class="hidden sm:flex sm:items-center"
        aria-label={headerLabels.mainNav}
      >
        <ul class="flex items-center gap-x-2">
          {
            navItems.map(item => (
              <li>
                <a
                  href={withBase(item.href)}
                  data-astro-prefetch="hover"
                  class:list={[
                    "rounded-md px-3 py-2 text-base font-medium whitespace-nowrap text-foreground/85 transition-colors duration-200 hover:text-accent",
                    {
                      "active-nav":
                        isActive(item.href) &&
                        (item.href !== "/" || currentPath === "/"),
                    },
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- 右侧：功能按钮（桌面端） -->
      <div
        class="hidden sm:ml-auto sm:flex sm:flex-shrink-0 sm:items-center sm:gap-x-2"
      >
        {
          SITE.showArchives && (
            <LinkButton
              astroPrefetch="hover"
              href={withBase("/archives")}
              class:list={[
                "focus-outline flex min-h-11 items-center rounded-md border border-transparent p-3 hover:border-border/70",
                {
                  "active-nav [&>svg]:stroke-accent": isActive("/archives"),
                },
              ]}
              ariaLabel={headerLabels.archivesTooltip}
              title={headerLabels.archivesTooltip}
            >
              <IconCalendar class="h-4 w-4" />
            </LinkButton>
          )
        }

        {
          SITE.showArchives && (
            <div aria-hidden="true" class="h-4 w-px bg-border" />
          )
        }
        {
          SITE.search === "pagefind" && (
            <LinkButton
              id="header-search-trigger"
              astroPrefetch="hover"
              href={withBase("/search")}
              class:list={[
                "focus-outline flex min-h-11 items-center rounded-md border border-transparent p-3 hover:border-border/70",
                {
                  "active-nav [&>svg]:stroke-accent": isActive("/search"),
                },
              ]}
              ariaLabel={headerLabels.search}
              title={headerLabels.searchTooltip}
            >
              <IconSearch class="h-4 w-4" />
            </LinkButton>
          )
        }

        {
          SITE.search === "pagefind" && (
            <div aria-hidden="true" class="h-4 w-px bg-border" />
          )
        }

        <!-- RSS 链接 -->
        <a
          href={withBase("/rss.xml")}
          target="_blank"
          class="focus-outline flex min-h-11 items-center rounded-md border border-transparent p-3 hover:border-border/70 hover:text-accent"
          aria-label={headerLabels.rssFeed}
          title={headerLabels.rssFeed}
        >
          <IconRss class="h-4 w-4" />
        </a>

        {
          SITE.lightAndDarkMode && (
            <div aria-hidden="true" class="h-4 w-px bg-border" />
          )
        }

        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="focus-outline relative flex min-h-11 items-center rounded-md p-3"
              title={headerLabels.toggleTheme}
              aria-label={headerLabels.themeAuto}
              aria-pressed="false"
              aria-live="polite"
              data-theme-light-label={headerLabels.themeLight}
              data-theme-dark-label={headerLabels.themeDark}
              data-theme-auto-label={headerLabels.themeAuto}
            >
              <IconMoon class="absolute top-[50%] left-[50%] w-4 -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute top-[50%] left-[50%] w-4 -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }
      </div>

      <!-- 移动端菜单按钮 -->
      <button
        id="menu-btn"
        class="focus-outline min-h-11 rounded-md border border-transparent p-2 hover:border-border/70 sm:hidden"
        aria-label={headerLabels.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-open-label={headerLabels.openMenu}
        data-close-label={headerLabels.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
    </div>

    <!-- 移动端导航菜单 -->
    <nav
      id="nav-menu"
      class="w-full sm:hidden"
      aria-label={headerLabels.mobileNav}
    >
      <ul
        id="menu-items"
        class:list={[
          "mx-auto mt-4 mb-3 flex w-full max-w-xs flex-col gap-1 rounded-xl border border-border/70 bg-surface-elevated p-3 shadow-sm",
          "[&>li>a]:block [&>li>a]:min-h-11 [&>li>a]:rounded-md [&>li>a]:border [&>li>a]:border-transparent [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:text-base [&>li>a]:font-medium [&>li>a]:text-foreground/85 [&>li>a]:transition-colors [&>li>a]:duration-200 [&>li>a]:hover:border-border/70 [&>li>a]:hover:text-accent [&>li>a]:focus-visible:border-border/70",
          "hidden",
        ]}
      >
        {
          navItems.map(item => (
            <li>
              <a
                href={withBase(item.href)}
                data-astro-prefetch="hover"
                class:list={{
                  "active-nav":
                    isActive(item.href) &&
                    (item.href !== "/" || currentPath === "/"),
                }}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          SITE.showArchives && (
            <li>
              <a
                href={withBase("/archives")}
                data-astro-prefetch="hover"
                class:list={{ "active-nav": isActive("/archives") }}
              >
                {headerLabels.archives}
              </a>
            </li>
          )
        }
        <li class="mt-2 border-t border-border/70 pt-2">
          <div
            class:list={[
              "grid items-center gap-2",
              SITE.search === "pagefind" ? "grid-cols-3" : "grid-cols-2",
            ]}
          >
            {
              SITE.search === "pagefind" && (
                <LinkButton
                  id="header-search-trigger-mobile"
                  astroPrefetch="hover"
                  href={withBase("/search")}
                  class:list={[
                    "focus-outline flex min-h-11 items-center justify-center rounded-md border border-transparent p-3 hover:border-border/70",
                    {
                      "active-nav [&>svg]:stroke-accent": isActive("/search"),
                    },
                  ]}
                  ariaLabel={headerLabels.search}
                  title={headerLabels.searchTooltip}
                >
                  <IconSearch class="w-6" />
                </LinkButton>
              )
            }
            <a
              href={withBase("/rss.xml")}
              target="_blank"
              class="focus-outline flex min-h-11 items-center justify-center rounded-md border border-transparent p-3 hover:border-border/70 hover:text-accent"
              aria-label={headerLabels.rssFeed}
              title={headerLabels.rssFeed}
            >
              <IconRss class="w-6" />
            </a>
            {
              SITE.lightAndDarkMode && (
                <button
                  id="theme-btn-mobile"
                  class="focus-outline relative flex min-h-11 items-center justify-center rounded-md border border-transparent p-3 hover:border-border/70"
                  title={headerLabels.toggleTheme}
                  aria-label={headerLabels.themeAuto}
                  aria-pressed="false"
                  aria-live="polite"
                  data-theme-light-label={headerLabels.themeLight}
                  data-theme-dark-label={headerLabels.themeDark}
                  data-theme-auto-label={headerLabels.themeAuto}
                >
                  <IconMoon class="w-6 scale-100 transition-all dark:scale-0" />
                  <IconSunHigh class="absolute w-6 scale-0 transition-all dark:scale-100" />
                </button>
              )
            }
          </div>
        </li>
      </ul>
    </nav>
  </div>
  <!-- <Hr classNames="sm:hidden" /> -->
  <div class="relative">
    <YearProgress />
  </div>
  {
    SITE.showCalendar && (
      <div class="calendar-chime-on-progress pointer-events-none absolute top-full right-30 z-[96] hidden -translate-y-4 sm:block [&_.date-chime-root]:pointer-events-auto">
        <DateDisplay />
      </div>
    )
  }
</header>

<script>
  let lastFocusedElement: HTMLElement | null = null;
  let previousBodyOverflow = "";
  let currentEscCloseHandler: ((event: KeyboardEvent) => void) | undefined;

  function syncHeaderOffset() {
    const header = document.querySelector("#site-header");
    if (!(header instanceof HTMLElement)) return;
    const h = header.offsetHeight || 0;
    document.documentElement.style.setProperty(
      "--site-header-height",
      `${h}px`
    );
  }

  function enforceFixedHeader() {
    const header = document.querySelector("#site-header");
    if (!(header instanceof HTMLElement)) return;
    header.style.setProperty("position", "fixed", "important");
    header.style.setProperty("top", "0", "important");
    header.style.setProperty("left", "0", "important");
    header.style.setProperty("right", "0", "important");
    header.style.setProperty("z-index", "50", "important");
    syncHeaderOffset();
  }

  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (
      !(menuBtn instanceof HTMLButtonElement) ||
      !(menuItems instanceof HTMLElement) ||
      !(menuIcon instanceof Element) ||
      !(closeIcon instanceof Element)
    ) {
      return;
    }

    const openLabel = menuBtn.dataset.openLabel ?? "";
    const closeLabel = menuBtn.dataset.closeLabel ?? "";

    const syncMenuState = (isOpen: boolean) => {
      menuBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      menuBtn.setAttribute("aria-label", isOpen ? closeLabel : openLabel);
      menuItems.classList.toggle("hidden", !isOpen);
      menuIcon.classList.toggle("hidden", isOpen);
      closeIcon.classList.toggle("hidden", !isOpen);
    };

    const openMenu = () => {
      lastFocusedElement = document.activeElement as HTMLElement | null;
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      syncMenuState(true);
    };

    const closeMenu = () => {
      syncMenuState(false);
      document.body.style.overflow = "";
      if (previousBodyOverflow) {
        document.body.style.overflow = previousBodyOverflow;
      }
      lastFocusedElement?.focus();
      lastFocusedElement = null;
    };

    const handleEscClose = (event: KeyboardEvent) => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      if (event.key === "Escape" && isOpen) {
        closeMenu();
      }
    };

    menuBtn.onclick = () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      menuBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
      menuBtn.setAttribute("aria-label", isOpen ? openLabel : closeLabel);
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    };
    if (currentEscCloseHandler) {
      document.removeEventListener("keydown", currentEscCloseHandler);
    }
    currentEscCloseHandler = handleEscClose;
    document.addEventListener("keydown", currentEscCloseHandler);
  }

  enforceFixedHeader();
  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:page-load", enforceFixedHeader);
  document.addEventListener("astro:after-swap", enforceFixedHeader);
  document.addEventListener("astro:after-swap", toggleNav);
  window.addEventListener("resize", syncHeaderOffset);
</script>
