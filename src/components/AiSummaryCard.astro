---
interface Props {
  summary: string;
  title?: string;
}
const { summary, title = "AI 总结" } = Astro.props;
---

<div class="app-panel mt-6 mb-8 border-l-4 border-l-accent/45 px-4 py-3">
  <h3 class="mb-2 text-base font-semibold text-foreground/90">{title}</h3>
  <p class="text-sm leading-relaxed text-foreground/80">{summary}</p>
</div>
