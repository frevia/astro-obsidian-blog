---
import { SITE } from "@/config";
import { useTranslations } from "@/i18n";
import { withBase } from "@/utils/withBase";

const t = useTranslations(SITE.lang);
const labels = {
  title: t.search.placeholder,
  close: t.search.close,
  hint: "⌘K / Ctrl K",
  initial: t.search.results,
  noResults: t.search.noResults,
};
---

<dialog
  id="global-search-dialog"
  class="m-auto w-[min(42rem,calc(100%-2rem))] max-w-2xl overflow-hidden rounded-2xl border border-border/80 bg-surface p-0 text-foreground shadow-2xl backdrop:bg-foreground/25 backdrop:backdrop-blur-sm"
  aria-labelledby="global-search-dialog-title"
  data-fallback-href={withBase("/search")}
  data-no-results={labels.noResults}
  data-pagefind-path={withBase("/pagefind/")}
>
  <div class="border-b border-border/70 px-4 py-3 sm:px-5">
    <div class="flex items-center justify-between gap-3">
      <h2
        id="global-search-dialog-title"
        class="text-sm font-semibold tracking-wide"
      >
        {labels.title}
      </h2>
      <button
        type="button"
        class="rounded-md border border-border/70 px-2 py-1 text-xs text-foreground/65 transition-colors hover:border-accent/60 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        data-search-dialog-close
        aria-label={labels.close}
      >
        Esc
      </button>
    </div>
    <p class="mt-1 text-xs text-foreground/55">{labels.hint}</p>
  </div>
  <div class="max-h-[min(70vh,38rem)] overflow-y-auto px-4 py-4 sm:px-5">
    <label for="global-search-input" class="sr-only">{labels.title}</label>
    <input
      id="global-search-input"
      type="search"
      autocomplete="off"
      aria-autocomplete="list"
      aria-controls="global-search-results"
      placeholder={labels.title}
      class="global-search-input w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-foreground outline-none placeholder:text-foreground/45 focus:border-accent focus:ring-1 focus:ring-accent"
    />
    <div
      id="global-search-results"
      class="mt-3 space-y-2"
      role="listbox"
      aria-label={t.search.results}
      aria-live="polite"
    >
      <p class="global-search-empty">{labels.initial}</p>
    </div>
  </div>
</dialog>

<script>
  import { setupSearchDialog } from "@/scripts/search-dialog";

  setupSearchDialog();
</script>

<style is:global>
  html.search-dialog-open {
    overflow: hidden;
  }

  #global-search-dialog::backdrop {
    background: color-mix(in srgb, var(--foreground) 25%, transparent);
  }

  .global-search-empty {
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    font-size: 0.875rem;
  }

  .global-search-result {
    display: grid;
    gap: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    border-radius: 0.625rem;
    padding: 0.75rem;
    color: var(--foreground);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .global-search-result:hover,
  .global-search-result:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    outline: none;
  }

  .global-search-excerpt {
    color: color-mix(in srgb, var(--foreground) 65%, transparent);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
</style>
